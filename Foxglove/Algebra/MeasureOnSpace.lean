section GeneratorMembership

def _root_.MeasurableSpace.supGenerator (m₁ m₂ : MeasurableSpace Ω) : Set (Set Ω) :=
  {S : Set Ω | ∃ F G, S = F ∩ G ∧ MeasurableSet[m₁] F ∧ MeasurableSet[m₂] G}

/-- Every set in the generating set `w` is of the form `u ∩ v` -/
lemma exists_inter_measurableSet_of_mem_supGenerator
  (m₁ m₂ : MeasurableSpace Ω)
  {w : Set Ω}
  (hw : w ∈ MeasurableSpace.supGenerator m₁ m₂)
  : ∃ u v, w = u ∩ v ∧ MeasurableSet[m₁] u ∧ MeasurableSet[m₂] v := by
  rcases hw with ⟨u, v, rfl, hu, hv⟩
  grind

@[aesop 50% apply]
lemma mem_supGenerator_l
  (m₁ : MeasurableSpace Ω)
  {u : Set Ω} (hu : MeasurableSet[m₁] u) :
  u ∈ MeasurableSpace.supGenerator m₁ m₂ := by
  use u, ⊤
  aesop

@[aesop 50% apply]
lemma mem_supGenerator_r
  (m₁ m₂ : MeasurableSpace Ω)
  {u : Set Ω} (hu : MeasurableSet[m₂] u) :
  u ∈ MeasurableSpace.supGenerator m₁ m₂ := by
  use ⊤, u
  aesop

lemma inter_mem_supGenerator
  (m₁ m₂ : MeasurableSpace Ω)
  {u v : Set Ω}
  (hu : MeasurableSet[m₁] u) (hv : MeasurableSet[m₂] v) :
  u ∩ v ∈ MeasurableSpace.supGenerator m₁ m₂ := by
  use u, v

theorem _root_.MeasurableSpace.generateFrom_supGenerator_eq_sup
  (m₁ m₂ : MeasurableSpace Ω)
  : MeasurableSpace.generateFrom (MeasurableSpace.supGenerator m₁ m₂)
    = m₁ ⊔ m₂ := by
  ext s
  refine ⟨?p, by
    apply MeasurableSpace.generateFrom_mono
    exact fun _ h ↦ h.elim (mem_supGenerator_l _) (mem_supGenerator_r _ _)⟩
  let sumSp := MeasurableSet[m₁ ⊔ m₂]
  apply MeasurableSpace.generateFrom_le
  rintro t ⟨u, ⟨v, _, _, _⟩⟩
  have h₂ : MeasurableSpace.supGenerator m₁ m₂ ⊆ sumSp := fun w hw ↦ by
    obtain ⟨u, v, rfl, hu, hv⟩ :=
      @exists_inter_measurableSet_of_mem_supGenerator Ω m₁ m₂ (w := w) hw
    unfold sumSp
    have h₁ : MeasurableSet[m₁ ⊔ m₂] u := by
      have : u ∈ MeasurableSpace.supGenerator m₁ m₂ := by aesop
      apply MeasurableSpace.measurableSet_generateFrom
      exact Or.inl hu
    have h₂ : MeasurableSet[m₁ ⊔ m₂] v := by
      have : v ∈ MeasurableSpace.supGenerator m₁ m₂ := by aesop
      apply MeasurableSpace.measurableSet_generateFrom
      exact Or.inr hv
    apply MeasurableSet.inter h₁ h₂
  aesop (add simp (show u ∩ v ∈ supGenerator m₁ m₂ by use u, v))

end GeneratorMembership

section Sup

variable (m m₁ m₂ : MeasurableSpace Ω)

@[aesop 50% apply]
lemma mem_sup_l {u : Set Ω} (hu : MeasurableSet[m₁] u) :
  MeasurableSet[m₁ ⊔ m₂] u := (le_sup_left : m₁ ≤ m₁ ⊔ m₂) u hu

@[aesop 50% apply]
lemma mem_sup_r {u : Set Ω} (hu : MeasurableSet[m₂] u) :
  MeasurableSet[m₁ ⊔ m₂] u := (le_sup_right : m₂ ≤ m₁ ⊔ m₂) u hu

lemma mem_sup_inter {u v : Set Ω}
  (hu : MeasurableSet[m₁] u) (hv : MeasurableSet[m₂] v)
  : MeasurableSet[m₁ ⊔ m₂] (u ∩ v) :=
  (mem_sup_l m₁ m₂ hu).inter (mem_sup_r m₁ m₂ hv)

end Sup

/- We define `(𝓕, μ) ≤ (𝓖, ν)` if `𝓕 ⊆ 𝓖` and `μ` is the restriction of `ν` to `𝓕` -/
@[ext]
structure MeasureOnSpace (Ω : Type*) where
  ms : MeasurableSpace Ω
  μ : Measure[ms] Ω

instance : Preorder (MeasureOnSpace Ω) where
  le (ps₁ ps₂) := ps₁.ms ≤ ps₂.ms ∧ ps₁.μ = ps₂.μ.cast _
  le_refl := by simp
  le_trans (h₁ h₂) := by
    aesop (add safe forward le_trans) (add safe (by rw [MeasureTheory.Measure.map_map]))


def PSpace (Ω : Type*) :=
  {m : MeasureOnSpace Ω // IsProbabilityMeasure m.μ}

instance (Ω : Type*) : Preorder (PSpace Ω) where
  le (ps₁ ps₂) := (ps₁.1.ms ≤ ps₂.1.ms) ∧ ps₁.1.μ = ps₂.1.μ.cast _
  le_refl := by simp
  le_trans {a b c} (h₁ h₂) := by
    aesop (add safe forward le_trans) (add safe (by rw [MeasureTheory.Measure.map_map]))

abbrev PSp (Ω : Type*) := WithTop (PSpace Ω)

/-- Holds if `r` is the independent product of `p` and `q` -/
def PSpace.isIndependentProduct (r p q : PSpace Ω) :=
  r.1.ms = p.1.ms ⊔ q.1.ms ∧
  letI μ₁ := p.1.μ
  letI μ₂ := q.1.μ
  letI μ := r.1.μ
  ∀ E (_ : MeasurableSet[p.1.ms] E)
    F (_ : MeasurableSet[q.1.ms] F),
  μ (E ∩ F) = μ₁ E * μ₂ F

lemma PSpace.isIndependentProduct_def {r p q : PSpace Ω} :
  isIndependentProduct r p q ↔
  r.1.ms = p.1.ms ⊔ q.1.ms ∧
  ∀ E (_ : MeasurableSet[p.1.ms] E)
    F (_ : MeasurableSet[q.1.ms] F),
  r.1.μ (E ∩ F) = p.1.μ E * q.1.μ F := Iff.rfl

open PSpace

notation:60 (priority := high) r " =ᵢ " p " ⊕ᵢ " q:arg => isIndependentProduct r p q

section GeneratingPiSystem

variable {Ω : Type*} (p q : MeasureOnSpace Ω)

/--
  Given `p q : MeasureOnSpace Ω`, `generator p q` is a set of subsets of Ω that
  generates the smallest σ-algebra containing both σ-algebras
-/
def generator (p q : MeasureOnSpace Ω) : Set (Set Ω) :=
  {S : Set Ω | ∃ F G, S = F ∩ G ∧ MeasurableSet[p.ms] F ∧ MeasurableSet[q.ms] G}

section

variable {p q : MeasureOnSpace Ω}
         {u v w : Set Ω}

/-- Every set in the generating set `w` is of the form `u ∩ v` -/
lemma exists_inter_measurableSet_of_mem_generator (hw : w ∈ generator p q) :
  ∃ u v, w = u ∩ v ∧ MeasurableSet[p.ms] u ∧ MeasurableSet[q.ms] v := by
  rcases hw with ⟨u, v, rfl, hu, hv⟩
  grind

@[aesop 50% apply]
lemma mem_generator_l (hu : MeasurableSet[p.ms] u) :
  u ∈ generator p q := by
  use u, ⊤
  aesop

@[aesop 50% apply]
lemma mem_generator_r (hu : MeasurableSet[q.ms] u) :
  u ∈ generator p q := by
  use ⊤, u
  aesop

lemma inter_mem_generator
  (hu : MeasurableSet[p.ms] u) (hv : MeasurableSet[q.ms] v) :
  u ∩ v ∈ generator p q := by
  use u, v

attribute [local aesop safe apply] MeasurableSpace.measurableSet_generateFrom

theorem MeasureOnSpace.generateFrom_generator_eq_sum :
  MeasurableSpace.generateFrom (generator p q) = p.ms ⊔ q.ms := by
  ext s
  refine ⟨?p, by
    apply MeasurableSpace.generateFrom_mono
    exact fun _ h ↦ h.elim mem_generator_l mem_generator_r⟩
  let sumSp := MeasurableSet[p.ms ⊔ q.ms]
  apply MeasurableSpace.generateFrom_le
  rintro t ⟨u, ⟨v, _, _, _⟩⟩
  have h₂ : generator p q ⊆ sumSp := fun u hu ↦ by
    obtain ⟨u₁, v₁, rfl, hu₁, hv₁⟩ := exists_inter_measurableSet_of_mem_generator hu
    exact (mem_sup_l p.ms q.ms hu₁).inter (mem_sup_r p.ms q.ms hv₁)
  apply MeasurableSpace.generateFrom_le
  · dsimp [sumSp] at h₂
    exact h₂
  · aesop (add simp (show u ∩ v ∈ generator p q by use u, v))

lemma MeasureOnSpace.isPiSystem_generator : IsPiSystem (generator p q) := fun _ hu _ hv _ ↦ by
  obtain ⟨_, _, rfl, _, _⟩ := exists_inter_measurableSet_of_mem_generator hu
  obtain ⟨_, _, rfl, _, _⟩ := exists_inter_measurableSet_of_mem_generator hv
  rw [Set.inter_inter_inter_comm]
  aesop (add safe apply inter_mem_generator)

lemma mem_generator_imp_mem_sum (h : u ∈ generator p q)
  : MeasurableSet[p.ms ⊔ q.ms] u := by
  have h₁ := @MeasureOnSpace.generateFrom_generator_eq_sum Ω p q
  rw [← h₁]
  apply MeasurableSpace.measurableSet_generateFrom h
end

end GeneratingPiSystem

section Uniqueness

lemma _root_.MeasurableSpace.eq_cast_ext_ext
  {m₁ m₂ : MeasurableSpace Ω}
  (μ : Measure[m₁] Ω) (ν : Measure[m₂] Ω)
  (h_eq : m₁ = m₂) (h₂ : ∀ w, MeasurableSet[m₁] w → μ w = ν w) :
  μ = ν.cast _ := by aesop

@[ext]
lemma MeasureOnSpace.ext_ms {p q : MeasureOnSpace Ω}
  (h_eq_alg : p.ms = q.ms)
  (h_eq_mea : ∀ E, MeasurableSet[p.ms] E → p.μ E = q.μ E) :
  p = q := by
  aesop (add safe cases MeasureOnSpace)

lemma _root_.Measure.le_preserves_measure {p q : MeasurableSpace Ω}
  {h : p ≤ q} {μ : Measure[q] Ω}
  {u : Set Ω}
  {hu : MeasurableSet[p] u}
  : μ.cast p u = μ u := by
  have hu' : MeasurableSet[q] u := by apply h; exact hu
  unfold Measure.cast Measure.map!
  rw [Measure.map_apply] <;> aesop

lemma MeasureOnSpace.le_preserves_measure
  {p q : MeasureOnSpace Ω} (h : p ≤ q) {u : Set Ω} (hp : MeasurableSet[p.ms] u)
  : p.μ u = q.μ u := by
  rcases h with ⟨h₁, h₂⟩
  aesop (add simp Measure.le_preserves_measure)

instance [Inhabited Ω] : One (MeasureOnSpace Ω) where
  one := {ms := ⊥, μ := @Measure.dirac Ω ⊥ default}

instance [Inhabited Ω] : PartialOrder (MeasureOnSpace Ω) where
  le_antisymm m₁ m₂ h₁ h₂ := by
    have h : m₁.ms = m₂.ms := by
      ext u
      constructor
      have := h₁.1 u; aesop
      have := h₂.1 u; aesop
    ext u; rw [h]
    apply MeasureOnSpace.le_preserves_measure
    aesop; aesop

instance [Inhabited Ω] : PartialOrder (PSpace Ω) where
  le_antisymm := by
    rintro ⟨m₁, p₁⟩ ⟨m₂, p₂⟩ h₁ h₂
    have : m₁ ≤ m₂ := by aesop
    have : m₂ ≤ m₁ := by aesop
    have : m₁ = m₂ := @le_antisymm (MeasureOnSpace Ω) _ m₁ m₂ (by aesop) (by aesop)
    aesop

@[ext]
lemma PSpace.ext_ms
  {p q : PSpace Ω}
  (h_eq_alg : p.1.ms = q.1.ms)
  (h_eq_mea : ∀ E, MeasurableSet[p.1.ms] E → p.1.μ E = q.1.μ E)
  : p = q := by
  rcases p with ⟨a, _⟩
  rcases q with ⟨b, _⟩
  have : a = b := MeasureOnSpace.ext_ms h_eq_alg h_eq_mea
  aesop

open ENNReal in
@[simp, grind .]
lemma PSpace.measure_ne_top
  {m : PSpace Ω} {u : Set Ω}
  : m.1.μ u ≠ (⊤ : ℝ≥0∞) := by
  apply ne_of_lt
  have h₁ : m.1.μ Set.univ = 1 := m.2.measure_univ
  have h₂ : u ⊆ Set.univ := by aesop
  have h₃ : m.1.μ u ≤ m.1.μ Set.univ := measure_mono h₂
  exact lt_of_le_of_lt (b := 1) (by aesop) (by aesop)

set_option maxHeartbeats 10000000
theorem PSpace.uniqueness
  {r r' p q : PSpace Ω}
  (h₁ : r =ᵢ p ⊕ᵢ q) (h₂ : r' =ᵢ p ⊕ᵢ q)
  : r = r' := by
  apply PSpace.ext_ms (h₁.1 ▸ h₂.1 ▸ rfl)
  -- Applying the π-λ theorem: the σ-algebra is by definition a λ-system,
  -- so we just need to show that the measures agree on a generating π-system
  rw [PSpace.isIndependentProduct_def] at h₁ h₂
  apply MeasurableSpace.induction_on_inter
  · exact @MeasureOnSpace.isPiSystem_generator Ω p.1 q.1
  · simp
  · intro t ht
    obtain ⟨u, v, rfl, hu, hv⟩ := exists_inter_measurableSet_of_mem_generator ht
    grind
  · intros t h h_eq
    have r_r'_mes : r.1.ms = r'.1.ms := by rw [h₁.1, h₂.1]
    have : @MeasurableSet Ω r'.1.ms t := by
      rw [←r_r'_mes]; exact h
    let f (n : ℕ) : Set Ω :=
      if n = 0
      then t
      else if n = 1 then tᶜ else ∅
    have f_prop₁ : (⋃ i, f i) = Set.univ := by
        have h₁ : t ⊆ ⋃ i, f i := by
          simp [f]
          intros x h
          simp only [Set.mem_iUnion]
          use 0
          simpa using h
        have h₂ : tᶜ ⊆ ⋃ i, f i := by
          simp [f]
          intros x h
          simp only [Set.mem_iUnion]
          use 1
          simpa using h
        have : t ∪ tᶜ ⊆ ⋃ i, f i := by
          exact Set.union_subset h₁ h₂
        simpa using this
    have f_prop₂ : ∑' i, r.1.μ (f i) =  r.1.μ t +  r.1.μ tᶜ := by
      simp only [f]
      rw [tsum_eq_sum (s := ({0, 1} : Finset ℕ)) (fun b hb => by
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hb
        simp [hb.1, hb.2])]
      rw [Finset.sum_pair (by decide : (0 : ℕ) ≠ 1)]
      simp
    have f_prop₂' : ∑' i, r'.1.μ (f i) =  r'.1.μ t +  r'.1.μ tᶜ := by
      simp only [f]
      rw [tsum_eq_sum (s := ({0, 1} : Finset ℕ)) (fun b hb => by
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hb
        simp [hb.1, hb.2])]
      rw [Finset.sum_pair (by decide : (0 : ℕ) ≠ 1)]
      simp
    have h₁ : r.1.μ tᶜ = 1 - r.1.μ t := by
      have h' :=
        @r.1.2.m_iUnion f
          (by
            intros i
            by_cases h : i = 0
            · simp only [h, ↓reduceIte, f]; assumption
            · by_cases h' : i = 1
              · simp only [h', one_ne_zero, ↓reduceIte, MeasurableSet.compl_iff, f]; assumption
              · simp [f, h, h']
          )
          (by
            unfold Pairwise Disjoint Function.onFun
            intros i j h x
            simp only [Set.bot_eq_empty, Set.subset_empty_iff, f]
            split_ifs with cond cond' cond'' <;> grind
          )
      simp only [f_prop₁, f_prop₂, Measure.coe_toOuterMeasure, r.2.measure_univ] at h'
      have h' := h'.symm
      exact ENNReal.eq_sub_of_add_eq' (by simp) (by simpa [add_comm] using h')
    have h₂ : r'.1.μ tᶜ = 1 - r'.1.μ t := by
      have h' :=
        @r'.1.2.m_iUnion f
          (by
            intros i
            by_cases h : i = 0
            · simp only [h, ↓reduceIte, f]; assumption
            · by_cases h' : i = 1
              · simp only [h', one_ne_zero, ↓reduceIte, MeasurableSet.compl_iff, f]; assumption
              · simp [f, h, h']
          )
          (by
            unfold Pairwise Disjoint Function.onFun
            intros i j h x
            simp only [Set.bot_eq_empty, Set.subset_empty_iff, f]
            split_ifs with cond cond' cond'' <;> grind
          )
      simp only [f_prop₁, f_prop₂', Measure.coe_toOuterMeasure, r'.2.measure_univ] at h'
      have h' := h'.symm
      exact ENNReal.eq_sub_of_add_eq' (by simp) (by simpa [add_comm] using h')
    rw [h₁, h₂, h_eq]
  · intro us disjoint hus prf
    have h_sum1 : r.1.μ (⋃ i, us i) = ∑' i, r.1.μ (us i) :=
      @Measure.m_iUnion (α := Ω) (f := us) r.1.ms r.1.μ hus disjoint
    have : r'.1.μ (⋃ i, us i) = ∑' i, r'.1.μ (us i) :=
      @Measure.m_iUnion (α := Ω) (f := us) r'.1.ms r'.1.μ (by grind) disjoint
    aesop
  · aesop (add simp MeasureOnSpace.generateFrom_generator_eq_sum)

end Uniqueness

section Trim


/-- The `trim` operation takes a MeasureOnSpace `p` and a sub-σ-algebra
    f, and produces a MeasureOnSpace where the measure is restricted to
    f. -/
@[simp]
def MeasureOnSpace.trim
  {p : MeasureOnSpace Ω} {f : MeasurableSpace Ω} (h : f ≤ p.ms)
  : MeasureOnSpace Ω := {
  ms := f
  μ := p.μ.trim h
}

lemma MeasureOnSpace.trim_eq
  {p : MeasureOnSpace Ω} {f : MeasurableSpace Ω} (h : f ≤ p.ms)
  {u : Set Ω} (hu : MeasurableSet[f] u)
  : (p.trim h).μ u = p.μ u := by
  simp only [trim]
  unfold Measure.trim
  unfold_projs
  aesop

lemma _root_.Measure.trim_preserves_prob
  (f g : MeasurableSpace Ω)
  {μ : Measure[g] Ω}
  (hf : f ≤ g) (hp : IsProbabilityMeasure μ)
  : IsProbabilityMeasure (μ.trim hf) := by
  constructor
  unfold Measure.trim
  aesop

@[simp]
def PSpace.trim
  {p : PSpace Ω} {f : MeasurableSpace Ω} {h : f ≤ p.1.ms}
  : PSpace Ω := ⟨p.1.trim h, by
  simp only [MeasureOnSpace.trim]
  constructor
  have : (p.1.trim h).μ Set.univ = 1 := by
    have := (@Measure.trim_preserves_prob Ω f p.1.ms p.1.μ h p.2).1
    aesop
  aesop
⟩

end Trim

section PSpace.Identity

@[simp]
abbrev PSpace.ms (p : PSpace Ω) : MeasurableSpace Ω :=
  p.1.ms

@[simp]
abbrev PSpace.μ (p : PSpace Ω) : @Measure Ω (p.ms) :=
  p.1.μ

@[simp]
abbrev PSpace.isProbability (p : PSpace Ω) : IsProbabilityMeasure (p.μ) :=
  p.2

lemma dirac_is_prob [Inhabited Ω] : IsProbabilityMeasure (@Measure.dirac Ω ⊥ default) := by
  apply isProbabilityMeasure_iff.2
  simp

def PSpace.unit [Inhabited Ω] : PSpace Ω := ⟨{
  ms := ⊥
  μ := @Measure.dirac Ω ⊥ default
}, dirac_is_prob⟩

instance [Inhabited Ω] : One (PSpace Ω) where
  one := PSpace.unit

section UnitSpace

variable [Inhabited Ω]

/-! These are deliberately not `@[simp]`: making them global simp lemmas perturbs the
`PSp.one_le` proof below.  Use `attribute [local simp]` where they are wanted. -/

lemma PSpace.one_ms : (1 : PSpace Ω).ms = (⊥ : MeasurableSpace Ω) := rfl

end UnitSpace

/-- A space whose every subset is measurable carries the discrete σ-algebra. -/
lemma PSpace.ms_eq_top_of_all {p : PSpace Ω} (h : ∀ S : Set Ω, MeasurableSet[p.ms] S) :
    p.ms = (⊤ : MeasurableSpace Ω) :=
  le_antisymm le_top (fun S _ => h S)

/-- Two *discrete* spaces on a countable carrier are equal as soon as they agree on
singletons.  This is the practical way to show a construction computes a given
distribution: check the σ-algebra is discrete, then check point masses. -/
lemma PSpace.eq_of_singletons [Countable Ω] {p q : PSpace Ω}
    (hp : p.ms = (⊤ : MeasurableSpace Ω)) (hq : q.ms = (⊤ : MeasurableSpace Ω))
    (h : ∀ a, p.μ {a} = q.μ {a}) : p = q := by
  obtain ⟨⟨mp, μp⟩, hpp⟩ := p
  obtain ⟨⟨mq, μq⟩, hpq⟩ := q
  simp only [PSpace.ms] at hp hq
  subst hp; subst hq
  let _ : MeasurableSpace Ω := ⊤
  have : MeasurableSingletonClass Ω := ⟨fun _ => trivial⟩
  have hμ : μp = μq := (MeasureTheory.Measure.ext_iff_singleton ..).mpr (fun a => h a)
  refine PSpace.ext_ms rfl (fun E _ => ?_)
  show μp E = μq E
  rw [hμ]

lemma empty_sigma_algebra_is_identity [Inhabited Ω] (m : MeasureOnSpace Ω)
  : m.ms = MeasurableSpace.generateFrom (unit.1.ms.MeasurableSet' ∪ m.ms.MeasurableSet') := by
  let a : Set (Set Ω) := m.ms.MeasurableSet'
  let b : Set (Set Ω) := unit.1.ms.MeasurableSet'
  have h : a = b ∪ a := by
    ext u
    constructor
    grind
    simp only [Set.mem_union]
    intro h
    rcases h with h1 | h2
    apply MeasurableSet.measurableSet_bot_induction
    unfold a
    apply MeasurableSpace.measurableSet_empty
    have : Set.univ ∈ a := by
      unfold a
      apply MeasurableSet.univ
    assumption
    assumption
    assumption
  rw [← h]
  exact (@MeasurableSpace.generateFrom_measurableSet Ω m.ms).symm

theorem indepenendentProduct_identity [Inhabited Ω] {p : PSpace Ω}
  : p =ᵢ unit ⊕ᵢ p := by
  unfold isIndependentProduct
  constructor
  exact (empty_sigma_algebra_is_identity p.1).trans
    (MeasurableSpace.sup_eq_generateFrom _ _).symm
  let μ := p.μ
  let ν : Measure[⊥] Ω := unit.μ
  intro u h_u v h_v
  let P u := μ (u ∩ v) = unit.μ u * μ v
  apply MeasurableSet.measurableSet_bot_induction (P := P)
  unfold P
  simp
  unfold P
  simp_all
  exact h_u

end PSpace.Identity

section PSpace.Commutativity

theorem independentProduct_comm [Inhabited Ω] {r p q : PSpace Ω}
  (h : r =ᵢ p ⊕ᵢ q)
  : r =ᵢ q ⊕ᵢ p := by
  constructor
  have h₁ : p.ms ⊔ q.ms
    = q.ms ⊔ p.ms := by
    apply sup_comm
  have : r.ms = p.ms ⊔ q.ms := h.1
  grind
  intro u hu v hv
  let μ := r.1.μ
  let μ₁ := q.1.μ
  let μ₂ := p.1.μ
  have : r.μ (v ∩ u) = p.μ v * q.μ u := h.2 v hv u hu
  grind

end PSpace.Commutativity

section PSpace.Associativity

-- Recall the definiton of partial associativity (Kleene equality):
--  (a * b) * c ≃ a * (b * c) means:
-- If (a * b) and (a * b) * c are defined then
--   1. (b * c) and a * (b * c) are defined
--   2. (a * b) * c = a * (b * c)
-- The above definition suffices because we proved commutativity
theorem independentProduct_assoc [Inhabited Ω] {pq p q s r : PSpace Ω}
  (h_pq : pq =ᵢ p ⊕ᵢ q)
  (h_pq_r : s =ᵢ pq ⊕ᵢ r)
  : ∃ qr, qr =ᵢ q ⊕ᵢ r ∧ s =ᵢ p ⊕ᵢ qr
  := by
  let qr_ms : MeasurableSpace Ω := q.1.ms ⊔ r.1.ms
  have h : qr_ms <= s.1.ms := by
    unfold qr_ms
    rw [h_pq_r.1, h_pq.1]
    have : q.1.ms ⊔ r.1.ms ≤ p.1.ms ⊔ (q.1.ms ⊔ r.1.ms) := by
      apply le_sup_right
    rw [sup_assoc]
    aesop
  let qr : PSpace Ω := @s.trim Ω qr_ms h
  have h_qr : qr =ᵢ q ⊕ᵢ r := by
    constructor
    aesop
    intro u hu v hv
    have hou : MeasurableSet[pq.1.ms] (Set.univ ∩ u) := by
      simp
      have h : pq.1.ms = p.1.ms ⊔ q.1.ms := h_pq.1
      rw [h]
      have h₂ : u ∈ generator p.1 q.1 := mem_generator_r hu
      apply @mem_generator_imp_mem_sum Ω p.1 q.1 u h₂
    have h := h_pq_r.2 (Set.univ ∩ u) hou v hv
    have h₁ : pq.1.μ (Set.univ ∩ u) = q.1.μ u := by
      have := h_pq.2 Set.univ MeasurableSet.univ u hu
      have : p.1.μ Set.univ = 1 := p.2.measure_univ
      aesop
    have h₂ : s.1.μ (Set.univ ∩ u ∩ v) = qr.1.μ (u ∩ v) := by
      have := h_pq_r.2 (Set.univ ∩ u) hou v hv
      have h₃ : s.1.μ (Set.univ ∩ u ∩ v) = pq.1.μ (Set.univ ∩ u) * r.1.μ v := by
        grind
      have h₄ : pq.1.μ (Set.univ ∩ u) = p.1.μ Set.univ * q.1.μ u :=
        h_pq.2 Set.univ MeasurableSet.univ u hu
      rw [h₄] at h₃
      have h₅ : p.1.μ Set.univ = 1 := p.2.measure_univ
      rw [h₅] at h₃
      unfold qr
      apply Eq.symm
      have h₇ : MeasurableSet[q.1.ms ⊔ r.1.ms] (u ∩ v) := by
        apply mem_generator_imp_mem_sum
        apply inter_mem_generator hu hv
      have h₈ : q.1.ms ⊔ r.1.ms ≤ s.1.ms := by
        rw [h_pq_r.1, h_pq.1, sup_assoc]
        apply le_sup_right
      have := @s.1.trim_eq Ω (q.1.ms ⊔ r.1.ms) h₈ (u ∩ v) h₇
      have : s.1.μ (Set.univ ∩ u ∩ v) = s.1.μ (u ∩ v) := by
        have : Set.univ ∩ u ∩ v = u ∩ v := by grind
        aesop
      aesop
    aesop
  use qr
  constructor
  assumption
  have h_p_qr : s =ᵢ p ⊕ᵢ qr := by
    constructor
    rw [h_pq_r.1, h_pq.1, h_qr.1]
    apply sup_assoc p.1.ms q.1.ms r.1.ms
    have h :
      ∀ u (hu : MeasurableSet[p.1.ms] u)
        vw (hvw : MeasurableSet[q.1.ms ⊔ r.1.ms] vw),
      s.1.μ (u ∩ vw) = p.1.μ u * qr.1.μ vw
    := by
      intro u hu
      apply MeasurableSpace.induction_on_inter
      apply MeasureOnSpace.isPiSystem_generator (p := q.1) (q := r.1)
      simp
      intro t ht
      obtain ⟨v, w, rfl, hv, hw⟩ := exists_inter_measurableSet_of_mem_generator ht
      have h : u ∩ (v ∩ w) = (u ∩ v) ∩ w := by grind
      rw [h, h_pq_r.2, h_pq.2, h_qr.2]
      grind
      aesop
      aesop
      aesop
      aesop
      have := @mem_sup_inter Ω p.1.ms q.1.ms u v hu hv
      have : p.1.ms ⊔ q.1.ms = pq.1.ms := by rw [h_pq.1]
      rwa [← this]
      exact hw
      {
        intro t ht h
        have : u ∩ tᶜ = u \ (u ∩ t) := by aesop
        have : s.1.μ (u \ (u ∩ t)) = s.1.μ u - s.1.μ (u ∩ t) := by
          have : s.1.μ Set.univ = 1 := s.2.measure_univ
          apply @measure_sdiff Ω s.1.ms s.1.μ u (u ∩ t)
          grind
          have : MeasurableSet[s.1.ms] (u ∩ t) := by
            rw [h_pq_r.1, h_pq.1, sup_assoc]
            apply mem_sup_inter
            exact hu
            exact ht
          aesop
          apply s.measure_ne_top
        have : s.1.μ u = p.1.μ u := by
          have : u = (u ∩ Set.univ) ∩ Set.univ := by aesop
          have h₁ : s.1.μ u = s.1.μ ((u ∩ Set.univ) ∩ Set.univ) := by grind
          have h₂ : q.1.μ Set.univ = 1 := q.2.measure_univ
          have h₃ : r.1.μ Set.univ = 1 := r.2.measure_univ
          rw [h₁, h_pq_r.2, h_pq.2, h₂, h₃]
          simp
          exact hu
          apply MeasurableSet.univ
          have h₄ := @mem_sup_inter Ω p.1.ms q.1.ms u Set.univ hu MeasurableSet.univ
          rw [h_pq.1]
          exact h₄
          apply MeasurableSet.univ
        have : p.1.μ u - p.1.μ u * qr.1.μ t = p.1.μ u * (1 - qr.1.μ t) := by
          have := @ENNReal.mul_sub (p.1.μ u) 1 (qr.1.μ t)
          aesop
        have h₃ : qr.1.μ tᶜ = 1 - qr.1.μ t := by
          have h := @measure_compl Ω qr.1.ms (μ := qr.1.μ) (s := t) ht
          have : qr.1.μ t ≠ (⊤ : ENNReal) := qr.measure_ne_top
          have := qr.2.measure_univ
          aesop
        calc
              s.1.μ (u ∩ tᶜ)
          _ = s.1.μ (u \ (u ∩ t)) := by aesop
          _ = s.1.μ u - s.1.μ (u ∩ t) := by aesop
          _ = s.1.μ u - p.1.μ u * qr.1.μ t := by aesop
          _ = p.1.μ u - p.1.μ u * qr.1.μ t := by aesop
          _ = p.1.μ u * (1 - qr.1.μ t) := by aesop
          _ = p.1.μ u * qr.1.μ tᶜ := by aesop
      }
      {
        intro us hdis hus ih
        have : u ∩ ⋃ i, us i = ⋃ i, u ∩ us i := by aesop
        have : s.1.μ (⋃ i, u ∩ us i) = ∑' i, s.1.μ (u ∩ us i) := by
          have hus' : ∀ i, MeasurableSet[s.1.ms] (u ∩ us i) := by
            intro i
            have hus_i := hus i
            rw [h_pq_r.1, h_pq.1, sup_assoc]
            apply mem_sup_inter
            exact hu
            exact hus_i
          have h : Pairwise (Function.onFun Disjoint (fun k ↦ u ∩ us k)) := by
            intro k l p
            have h₁ := hdis p
            have h₂ : Disjoint (us k) (us l) := by apply h₁
            have h₃ := @Disjoint.inter_left' Ω (us k) (us l) u h₂
            have := @Disjoint.inter_right' Ω (u ∩ us k) (us l) u h₃
            aesop
          have := @s.1.μ.m_iUnion (fun i ↦ u ∩ us i) hus' h
          aesop
        have : ∑' i, s.1.μ (u ∩ us i) = ∑' i, p.1.μ u * qr.1.μ (us i) := by
          have : ∀ i, s.1.μ (u ∩ us i) = p.1.μ u * qr.1.μ (us i) := by
            intro i
            have := ih i
            aesop
          aesop
        have : ∑' i, p.1.μ u * qr.1.μ (us i) = p.1.μ u *  ∑' i, qr.1.μ (us i) := by
          apply ENNReal.tsum_mul_left
        have : p.1.μ u *  ∑' i, qr.1.μ (us i) = p.1.μ u * qr.1.μ (⋃ i, us i) := by
          congr
          have := @qr.1.μ.m_iUnion us hus hdis
          exact this.symm
        calc
              s.1.μ (u ∩ ⋃ i, us i)
          _ = s.1.μ (⋃ i, u ∩ us i) := by aesop
          _ = ∑' i, s.1.μ (u ∩ us i) := by aesop
          _ = ∑' i, p.1.μ u * qr.1.μ (us i) := by aesop
          _ = p.1.μ u *  ∑' i, qr.1.μ (us i) := by aesop
          _ = p.1.μ u * qr.1.μ (⋃ i, us i) := by aesop
      }
      exact (@MeasurableSpace.generateFrom_supGenerator_eq_sup Ω q.1.ms r.1.ms).symm
    aesop
  assumption

theorem independentProduct_assoc_right [Inhabited Ω] {p q r qr s : PSpace Ω}
  (h_qr : qr =ᵢ q ⊕ᵢ r)
  (h_p_qr : s =ᵢ p ⊕ᵢ qr)
  : ∃ pq, pq =ᵢ p ⊕ᵢ q ∧ s =ᵢ pq ⊕ᵢ r := by
  have h₁ : qr =ᵢ r ⊕ᵢ q := by
    apply @independentProduct_comm Ω _ qr q r h_qr
  have h₂ : s =ᵢ qr ⊕ᵢ p := by
    apply @independentProduct_comm Ω _ s p qr h_p_qr
  have h₃ := @independentProduct_assoc Ω _ qr r q s p h₁ h₂
  obtain ⟨qp, h₃⟩ := h₃
  have h₄ : qp =ᵢ p ⊕ᵢ q := by
    have : qp =ᵢ p ⊕ᵢ q := by
      have := @independentProduct_comm Ω _ qp q p
      aesop
    have : s =ᵢ r ⊕ᵢ qp := by
      have := h₃.2
      aesop
    aesop
  have h₅ : s =ᵢ qp ⊕ᵢ r := by
    have := @independentProduct_comm Ω _
    aesop
  aesop

end PSpace.Associativity

section PSpace.Auxiliary

/-- Two `PSpace`s are dependent if the independent combination does
    not exist -/
@[simp, grind]
def PSpace.dependent (p q : PSpace Ω) :=
  ¬∃r : PSpace Ω, r =ᵢ p ⊕ᵢ q

theorem PSpace.dependent_symm [Inhabited Ω] {p q : PSpace Ω}
  (h : p.dependent q) : q.dependent p := by
  simp_all
  intro x hx
  have : x =ᵢ p ⊕ᵢ q := by apply independentProduct_comm hx
  have := h x (by aesop)
  contradiction

theorem PSpace.dependent_mono_left {p q r qr : PSpace Ω}
  (hinc : p.dependent q) (hqr : qr =ᵢ q ⊕ᵢ r)
  : p.dependent qr := by
  simp_all
  intro x hx
  have : ∃ y : PSpace Ω, y =ᵢ p ⊕ᵢ q := by
    let pqms := p.1.ms ⊔ q.1.ms
    have hmsle : pqms ≤ x.1.ms := by
      unfold pqms
      have := @sup_comm (MeasurableSpace Ω) _
      have h₁ := @le_sup_right (MeasurableSpace Ω) _
      rw [hx.1, hqr.1]
      have h₂ : p.1.ms ⊔ (q.1.ms ⊔ r.1.ms) = (p.1.ms ⊔ q.1.ms) ⊔ (r.1.ms) := by
        have := @sup_assoc (MeasurableSpace Ω) _
        aesop
      rw [h₂]
      grind
    let x' := @x.trim Ω pqms (by aesop)
    have : x' =ᵢ p ⊕ᵢ q := by
      unfold PSpace.isIndependentProduct
      constructor
      aesop
      intro u hu v hv
      have : x'.1.μ ((u ∩ v) ∩ Set.univ) = p.1.μ u * qr.1.μ (v ∩ Set.univ) := by
        have h₁ : v ∩ Set.univ = v := by grind
        have h₂ : (u ∩ v) ∩ Set.univ = u ∩ (v ∩ Set.univ) := by grind
        rw [h₂, h₁]
        have : MeasurableSet[pqms] (u ∩ v) := by
          unfold pqms
          have : MeasurableSet[pqms] u := by apply @mem_sup_l Ω p.1.ms q.1.ms u hu
          have : MeasurableSet[pqms] v := by apply @mem_sup_r Ω p.1.ms q.1.ms v hv
          have := @MeasurableSet.inter Ω pqms u v (by aesop) (by aesop)
          assumption
        have h₃ := @x.1.trim_eq Ω pqms hmsle (u ∩ v) (by aesop)
        have : x.1.μ (u ∩ v) = p.1.μ u * qr.1.μ v := by
          have hple : p.1.ms ≤ x.1.ms := by rw [hx.1]; exact le_sup_left
          rw [hx.2]
          aesop
          have := @mem_sup_l Ω q.1.ms r.1.ms v hv
          rwa [hqr.1]
        have : x'.1.μ (u ∩ v) = x.1.μ (u ∩ v) := by aesop
        grind
      have : p.1.μ u * qr.1.μ (v ∩ Set.univ) = p.1.μ u * (q.1.μ v * r.1.μ Set.univ) := by
        rw [hqr.2]
        exact hv
        aesop
      calc
          x'.1.μ (u ∩ v)
      _ = x'.1.μ ((u ∩ v) ∩ Set.univ) := by aesop
      _ = p.1.μ u * qr.1.μ (v ∩ Set.univ) := by aesop
      _ = p.1.μ u * (q.1.μ v * r.1.μ Set.univ) := by aesop
      _ = p.1.μ u * (q.1.μ v * 1) := by have := r.2.measure_univ; aesop
      _ = p.1.μ u * q.1.μ v := by aesop
    exact ⟨x', this⟩
  aesop

lemma PSpace.measure_compl {p : PSpace Ω} {u : Set Ω}
  (h : MeasurableSet[p.1.ms] u)
  : p.1.μ uᶜ = 1 - p.1.μ u := by
  have : p.1.μ Set.univ = 1 := p.2.measure_univ
  rw [← this]
  apply MeasureTheory.measure_compl
  exact h
  aesop

theorem PSpace.functoriality [Inhabited Ω] {p q a pa qa : PSpace Ω}
  (hpa : pa =ᵢ p ⊕ᵢ a)
  (hqa : qa =ᵢ q ⊕ᵢ a)
  (hlt : p ≤ q)
  : pa ≤ qa := by
  have hms : pa.1.ms ≤ qa.1.ms := by
    have := sup_le_sup_right hlt.1 a.1.ms
    have := hpa.1
    have := hqa.1
    aesop
  constructor; aesop
  have := hlt.2
  have : ∀ {u : Set Ω}, MeasurableSet[pa.1.ms] u → pa.1.μ u = qa.1.μ u := by
    apply MeasurableSpace.induction_on_inter
    · exact @MeasureOnSpace.isPiSystem_generator Ω p.1 a.1
    · aesop
    · intro t ht
      obtain ⟨u, v, h, hu, hv⟩ :=
        @exists_inter_measurableSet_of_mem_supGenerator Ω p.1.ms a.1.ms t ht
      rw [h, hpa.2, hqa.2]
      have : p.1.μ u = q.1.μ u := by
        have : p.1.μ = q.1.μ.cast p.1.ms := hlt.2
        rw [this]
        apply Measure.le_preserves_measure
        exact hlt.1
        exact hu
      aesop
      exact hlt.1 u hu; exact hv; exact hu; exact hv
    · intro t ht h
      calc
            pa.1.μ tᶜ
        _ = 1 - pa.1.μ t := by
          have := @PSpace.measure_compl Ω pa t (by
            have := @MeasurableSet.compl Ω t pa.1.ms ht; aesop)
          aesop
        _ = 1 - qa.1.μ t := by aesop
        _ = qa.1.μ tᶜ := by
          have := @PSpace.measure_compl Ω qa t
          have := hms t ht
          aesop
    · intro us hdis hus heq
      calc
            pa.1.μ (⋃ i, us i)
        _ = ∑' i, pa.1.μ (us i) := measure_iUnion hdis hus
        _ = ∑' i, qa.1.μ (us i) := by aesop
        _ = qa.1.μ (⋃ i, us i) := Eq.symm (measure_iUnion hdis fun i => hms (us i) (hus i))
    · have := @MeasurableSpace.generateFrom_supGenerator_eq_sup Ω p.1.ms a.1.ms
      have : p.1.ms.supGenerator a.1.ms = generator p.1 a.1 := by rfl
      rw [hpa.1]
      aesop
  apply @Measure.ext Ω pa.1.ms
  intro u hu
  have := @Measure.le_preserves_measure Ω pa.1.ms qa.1.ms hms qa.1.μ u hu
  aesop

lemma PSpace.dependent_mono_right [Inhabited Ω] {p q r pq : PSpace Ω}
  (hinc : q.dependent r) (hpq : pq =ᵢ p ⊕ᵢ q)
  : pq.dependent r := by
  have : r.dependent q := by apply PSpace.dependent_symm (by aesop)
  have : pq =ᵢ q ⊕ᵢ p := by apply independentProduct_comm (by aesop)
  have := @PSpace.dependent_mono_left Ω r q (by aesop) pq (by aesop) (by aesop)
  have : pq.dependent r := by
    apply PSpace.dependent_symm (by aesop)
  assumption

lemma PSpace.le_of_isIndependentProduct_left
  [Inhabited Ω] {x y xy : PSpace Ω} (h : xy =ᵢ x ⊕ᵢ y)
  : x ≤ xy := by
  refine ⟨?_, ?_⟩
  · rw [h.1]; apply le_sup_left
  · have hms : x.1.ms ≤ xy.1.ms := by rw [h.1]; apply le_sup_left
    apply @Measure.ext Ω x.1.ms
    intro u hu
    have hcast : xy.1.μ.cast x.1.ms u = xy.1.μ u :=
      @Measure.le_preserves_measure Ω x.1.ms xy.1.ms hms xy.1.μ u hu
    rw [hcast]
    have h2 : xy.1.μ (u ∩ Set.univ) = x.1.μ u * y.1.μ Set.univ :=
      h.2 u hu Set.univ MeasurableSet.univ
    have h3 : u ∩ Set.univ = u := by simp
    have h4 : y.1.μ Set.univ = 1 := y.2.measure_univ
    rw [h3, h4, mul_one] at h2
    exact h2.symm

lemma PSpace.le_of_isIndependentProduct_right
  [Inhabited Ω] {x y xy : PSpace Ω} (h : xy =ᵢ y ⊕ᵢ x)
  : x ≤ xy := by
  refine ⟨?_, ?_⟩
  · rw [h.1]; apply le_sup_right
  · have hms : x.1.ms ≤ xy.1.ms := by rw [h.1]; apply le_sup_right
    apply @Measure.ext Ω x.1.ms
    intro u hu
    have hcast : xy.1.μ.cast x.1.ms u = xy.1.μ u :=
      @Measure.le_preserves_measure Ω x.1.ms xy.1.ms hms xy.1.μ u hu
    rw [hcast]
    have h2 : xy.1.μ (Set.univ ∩ u) = y.1.μ Set.univ * x.1.μ u :=
      h.2 Set.univ MeasurableSet.univ u hu
    have h3 : Set.univ ∩ u = u := by simp
    have h4 : y.1.μ Set.univ = 1 := y.2.measure_univ
    rw [h3, h4, one_mul] at h2
    exact h2.symm

/-- A null set of a sub-space is null in the big space: cover it by a measurable null set
downstairs, which keeps its measure upstairs. -/
lemma PSpace.null_of_le {y z : PSpace Ω} (hzy : z ≤ y) {s : Set Ω} (hs : z.μ s = 0) :
    y.μ s = 0 := by
  rcases @exists_measurable_superset_of_null _ z.ms z.μ _ hs with ⟨N, hN_sub, hN_meas, hN_null⟩
  have hN_y : y.μ N = 0 := by
    rw [← hN_null]
    exact (MeasureOnSpace.le_preserves_measure hzy hN_meas).symm
  exact measure_mono_null hN_sub hN_y

/-- An a.e. equality survives going up: a version of `E` measurable on the small space is
still a version on the big one. -/
lemma PSpace.ae_eq_of_le {A : Type*} {E : Ω → A} {y z : PSpace Ω} (hzy : z ≤ y)
    {g : Ω → A} (hg : g =ᵐ[z.μ] E) : g =ᵐ[y.μ] E :=
  PSpace.null_of_le hzy hg

set_option linter.style.haveILetI false in
/-- Two sub-spaces of one space push the same a.e.-measurable `E` forward to the same
measure: each pushforward is computed by a version of `E` measurable on that sub-space, the
two versions agree a.e. on the big space, and the big space's measure restricts to both. -/
lemma PSpace.map_eq_of_le {A : Type} {E : Ω → A} {y p p' : PSpace Ω}
    (hp : p ≤ y) (hp' : p' ≤ y)
    (ham : @AEMeasurable Ω A ⊤ p.ms E p.μ) (ham' : @AEMeasurable Ω A ⊤ p'.ms E p'.μ) :
    @Measure.map Ω A p.ms ⊤ E p.μ = @Measure.map Ω A p'.ms ⊤ E p'.μ := by
  apply @Measure.ext _ ⊤
  intro u hu
  rw [Measure.map_apply_of_aemeasurable ham hu, Measure.map_apply_of_aemeasurable ham' hu]
  letI : MeasurableSpace A := ⊤
  set f := AEMeasurable.mk E ham
  set f' := AEMeasurable.mk E ham'
  have hf_meas : @Measurable _ _ p.ms ⊤ f := ham.measurable_mk
  have hf'_meas : @Measurable _ _ p'.ms ⊤ f' := ham'.measurable_mk
  have hf_ae : f =ᵐ[p.μ] E := (AEMeasurable.ae_eq_mk ham).symm
  have hf'_ae : f' =ᵐ[p'.μ] E := (AEMeasurable.ae_eq_mk ham').symm
  have h1 : p.μ (E ⁻¹' u) = p.μ (f ⁻¹' u) := measure_congr (hf_ae.symm.preimage u)
  have h3 : p'.μ (E ⁻¹' u) = p'.μ (f' ⁻¹' u) := measure_congr (hf'_ae.symm.preimage u)
  have h2 : p.μ (f ⁻¹' u) = y.μ (f ⁻¹' u) :=
    MeasureOnSpace.le_preserves_measure hp (hf_meas hu)
  have h4 : p'.μ (f' ⁻¹' u) = y.μ (f' ⁻¹' u) :=
    MeasureOnSpace.le_preserves_measure hp' (hf'_meas hu)
  have hff' : f =ᵐ[y.μ] f' :=
    (PSpace.ae_eq_of_le hp hf_ae).trans (PSpace.ae_eq_of_le hp' hf'_ae).symm
  have h5 : y.μ (f ⁻¹' u) = y.μ (f' ⁻¹' u) := measure_congr (hff'.preimage u)
  rw [h1, h2, h5, ← h4, ← h3]

/-- Integrating an `m`-measurable function over a rectangle of an independent product
factorises: the `c`-side contributes its measure, the `m`-side its integral. -/
theorem PSpace.lintegral_rect [Inhabited Ω] {c m s : PSpace Ω} (hs : s =ᵢ c ⊕ᵢ m)
    {g : Ω → ENNReal} (hg : Measurable[m.ms] g)
    {E : Set Ω} (hE : MeasurableSet[c.ms] E) {F : Set Ω} (hF : MeasurableSet[m.ms] F) :
    ∫⁻ x in E ∩ F, g x ∂s.μ = c.μ E * ∫⁻ x in F, g x ∂m.μ := by
  have hprod := hs.2
  have hmle : m.ms ≤ s.ms := (PSpace.le_of_isIndependentProduct_right hs).1
  have hcle : c.ms ≤ s.ms := (PSpace.le_of_isIndependentProduct_left hs).1
  revert hF F hE E
  refine @Measurable.ennreal_induction Ω m.ms
    (fun g ↦ ∀ E, MeasurableSet[c.ms] E → ∀ F, MeasurableSet[m.ms] F →
      ∫⁻ x in E ∩ F, g x ∂s.μ = c.μ E * ∫⁻ x in F, g x ∂m.μ) ?_ ?_ ?_ g hg
  · intro a G hG E hE F hF
    have hGs : MeasurableSet[s.ms] G := hmle _ hG
    rw [lintegral_indicator_const hGs, lintegral_indicator_const hG,
      Measure.restrict_apply hGs, Measure.restrict_apply hG,
      show G ∩ (E ∩ F) = E ∩ (F ∩ G) by ext x; simp only [Set.mem_inter_iff]; tauto,
      hprod E hE (F ∩ G) (hF.inter hG), Set.inter_comm G F]
    ring
  · intro f₁ f₂ _ hf₁ hf₂ ih₁ ih₂ E hE F hF
    have hf₁s : Measurable[s.ms] f₁ := hf₁.mono hmle le_rfl
    simp only [Pi.add_apply]
    rw [lintegral_add_left hf₁s, lintegral_add_left hf₁, ih₁ E hE F hF, ih₂ E hE F hF, mul_add]
  · intro fs hfs hmono ih E hE F hF
    have hfss : ∀ n, Measurable[s.ms] (fs n) := fun n ↦ (hfs n).mono hmle le_rfl
    rw [lintegral_iSup hfss hmono, lintegral_iSup hfs hmono]
    have hall : ∀ n, ∫⁻ x in E ∩ F, fs n x ∂s.μ = c.μ E * ∫⁻ x in F, fs n x ∂m.μ :=
      fun n ↦ ih n E hE F hF
    simp_rw [hall]
    rw [ENNReal.mul_iSup]

/-- A space on which every measurable set has measure `0` or `1` is independent of itself. -/
theorem PSpace.isIndependentProduct_self {p : PSpace Ω}
    (h01 : ∀ t, MeasurableSet[p.ms] t → p.μ t = 0 ∨ p.μ t = 1) : p =ᵢ p ⊕ᵢ p := by
  have hp := p.2
  refine ⟨(sup_idem _).symm, fun E hE F hF ↦ ?_⟩
  rcases h01 E hE with h | h
  · rw [h, zero_mul]
    exact measure_mono_null Set.inter_subset_left h
  · rw [h, one_mul]
    refine le_antisymm (measure_mono Set.inter_subset_right) ?_
    have hc : p.μ Eᶜ = 0 := by rw [PSpace.measure_compl hE, h]; simp
    calc p.μ F ≤ p.μ ((E ∩ F) ∪ Eᶜ) := by
          refine measure_mono fun x hx ↦ ?_
          by_cases hxe : x ∈ E
          · exact Or.inl ⟨hxe, hx⟩
          · exact Or.inr hxe
      _ ≤ p.μ (E ∩ F) + p.μ Eᶜ := measure_union_le _ _
      _ = p.μ (E ∩ F) := by rw [hc, add_zero]

/-- A measure that vanishes on `N` is 0-1 on the σ-algebra `N` generates. -/
theorem PSpace.zero_or_one_generateFrom {p : PSpace Ω} {N : Set Ω}
    (hle : MeasurableSpace.generateFrom {N} ≤ p.ms) (hnull : p.μ N = 0) :
    ∀ t, MeasurableSet[MeasurableSpace.generateFrom {N}] t → p.μ t = 0 ∨ p.μ t = 1 := by
  have hp := p.2
  intro t ht
  induction t, ht using MeasurableSpace.generateFrom_induction with
  | hC t htC _ =>
      rw [Set.mem_singleton_iff] at htC
      subst htC
      exact Or.inl hnull
  | empty => exact Or.inl measure_empty
  | compl t ht ih =>
      rcases ih with h | h
      · right; rw [PSpace.measure_compl (hle _ ht), h, tsub_zero]
      · left; rw [PSpace.measure_compl (hle _ ht), h, tsub_self]
  | iUnion s hs ih =>
      by_cases hone : ∃ n, p.μ (s n) = 1
      · obtain ⟨n, hn⟩ := hone
        right
        refine le_antisymm prob_le_one ?_
        rw [← hn]
        exact measure_mono (Set.subset_iUnion s n)
      · left
        refine measure_iUnion_null fun n ↦ ?_
        rcases ih n with h | h
        · exact h
        · exact absurd ⟨n, h⟩ hone

/-- Trimming lands below the space trimmed. -/
theorem PSpace.trim_le {p : PSpace Ω} {f : MeasurableSpace Ω} (h : f ≤ p.ms) :
    (@PSpace.trim Ω p f h) ≤ p := by
  refine ⟨h, ?_⟩
  apply @Measure.ext Ω f
  intro u hu
  show (p.μ.trim h) u = (p.μ.cast f) u
  have ht : (p.μ.trim h) u = p.μ u := MeasureOnSpace.trim_eq (p := p.1) h hu
  rw [ht]
  exact (Measure.le_preserves_measure (h := h) (μ := p.μ) (hu := hu)).symm

end PSpace.Auxiliary

section PSp

open Classical in
set_option maxHeartbeats 100000000 in
/--
  Note: the patterns below are deliberately *non-overlapping*. Writing the
  second case as `| _, none => none` makes Lean build a match splitter, which
  has to unify through the `WithTop`/`Option` wrapper of `PSp` and diverges, so
  equation-lemma generation (and hence `@[simp, grind]`) hits a deterministic
  timeout.
-/
@[simp, grind]
def PSp.mul [Inhabited Ω] (p q : PSp Ω) : PSp Ω :=
  match p, q with
  | none, _ => none
  | some _, none => none
  | some p, some q =>
    if h : ∃ s, s =ᵢ p ⊕ᵢ q then some h.choose else none

@[simp]
def PSp.unit [Inhabited Ω] : PSp Ω :=
  some PSpace.unit

instance [Inhabited Ω] : One (PSp Ω) where
  one := PSp.unit

instance [Inhabited Ω] : Mul (PSp Ω) where
  mul := PSp.mul

/-- an inversion lemma extracting the property of independent products in mul -/
lemma PSp.mul_inversion [Inhabited Ω] {x y xy : PSpace Ω}
  (h : PSp.mul (some x) (some y) = some xy)
  : xy =ᵢ x ⊕ᵢ y := by
  simp_all
  by_cases h₁ : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ y
  simp_all
  have : h₁.choose = xy := by grind
  grind
  simp_all

private lemma PSp.mul_of_exists [Inhabited Ω] {x y : PSpace Ω} (h : ∃ s, s =ᵢ x ⊕ᵢ y)
  : PSp.mul (some x) (some y) = some h.choose := by
  simp [h]
  rfl

/-- An idempotent space: one independent of itself multiplies to itself. -/
lemma PSp.mul_self_eq [Inhabited Ω] {p : PSpace Ω} (h : p =ᵢ p ⊕ᵢ p) :
    PSp.mul (some p) (some p) = (some p : PSp Ω) := by
  have hex : ∃ s : PSpace Ω, s =ᵢ p ⊕ᵢ p := ⟨p, h⟩
  rw [PSp.mul_of_exists hex]
  exact congrArg some (PSpace.uniqueness hex.choose_spec h)

/-- An independent product that exists makes the product defined. -/
lemma PSp.mul_ne_top_of_exists [Inhabited Ω] {x y : PSpace Ω} (h : ∃ s, s =ᵢ x ⊕ᵢ y) :
    PSp.mul (some x) (some y) ≠ (⊤ : PSp Ω) := by
  rw [PSp.mul_of_exists h]
  exact Option.some_ne_none _

private lemma PSp.mul_of_dependent [Inhabited Ω] {x y : PSpace Ω} (h : x.dependent y)
  : PSp.mul (some x) (some y) = none := by
  simp only [PSpace.dependent] at h
  simp [h]
  rfl

private lemma PSp.dependent_of_mul_eq_none [Inhabited Ω] {x y : PSpace Ω}
  (h : PSp.mul (some x) (some y) = none) : x.dependent y := by
  rintro ⟨s, hs⟩
  rw [PSp.mul_of_exists ⟨s, hs⟩] at h
  cases h

lemma mul_respect_independentProduct [Inhabited Ω] {x y xy : PSpace Ω}
  (h : xy =ᵢ x ⊕ᵢ y) : PSp.mul (some x) (some y) = some xy := by
  cases h₁ : PSp.mul (some x) (some y) with
  | none =>
    exact absurd ⟨xy, h⟩ (PSp.dependent_of_mul_eq_none h₁)
  | some xy' =>
    have : xy' =ᵢ x ⊕ᵢ y := by
      apply PSp.mul_inversion
      exact h₁
    have := @PSpace.uniqueness Ω xy xy' x y h (by aesop)
    aesop

theorem PSp.mul_idem [Inhabited Ω] {p : PSp Ω} : PSp.unit.mul p = p := by
  cases h : p with
  | none => aesop
  | some x =>
    simp_all
    by_cases h : ∃ s : PSpace Ω, s =ᵢ PSpace.unit ⊕ᵢ x
    · have := @indepenendentProduct_identity Ω _
      have h₁ : h.choose = x :=
        @PSpace.uniqueness Ω h.choose x (PSpace.unit) x h.choose_spec (by aesop)
      aesop
    · have h₃ : (∃ s : PSpace Ω, s =ᵢ PSpace.unit ⊕ᵢ x) := by
        use x
        have := @indepenendentProduct_identity Ω _
        aesop
      contradiction

theorem PSp.mul_comm [Inhabited Ω] {p q : PSp Ω} : p.mul q = q.mul p :=
  match p, q with
  | none, q => by cases q <;> rfl
  | p, none => by cases p <;> rfl
  | some x, some y => by
    simp
    by_cases h : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ y
    · have h₁ : h.choose =ᵢ y ⊕ᵢ x := by
        apply independentProduct_comm; grind
      have h₂ : ∃ s' : PSpace Ω, s' =ᵢ y ⊕ᵢ x := by use h.choose
      simp_all
      congr
      ext z
      constructor
      apply independentProduct_comm
      apply independentProduct_comm
    · have h' : ¬∃ s : PSpace Ω, s =ᵢ y ⊕ᵢ x :=
        fun ⟨s, hs⟩ ↦ h ⟨s, independentProduct_comm hs⟩
      simp [h, h']
      rfl

lemma PSp.inversion [Inhabited Ω] {p : PSp Ω}
  (h : p ≠ (⊤ : PSp Ω))
  : ∃ x, p = some x := by
  cases p with
  | none => contradiction
  | some x => use x

theorem PSp.mul_assoc [Inhabited Ω] {p q r : PSp Ω}
  : (p.mul q).mul r = p.mul (q.mul r) := by
  cases h₁ : p with
  | none => aesop | some x => cases h₂ : q with
  | none => aesop | some y => cases h₃ : r with
  | none => aesop | some z =>
  cases h₄ : mul (some x) (some y) with
  | none =>
    have h₆ : x.dependent y := PSp.dependent_of_mul_eq_none h₄
    by_cases h' : ∃ s : PSpace Ω, s =ᵢ y ⊕ᵢ z
    · have := @PSpace.dependent_mono_left Ω x y z h'.choose h₆ h'.choose_spec
      rw [PSp.mul_of_exists h', PSp.mul_of_dependent this]
      rfl
    · rw [PSp.mul_of_dependent h']
      rfl
  | some xy =>
  cases h₅ : mul (some y) (some z) with
  | none =>
    have h₇ : y.dependent z := PSp.dependent_of_mul_eq_none h₅
    have := @PSpace.dependent_mono_right Ω _ x y z xy h₇ (PSp.mul_inversion h₄)
    rw [PSp.mul_of_dependent this]
    rfl
  | some yz =>
    have h₈ : xy =ᵢ x ⊕ᵢ y := by
      apply @PSp.mul_inversion Ω _ x y xy h₄
    cases h₉ : mul (some xy) (some z) with
    | none =>
      by_contra h
      have hcon : ∃ x_yz : PSpace Ω, mul (some x) (some yz) = some x_yz := by
        have := @PSp.inversion Ω _ (mul (some x) (some yz)) (fun h' ↦ h h'.symm)
        grind
      obtain ⟨x_yz, hcon⟩ := hcon
      have : x_yz =ᵢ x ⊕ᵢ yz := by
        apply PSp.mul_inversion
        grind
      have : x_yz =ᵢ xy ⊕ᵢ z := by
        have : yz =ᵢ y ⊕ᵢ z := by
          apply PSp.mul_inversion
          assumption
        have hgoal := @independentProduct_assoc_right Ω _ x y z yz x_yz (by aesop) (by aesop)
        have : hgoal.choose = xy := by
          have hxy : xy =ᵢ x ⊕ᵢ y := by
            apply PSp.mul_inversion
            assumption
          have := @PSpace.uniqueness Ω hgoal.choose xy x y (by grind) hxy
          assumption
        grind
      have : mul (some xy) (some z) = some x_yz := by
        apply mul_respect_independentProduct
        grind
      have : some x_yz = none := by aesop
      grind
    | some xy_z =>
      have h₁₀ : xy_z =ᵢ xy ⊕ᵢ z := by
        apply PSp.mul_inversion
        assumption
      have h_goal := @independentProduct_assoc Ω _ xy x y xy_z z h₈ h₁₀
      have h' : h_goal.choose = yz := by
        have h₁ : h_goal.choose =ᵢ y ⊕ᵢ z := by grind
        have h_yz : yz =ᵢ y ⊕ᵢ z := by
          apply PSp.mul_inversion
          assumption
        have := @PSpace.uniqueness Ω h_goal.choose yz y z h₁ h_yz
        assumption
      have := mul_respect_independentProduct (x := x) (y := yz) (xy := xy_z)
      grind

theorem PSp.mul_defined_imp_defined
  [Inhabited Ω] {p q : PSp Ω} (h : p.mul q ≠ (⊤ : PSp Ω))
  : p ≠ (⊤ : PSp Ω) :=
  match p, q with
  | none, _ => by aesop
  | _, none => by intro h₁; simp_all; contradiction
  | some x, some y => by aesop

instance [Inhabited Ω] : CommMonoid (PSp Ω) := {
  mul_assoc p q r := by apply PSp.mul_assoc
  mul_comm p q := by apply PSp.mul_comm
  one_mul a := PSp.mul_idem
  mul_one a := by
    calc
      a * 1
    _ = 1 * a := by apply PSp.mul_comm
    _ = a := by apply PSp.mul_idem
}

instance [Inhabited Ω] : PartialOrder (PSp Ω) := {
  le_antisymm := by
    intro p₁ p₂ h₁ h₂
    cases p₁ with
    | none => cases p₂ with
      | none => aesop
      | some q₂ => contradiction
    | some q₁ => cases p₂ with
      | none => contradiction
      | some q₂ =>
        have : q₁ ≤ q₂ := by grind
        have : q₂ ≤ q₁ := by grind
        have : q₁ = q₂ := by
          have := @le_antisymm (PSpace Ω) _ q₁ q₂
          aesop
        aesop
}

lemma PSp.ge_top_imp_top {p : PSp Ω} (h : (⊤ : PSp Ω) ≤ p) : p = (⊤ : PSp Ω) := by
  cases p; rfl; contradiction

lemma PSp.one_le [Inhabited Ω] {a : PSp Ω} : (1 : PSp Ω)  ≤ a := by
  rw [WithTop.le_def]
  rcases a with _ | b
  · exact Or.inl rfl
  · right
    use 1
    use b
    refine ⟨?_, rfl, rfl⟩
    refine ⟨?_, ?_⟩
    · unfold_projs
      intros s h
      have : s = ∅ ∨ s = Set.univ := MeasurableSpace.measurableSet_bot_iff.mp h
      rcases this with h' | h' <;> simp [h']
    · convert MeasureTheory.Measure.ext_iff.mpr _
      intros s h
      have : s = ∅ ∨ s = Set.univ := MeasurableSpace.measurableSet_bot_iff.mp h
      rcases this with h' | h' <;> simp [h']
      · have := @MeasureTheory.Measure.map_apply Ω Ω b.1.ms (1 : PSpace Ω).1.ms
        rw [this]
        · simp
        · unfold Measurable
          simp
          intros t h
          have : t = ∅ ∨ t = Set.univ := MeasurableSpace.measurableSet_bot_iff.mp h
          rcases this with h' | h' <;> simp [h']
        · simp

/-! ## Probability spaces as a resource algebra

Independent probability spaces compose: `PSp.mul` is the independent product, `1` is the
trivial space, and `⊤` is the undefined (invalid) element. -/

instance [Inhabited Ω] : Iris.OrderedUnitalResourceAlgebra (PSp Ω) := {
  valid x := x ≠ (⊤ : PSp Ω)
  valid_one := Ne.symm WithTop.top_ne_one
  elim := by
    intro a x y hxy
    show PSp.mul x a ≤ PSp.mul y a
    cases a with
    | none => cases x <;> cases y <;> exact le_refl _
    | some a =>
    cases y with
    | none => cases x <;> exact le_top
    | some y =>
    cases x with
    | none => exact absurd (PSp.ge_top_imp_top hxy) (by simp)
    | some x =>
    have hxy' : x ≤ y := WithTop.coe_le_coe.1 hxy
    by_cases h₁ : ∃ t : PSpace Ω, t =ᵢ y ⊕ᵢ a
    · have h₂ : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ a := by
        obtain ⟨ya, h₁⟩ := h₁
        let xams := x.1.ms ⊔ a.1.ms
        have hxams : xams ≤ ya.1.ms := by
          rw [h₁.1]
          exact sup_le_sup_right hxy'.1 _
        let xa := @ya.trim Ω xams hxams
        refine ⟨xa, rfl, fun u hu v hv ↦ ?_⟩
        have hu' : MeasurableSet[y.1.ms] u := hxy'.1 u hu
        have huv : MeasurableSet[xams] (u ∩ v) :=
          (mem_sup_l _ _ hu).inter (mem_sup_r _ _ hv)
        calc
              xa.1.μ (u ∩ v)
          _ = ya.1.μ (u ∩ v) := ya.1.trim_eq hxams huv
          _ = y.1.μ u * a.1.μ v := h₁.2 u hu' v hv
          _ = x.1.μ u * a.1.μ v := by
            rw [MeasureOnSpace.le_preserves_measure (p := x.1) (q := y.1) hxy' hu]
      rw [PSp.mul_of_exists h₁, PSp.mul_of_exists h₂]
      exact WithTop.coe_le_coe.2
        (PSpace.functoriality h₂.choose_spec h₁.choose_spec hxy')
    · rw [PSp.mul_of_dependent h₁]
      exact le_top
  valid_mono := by
    intro ps₁ ps₂ h₁ h₂
    cases ps₁ with
    | none =>
      have : ps₂ = (⊤ : PSp Ω) := @PSp.ge_top_imp_top Ω ps₂ h₁
      aesop
    | some p₁ => cases ps₂ with
      | none => contradiction
      | some p₂ => intro h; contradiction
  valid_mul := by apply PSp.mul_defined_imp_defined
}

section Examples

open unitInterval
open scoped ENNReal

noncomputable def PSpace.uniform (n : ℕ) : PSpace (Fin (n + 1)) :=
  ⟨⟨⊤, uniformOn Set.univ⟩, inferInstance⟩

noncomputable def PSp.uniform (n : ℕ) : PSp (Fin (n + 1)) := .some (PSpace.uniform n)

@[simp] lemma PSpace.uniform_ms (n : ℕ) :
    (PSpace.uniform n).ms = (⊤ : MeasurableSpace (Fin (n + 1))) := rfl

/-- Every point has mass `1 / (n + 1)`. -/
lemma PSpace.uniform_apply_singleton (n : ℕ) (i : Fin (n + 1)) :
    (PSpace.uniform n).μ {i} = (n + 1 : ℝ≥0∞)⁻¹ := by
  show uniformOn Set.univ {i} = _
  simp [uniformOn_univ]

/-- More generally, an event has mass proportional to its cardinality. -/
lemma PSpace.uniform_apply (n : ℕ) (s : Set (Fin (n + 1))) [Fintype s] :
    (PSpace.uniform n).μ s = (Fintype.card s : ℝ≥0∞) / (n + 1) := by
  show uniformOn Set.univ s = _
  rw [uniformOn_univ, Measure.count_apply_finite' s.toFinite trivial, Set.Finite.card_toFinset]
  simp

/-- A discrete space on `Fin (n + 1)` giving every point mass `1 / (n + 1)` *is* the
uniform space.  This is the shape a proof that some program is uniform will take. -/
lemma PSpace.eq_uniform {n : ℕ} {p : PSpace (Fin (n + 1))}
    (hms : p.ms = (⊤ : MeasurableSpace (Fin (n + 1))))
    (h : ∀ i, p.μ {i} = (n + 1 : ℝ≥0∞)⁻¹) : p = PSpace.uniform n := by
  obtain ⟨⟨m, μ⟩, hp⟩ := p
  simp only [PSpace.ms] at hms
  subst hms
  have hμ : μ = (PSpace.uniform n).μ :=
    (MeasureTheory.Measure.ext_iff_singleton ..).mpr (fun i => by
      show μ {i} = (PSpace.uniform n).μ {i}
      rw [PSpace.uniform_apply_singleton]
      exact h i)
  refine PSpace.ext_ms rfl (fun E _ => ?_)
  show μ E = (PSpace.uniform n).μ E
  rw [hμ]
  rfl

set_option linter.style.haveILetI false in
/-- Two *discrete* spaces on a countable carrier that agree on singletons are equal.  Like
`PSpace.eq_uniform`, but with the target distribution left open: this is how a program's
output space gets identified once its σ-algebra is known to be discrete. -/
lemma PSpace.ext_of_ms_top {β : Type*} [Countable β] {p q : PSpace β}
    (hp : p.ms = (⊤ : MeasurableSpace β)) (hq : q.ms = (⊤ : MeasurableSpace β))
    (h : ∀ a, p.μ {a} = q.μ {a}) : p = q := by
  obtain ⟨⟨mp, μp⟩, hpp⟩ := p
  obtain ⟨⟨mq, μq⟩, hqq⟩ := q
  simp only [PSpace.ms] at hp hq
  subst hp
  subst hq
  letI : MeasurableSpace β := ⊤
  haveI : MeasurableSingletonClass β := ⟨fun _ ↦ trivial⟩
  have hμ : μp = μq := (MeasureTheory.Measure.ext_iff_singleton (μ := μp) (ν := μq)).mpr h
  subst hμ
  rfl

open ProbabilityTheory in
/-- The Bernoulli space on `Bool`: mass `p` on `true`, `1 - p` on `false`. -/
noncomputable def PSpace.bernoulli (p : I) : PSpace Bool :=
  ⟨⟨⊤, Ber(true, false, p)⟩, inferInstance⟩

noncomputable def PSp.bernoulli (p : I) : PSp Bool := .some (PSpace.bernoulli p)

@[simp] lemma PSpace.bernoulli_ms (p : I) :
    (PSpace.bernoulli p).ms = (⊤ : MeasurableSpace Bool) := rfl

open ProbabilityTheory in
/-- `true` has mass `p`. -/
lemma PSpace.bernoulli_μ_true {p : I} :
    (PSpace.bernoulli p).μ {true} = (unitInterval.toNNReal p : ℝ≥0∞) :=
  bernoulliMeasure_apply_of_mem_of_notMem p (by trivial) rfl (by simp)

open ProbabilityTheory in
/-- `false` has mass `1 - p`.  The subtraction is truncated on both sides, and the two
agree because `p ≤ 1`. -/
lemma PSpace.bernoulli_μ_false {p : I} :
    (PSpace.bernoulli p).μ {false} = 1 - (unitInterval.toNNReal p : ℝ≥0∞) := by
  have h : (PSpace.bernoulli p).μ {false} = (unitInterval.toNNReal (σ p) : ℝ≥0∞) :=
    bernoulliMeasure_apply_of_notMem_of_mem p (by trivial) (by simp) rfl
  have hle : unitInterval.toNNReal p ≤ 1 :=
    NNReal.coe_le_coe.mp (by simpa using (Set.mem_Icc.mp p.2).2)
  rw [h, ← ENNReal.coe_one, ← ENNReal.coe_sub]
  congr 1
  exact NNReal.coe_injective (by simpa using (NNReal.coe_sub hle).symm)

open ProbabilityTheory in
/-- More generally, an event collects `p` if it contains `true` and `1 - p` if it contains
`false`.

Unlike `PSpace.uniform_apply`, this is *not* proportional to the cardinality of the event:
the two points carry different mass unless `p = 1/2`. -/
lemma PSpace.bernoulli_apply (p : I) (s : Set Bool) [DecidablePred (· ∈ s)] :
    (PSpace.bernoulli p).μ s
      = if true ∈ s then (if false ∈ s then 1 else (unitInterval.toNNReal p : ℝ≥0∞))
        else (if false ∈ s then (unitInterval.toNNReal (σ p) : ℝ≥0∞) else 0) :=
  bernoulliMeasure_apply p (by trivial)

end Examples

/-! ## Valid probability spaces

`⊤` is the undefined element of `PSp Ω`; everything else is a genuine `PSpace Ω`. -/

/-- The defined elements of `PSp Ω`. -/
abbrev ValidPSp (Ω : Type*) [Inhabited Ω] : Type _ := {psp : PSp Ω // ✓psp}

@[grind =]
lemma PSp.valid_def [Inhabited Ω] {psp : PSp Ω} : ✓psp ↔ psp ≠ (⊤ : PSp Ω) := by rfl

@[grind norm]
lemma PSp.top_def : (⊤ : PSp Ω) = .none := rfl

/-- The space underlying a valid `PSp`. -/
def ValidPSp.toPSpace [Inhabited Ω] (vpsp : ValidPSp Ω) : PSpace Ω :=
  vpsp.1.get (by
    rcases vpsp with ⟨val, h⟩
    have : val ≠ .none := by grind
    erw [Option.ne_none_iff_isSome] at this
    exact this)

lemma ValidPSp.toPSpace_eq [Inhabited Ω] {psp : PSp Ω} (h : ✓psp) {p : PSpace Ω}
    (hp : psp = .some p) : ValidPSp.toPSpace ⟨psp, h⟩ = p := by subst hp; rfl

end PSp

section WeightedSum

open scoped ENNReal

/-! ## Weighted sums of probability spaces

This is `wsum` from the Amaryllis paper (arXiv 2605.13765, §3.3).  Given a distribution
`μ : PMF A` over branches and a family `ν : A → PSpace Ω` of probability spaces, one for
each branch, the weighted sum is the space

```
  ( ⋂_{v ∈ supp μ} π_ℱ(ν v),  λE. ∑_{v ∈ supp μ} μ(v) · π_μ(ν v)(E) )
```

i.e. the events every branch in the support can measure, equipped with the mixture of the
branch measures.

The paper additionally guards the construction by `has_rv(μ, ν)` — pairwise disjointness
of the branch supports — and returns `↯` when it fails.  That side condition is what makes
the *resource* component of the model well behaved; it is not needed for the probability
space itself, which is total: the mixture is always a probability measure on the
intersected σ-algebra.  Since this development does not do resource reasoning, we implement
only the `has_rv` branch, and `PSpace.wsum` is correspondingly total. -/

variable {A : Type*}

@[instance_reducible]
def PSpace.wsumSpace (μ : PMF A) (ν : A → PSpace Ω) : MeasurableSpace Ω :=
  ⨅ v ∈ μ.support, (ν v).ms

lemma PSpace.wsumSpace_le {μ : PMF A} {ν : A → PSpace Ω} {v : A} (hv : v ∈ μ.support) :
    PSpace.wsumSpace μ ν ≤ (ν v).ms :=
  iInf₂_le v hv

/-- The mixture measure `λE. ∑ᵥ μ(v) · π_μ(ν v)(E)`, on the common σ-algebra.

Off-support branches are harmless: `μ v = 0` annihilates their contribution, so the junk
value of `Measure.cast` there is never observed. -/
noncomputable def PSpace.wsumMeasure (μ : PMF A) (ν : A → PSpace Ω) :
    Measure[PSpace.wsumSpace μ ν] Ω :=
  letI : MeasurableSpace Ω := PSpace.wsumSpace μ ν
  Measure.sum (fun v => μ v • ((ν v).μ.cast (PSpace.wsumSpace μ ν)))

/-- The defining property of the weighted sum. -/
lemma PSpace.wsumMeasure_apply (μ : PMF A) (ν : A → PSpace Ω) {E : Set Ω}
    (hE : MeasurableSet[PSpace.wsumSpace μ ν] E) :
    PSpace.wsumMeasure μ ν E = ∑' v, μ v * (ν v).μ E := by
  rw [PSpace.wsumMeasure, Measure.sum_apply _ hE]
  refine tsum_congr (fun v => ?_)
  rw [Measure.smul_apply, smul_eq_mul]
  by_cases hv : v ∈ μ.support
  · rw [@Measure.le_preserves_measure Ω (PSpace.wsumSpace μ ν) (ν v).ms
      (PSpace.wsumSpace_le hv) (ν v).μ E hE]
  · simp only [PMF.mem_support_iff, not_not] at hv
    simp [hv]

lemma PSpace.wsumMeasure_isProbabilityMeasure (μ : PMF A) (ν : A → PSpace Ω) :
    IsProbabilityMeasure (PSpace.wsumMeasure μ ν) := by
  constructor
  rw [PSpace.wsumMeasure_apply μ ν (@MeasurableSet.univ Ω (PSpace.wsumSpace μ ν))]
  have h : ∀ v, μ v * (ν v).μ Set.univ = μ v := fun v => by
    rw [@measure_univ Ω (ν v).ms (ν v).μ (ν v).isProbability, mul_one]
  simp only [h]
  exact μ.tsum_coe

noncomputable def PSpace.wsum (μ : PMF A) (κ : A → PSpace Ω) : PSpace Ω :=
  ⟨⟨PSpace.wsumSpace μ κ, PSpace.wsumMeasure μ κ⟩,
    PSpace.wsumMeasure_isProbabilityMeasure μ κ⟩

@[simp]
lemma PSpace.wsum_ms (μ : PMF A) (κ : A → PSpace Ω) :
    (PSpace.wsum μ κ).ms = PSpace.wsumSpace μ κ := rfl

@[simp]
lemma PSpace.wsum_mu (μ : PMF A) (κ : A → PSpace Ω) :
    (PSpace.wsum μ κ).μ = PSpace.wsumMeasure μ κ := rfl

/-- **Fibres glue.**  If each fibre `κ v` of a conditioning is independent of `c` inside its
own ambient `s v`, then the mixture `wsum μ κ` is independent of `c`.

This is what the fixed-σ-algebra kernel formulation cannot give: the mixture's σ-algebra is
the *intersection* `⨅ v, (κ v).ms`, so a set it measures is measured by *every* fibre, and
the per-fibre independence applies to all of them at once. -/
theorem PSpace.wsum_indep [Inhabited Ω] (μ : PMF A) (κ s : A → PSpace Ω) (c : PSpace Ω)
    (hfib : ∀ v ∈ μ.support, s v =ᵢ (κ v) ⊕ᵢ c) :
    ∃ t : PSpace Ω, t =ᵢ (PSpace.wsum μ κ) ⊕ᵢ c := by
  have hκle : ∀ v ∈ μ.support, PSpace.wsumSpace μ κ ≤ (s v).ms := fun v hv ↦
    le_trans (PSpace.wsumSpace_le hv) (PSpace.le_of_isIndependentProduct_left (hfib v hv)).1
  have hcle : ∀ v ∈ μ.support, c.ms ≤ (s v).ms := fun v hv ↦
    (PSpace.le_of_isIndependentProduct_right (hfib v hv)).1
  have hGle : PSpace.wsumSpace μ κ ⊔ c.ms ≤ PSpace.wsumSpace μ s :=
    le_iInf₂ fun v hv ↦ sup_le (hκle v hv) (hcle v hv)
  refine ⟨@PSpace.trim Ω (PSpace.wsum μ s) (PSpace.wsumSpace μ κ ⊔ c.ms) hGle, rfl, ?_⟩
  intro E hE F hF
  have hEs : MeasurableSet[PSpace.wsumSpace μ κ ⊔ c.ms] E :=
    (le_sup_left : PSpace.wsumSpace μ κ ≤ PSpace.wsumSpace μ κ ⊔ c.ms) E hE
  have hFs : MeasurableSet[PSpace.wsumSpace μ κ ⊔ c.ms] F :=
    (le_sup_right : c.ms ≤ PSpace.wsumSpace μ κ ⊔ c.ms) F hF
  have hEF : MeasurableSet[PSpace.wsumSpace μ κ ⊔ c.ms] (E ∩ F) := hEs.inter hFs
  show (MeasureOnSpace.trim hGle).μ (E ∩ F) = _
  rw [MeasureOnSpace.trim_eq hGle hEF]
  show PSpace.wsumMeasure μ s (E ∩ F) = _
  rw [PSpace.wsumMeasure_apply μ s (hGle _ hEF)]
  have hterm : ∀ v : A, μ v * (s v).μ (E ∩ F) = μ v * ((κ v).μ E * c.μ F) := by
    intro v
    by_cases hv : v ∈ μ.support
    · rw [(hfib v hv).2 E (PSpace.wsumSpace_le hv E hE) F hF]
    · simp only [PMF.mem_support_iff, not_not] at hv
      simp [hv]
  rw [tsum_congr hterm]
  simp only [← mul_assoc]
  rw [ENNReal.tsum_mul_right]
  show _ = PSpace.wsumMeasure μ κ E * _
  rw [PSpace.wsumMeasure_apply μ κ hE]

/-- The two-point weight distribution behind `wsum₂`: mass `r` on `true` and `1 - r` on
`false`.  Mathlib's `PMF.bernoulli` is deprecated in favour of the *measure*-valued
`ProbabilityTheory.bernoulliMeasure`, but `wsum` mixes over a `PMF`, so we keep a `PMF`
here. -/
noncomputable def bernoulliWeights (r : I) : PMF Bool :=
  PMF.ofFintype (fun b => cond b (toNNReal r)
                                 (toNNReal <| unitInterval.invert r)) (by
    rw [Fintype.sum_bool, Bool.cond_true, Bool.cond_false, ← ENNReal.coe_add,
      ENNReal.coe_eq_one]
    exact NNReal.coe_injective (by simp [unitInterval.invert]))

@[simp]
lemma bernoulliWeights_apply (r : I) (b : Bool) :
    bernoulliWeights r b = cond b (toNNReal r : ℝ≥0∞) (1 - (toNNReal r : ℝ≥0∞)) := by
  rw [bernoulliWeights, PMF.ofFintype_apply]
  cases b
  · have hle : toNNReal r ≤ 1 := NNReal.coe_le_coe.mp (by simpa using (Set.mem_Icc.mp r.2).2)
    rw [Bool.cond_false, Bool.cond_false, ← ENNReal.coe_one, ← ENNReal.coe_sub]
    congr 1
    exact NNReal.coe_injective (by simp [unitInterval.invert, NNReal.coe_sub hle])
  · rfl

lemma mem_support_bernoulliWeights_false {r : I} (h : r ≠ 1) :
    false ∈ (bernoulliWeights r).support := by
  rw [PMF.mem_support_iff, bernoulliWeights_apply, Bool.cond_false]
  intro hc
  rw [tsub_eq_zero_iff_le, ENNReal.one_le_coe_iff, ← NNReal.coe_le_coe, coe_toNNReal,
    NNReal.coe_one] at hc
  exact h (Subtype.ext (le_antisymm r.2.2 hc))

lemma mem_support_bernoulliWeights_true {r : I} (h : r ≠ 0) :
    true ∈ (bernoulliWeights r).support := by
  rw [PMF.mem_support_iff, bernoulliWeights_apply, Bool.cond_true, ne_eq, ENNReal.coe_eq_zero,
    ← NNReal.coe_eq_zero, coe_toNNReal]
  exact fun hc ↦ h (Subtype.ext hc)

noncomputable def PSpace.wsum₂ (r : I) (p₀ p₁ : PSpace Ω) : PSpace Ω :=
  PSpace.wsum (bernoulliWeights r) (fun b => if b then p₁ else p₀)

lemma PSpace.wsum₂_apply (r : I) (p₀ p₁ : PSpace Ω) {E : Set Ω}
    (hE : MeasurableSet[(PSpace.wsum₂ r p₀ p₁).ms] E) :
    (PSpace.wsum₂ r p₀ p₁).μ E
      = (1 - (toNNReal r : ℝ≥0∞)) * p₀.μ E + (toNNReal r : ℝ≥0∞) * p₁.μ E :=
  calc (PSpace.wsum₂ r p₀ p₁).μ E
      = ∑' b, (bernoulliWeights r) b * (if b then p₁ else p₀ : PSpace Ω).μ E :=
        PSpace.wsumMeasure_apply _ _ hE
    _ = (1 - (toNNReal r : ℝ≥0∞)) * p₀.μ E + (toNNReal r : ℝ≥0∞) * p₁.μ E := by
        rw [tsum_bool]
        simp

noncomputable def PSp.wsum₂ (r : I) : PSp Ω → PSp Ω → PSp Ω
  | .some p₀, .some p₁ => .some (PSpace.wsum₂ r p₀ p₁)
  | _, _ => ⊤

@[simp]
noncomputable def MeasureOnSpace.map (h : Ω → Ω') (ms : MeasureOnSpace Ω) :
    MeasureOnSpace Ω' :=
  letI F := ms.ms.map h
  ⟨F, @Measure.map _ _ ms.ms _ h ms.μ⟩

@[simp]
noncomputable def PSpace.map (f : Ω → Ω') (ps : PSpace Ω) : PSpace Ω' := ⟨ps.1.map f, by
  refine isProbabilityMeasure_iff.mpr ?_
  have := @Measure.map_apply Ω Ω' ps.1.ms (ps.1.ms.map f) ps.1.μ f (fun ⦃_⦄ a => a)
    Set.univ (by simp)
  have : ps.1.μ (f ⁻¹' Set.univ) = 1 := by
    have : f ⁻¹' Set.univ = Set.univ := by simp
    have := ps.2.measure_univ
    aesop
  aesop⟩

/-- The defining property of the pushforward. -/
lemma PSpace.map_apply (f : Ω → Ω') (p : PSpace Ω) {S : Set Ω'}
    (hS : MeasurableSet[(PSpace.map f p).ms] S) :
    (PSpace.map f p).μ S = p.μ (f ⁻¹' S) :=
  @Measure.map_apply Ω Ω' p.1.ms (p.1.ms.map f) p.1.μ f (fun ⦃_⦄ a => a) S hS

noncomputable def PSp.map (f : Ω → Ω') : PSp Ω → PSp Ω'
  | .some p => .some (PSpace.map f p)
  | _ => ⊤

/-- The defining property of a weighted sum of *reindexed* spaces.

This is the shape that arises when interpreting a probabilistic computation: each branch
supplies its own randomness, relocated by `f₀`/`f₁` onto the random-choice identifiers that
branch owns, and the result mixes the two with weights `1 - r` and `r`. -/
lemma PSpace.wsum₂_map_apply (r : I) (f₀ f₁ : Ω → Ω') (p₀ p₁ : PSpace Ω)
    {S : Set Ω'}
    (hS : MeasurableSet[(PSpace.wsum₂ r (PSpace.map f₀ p₀) (PSpace.map f₁ p₁)).ms] S) :
    (PSpace.wsum₂ r (PSpace.map f₀ p₀) (PSpace.map f₁ p₁)).μ S
      = (1 - (toNNReal r : ℝ≥0∞)) * p₀.μ (f₀ ⁻¹' S)
        + (toNNReal r : ℝ≥0∞) * p₁.μ (f₁ ⁻¹' S) := by
  rw [PSpace.wsum₂_apply r _ _ hS]
  congr 1
  · rcases eq_or_ne r 1 with rfl | h0
    · simp
    · rw [PSpace.map_apply f₀ p₀
        (PSpace.wsumSpace_le (mem_support_bernoulliWeights_false h0) S hS)]
  · rcases eq_or_ne r 0 with rfl | h1
    · simp
    · rw [PSpace.map_apply f₁ p₁
        (PSpace.wsumSpace_le (mem_support_bernoulliWeights_true h1) S hS)]

/-! ### Measurability helpers for pushforwards and weighted sums -/

/-- If every subset of the target has a `p`-measurable preimage, the pushforward's
σ-algebra is the discrete one. -/
lemma PSpace.map_ms_eq_top {p : PSpace Ω} {f : Ω → Ω'}
    (h : ∀ S : Set Ω', MeasurableSet[p.ms] (f ⁻¹' S)) :
    (PSpace.map f p).ms = (⊤ : MeasurableSpace Ω') :=
  PSpace.ms_eq_top_of_all (fun S => h S)

/-- An event measurable in both branches is measurable in their weighted sum. -/
lemma PSpace.measurableSet_wsum₂ {r : I} {p₀ p₁ : PSpace Ω} {E : Set Ω}
    (h₀ : MeasurableSet[p₀.ms] E) (h₁ : MeasurableSet[p₁.ms] E) :
    MeasurableSet[(PSpace.wsum₂ r p₀ p₁).ms] E :=
  MeasurableSpace.measurableSet_iInf.mpr (fun v =>
    MeasurableSpace.measurableSet_iInf.mpr (fun _ => by cases v <;> simpa))

end WeightedSum

section BoundedFootprint

abbrev Tape (α : Type*) := ℕ → α

abbrev TapeEvent (α : Type*) := Set (Tape α)

structure BoundedFootprintPsp (α : Type*) [Inhabited α] where
  psp : PSp (Tape α)
  atoms : Set (TapeEvent α)

  measurable : ∀ X ∈ atoms, ∀ (h : ✓psp), MeasurableSet[(ValidPSp.toPSpace ⟨psp, h⟩).ms] X
  sigmaAgrees : (h : ✓psp) →
    (ValidPSp.toPSpace ⟨psp, h⟩).ms = MeasurableSpace.generateFrom atoms
  disjoint : atoms.PairwiseDisjoint id

  prefixes : atoms → List α
  agreeOnPrefix : ∀ X : atoms, ∀ ρ ∈ X.1, ∀ i : Fin (prefixes X).length, ρ i.1 = (prefixes X)[i]
  determinedByPrefix : ∀ X : atoms, ∀ ρ ∈ X.1, ∀ ρ' : Tape α,
    (∀ i < (prefixes X).length, ρ i = ρ' i) → ρ' ∈ X.1

  pathInTreeValid : ∀ X Y : atoms, X ≠ Y → ¬ prefixes X <+: prefixes Y
  complete : ∀ ρ : Tape α, ∃ X ∈ atoms, ρ ∈ X

namespace BoundedFootprintPsp

variable {α : Type*} [Inhabited α]

/-- Distinct atoms have prefix-incomparable prefixes, so in particular distinct ones. -/
lemma prefixes_injective (b : BoundedFootprintPsp α) : Function.Injective b.prefixes := by
  intro X Y h
  by_contra hne
  exact b.pathInTreeValid X Y hne (h ▸ List.prefix_refl _)

/-- The atom a tape lands in: `complete` says there is one, `disjoint` says there is only one. -/
noncomputable def atomOf (b : BoundedFootprintPsp α) (ρ : Tape α) : b.atoms :=
  ⟨(b.complete ρ).choose, (b.complete ρ).choose_spec.1⟩

lemma mem_atomOf (b : BoundedFootprintPsp α) (ρ : Tape α) : ρ ∈ (b.atomOf ρ).1 :=
  (b.complete ρ).choose_spec.2

/-- `atomOf` picks out *the* atom containing the tape: any atom containing it is that one. -/
lemma atomOf_eq (b : BoundedFootprintPsp α) {ρ : Tape α} {X : b.atoms} (hρ : ρ ∈ X.1) :
    b.atomOf ρ = X := by
  by_contra hne
  exact Set.disjoint_left.mp (b.disjoint (b.atomOf ρ).2 X.2 (Subtype.coe_ne_coe.mpr hne))
    (b.mem_atomOf ρ) hρ

/-- The atoms are exactly the fibres of `atomOf`, so it is measurable for the footprint's
σ-algebra. -/
lemma preimage_atomOf (b : BoundedFootprintPsp α) (X : b.atoms) : b.atomOf ⁻¹' {X} = X.1 := by
  ext ρ
  simp only [Set.mem_preimage, Set.mem_singleton_iff]
  exact ⟨fun h ↦ h ▸ b.mem_atomOf ρ, fun h ↦ b.atomOf_eq h⟩

omit [Inhabited α] in
/-- Prefix-freeness is automatic for a disjoint family of nonempty, prefix-determined atoms:
if one atom's prefix extended another's, the first atom's tapes would already lie in the
second. This is what discharges `pathInTreeValid` when a footprint is built. -/
lemma pathInTreeValid_of_disjoint {atoms : Set (TapeEvent α)} {prefixes : atoms → List α}
    (hdisj : atoms.PairwiseDisjoint id)
    (hne : ∀ X : atoms, X.1.Nonempty)
    (hagree : ∀ X : atoms, ∀ ρ ∈ X.1, ∀ i : Fin (prefixes X).length, ρ i.1 = (prefixes X)[i])
    (hdet : ∀ X : atoms, ∀ ρ ∈ X.1, ∀ ρ' : Tape α,
      (∀ i < (prefixes X).length, ρ i = ρ' i) → ρ' ∈ X.1) :
    ∀ X Y : atoms, X ≠ Y → ¬ prefixes X <+: prefixes Y := by
  rintro X Y hXY hpre
  obtain ⟨ρ, hρ⟩ := hne X
  obtain ⟨ρ', hρ'⟩ := hne Y
  have hlen : (prefixes X).length ≤ (prefixes Y).length := hpre.length_le
  have hmem : ρ' ∈ X.1 := hdet X ρ hρ ρ' fun i hi ↦ by
    rw [hagree X ρ hρ ⟨i, hi⟩, hagree Y ρ' hρ' ⟨i, by omega⟩]
    simpa using hpre.getElem hi
  exact Set.disjoint_left.mp (hdisj X.2 Y.2 (Subtype.coe_ne_coe.mpr hXY)) hmem hρ'

/-- A space that reads nothing has the trivial footprint: a single atom, the whole space.
This is the footprint of the unit, and of the undefined space `⊤`, whose σ-algebra is never
observed. -/
def ofMsBot (psp : PSp (Tape α))
    (hms : ∀ h : ✓psp, (ValidPSp.toPSpace ⟨psp, h⟩).ms = ⊥) : BoundedFootprintPsp α where
  psp := psp
  atoms := {Set.univ}
  measurable := fun X hX h ↦ by
    rw [hms h, Set.mem_singleton_iff.mp hX]; exact MeasurableSet.univ
  sigmaAgrees := fun h ↦ by rw [hms h, MeasurableSpace.generateFrom_singleton_univ]
  disjoint := Set.pairwiseDisjoint_singleton _ _
  prefixes := fun _ ↦ []
  agreeOnPrefix := fun _ _ _ i ↦ i.elim0
  determinedByPrefix := fun X _ _ ρ' _ ↦ by
    rw [Set.mem_singleton_iff.mp X.2]; trivial
  pathInTreeValid := fun X Y hXY _ ↦ hXY (Subtype.ext
    ((Set.mem_singleton_iff.mp X.2).trans (Set.mem_singleton_iff.mp Y.2).symm))
  complete := fun _ ↦ ⟨Set.univ, rfl, trivial⟩

/-- How far into the tape each atom reads. -/
def boundmap (bfpsp : BoundedFootprintPsp α) : bfpsp.atoms → ℕ :=
  List.length ∘ bfpsp.prefixes

/-- The prefixes of a footprint have bounded length: its nonempty atoms are cylinders, hence open,
and they cover the compact space `Tape α`, so finitely many of them already do. By disjointness
these are all the nonempty atoms; the empty atom, if any, contributes one more value. -/
lemma bddAbove_boundmap [Finite α] (bfpsp : BoundedFootprintPsp α) :
    BddAbove (Set.range bfpsp.boundmap) := by
  classical
  -- a finite alphabet makes `Tape α` a compact space, which is what bounds the prefixes
  let _ : TopologicalSpace α := ⊥
  have : DiscreteTopology α := ⟨rfl⟩
  have hopen : ∀ X : {X : bfpsp.atoms // X.1.Nonempty}, IsOpen X.1.1 := by
    rintro ⟨X, ρ, hρ⟩
    have hX : X.1 = ⋂ i : Fin (bfpsp.prefixes X).length, (fun ω : Tape α ↦ ω i) ⁻¹' {ρ i} := by
      ext ρ'
      simp only [Set.mem_iInter, Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h' i ↦ by rw [bfpsp.agreeOnPrefix X ρ' h' i, bfpsp.agreeOnPrefix X ρ hρ i],
        fun h' ↦ bfpsp.determinedByPrefix X ρ hρ ρ' fun i hi ↦ (h' ⟨i, hi⟩).symm⟩
    rw [hX]
    exact isOpen_iInter_of_finite fun i ↦ (isOpen_discrete _).preimage (continuous_apply _)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun X : {X : bfpsp.atoms // X.1.Nonempty} ↦ X.1.1) hopen fun ρ _ ↦ by
      obtain ⟨X, hX, hρ⟩ := bfpsp.complete ρ
      exact Set.mem_iUnion.mpr ⟨⟨⟨X, hX⟩, ρ, hρ⟩, hρ⟩
  refine ((t.image fun X ↦ bfpsp.boundmap X.1).finite_toSet.union (Set.finite_singleton
    (if h : ∅ ∈ bfpsp.atoms then bfpsp.boundmap ⟨∅, h⟩ else 0))).bddAbove.mono ?_
  rintro _ ⟨X, rfl⟩
  by_cases hne : X.1.Nonempty
  · obtain ⟨ρ, hρ⟩ := hne
    obtain ⟨Y, hY, hρY⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ ρ))
    have hYX : Y.1 = X := by
      by_contra hYX
      exact Set.disjoint_left.mp (bfpsp.disjoint Y.1.2 X.2 (Subtype.coe_ne_coe.mpr hYX)) hρY hρ
    left
    exact Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨Y, hY, by rw [hYX]⟩)
  · right
    have hX : X.1 = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
    have hmem : ∅ ∈ bfpsp.atoms := hX ▸ X.2
    simp only [Set.mem_singleton_iff, hmem, ↓reduceDIte]
    exact congrArg bfpsp.boundmap (Subtype.ext hX)

/-- A footprint has finitely many atoms: they are distinguished by their prefixes, which are
boundedly long words over a finite alphabet. -/
lemma finite_atoms [Finite α] (b : BoundedFootprintPsp α) : b.atoms.Finite := by
  classical
  have hle : ∀ X : b.atoms, (b.prefixes X).length ≤ ⨆ X : b.atoms, b.boundmap X := fun X ↦
    le_ciSup b.bddAbove_boundmap X
  have : Finite {l : List α // l.length ≤ ⨆ X : b.atoms, b.boundmap X} :=
    (List.finite_length_le α _).to_subtype
  refine Set.finite_coe_iff.mp (Finite.of_injective
    (fun X : b.atoms ↦ (⟨b.prefixes X, hle X⟩ : {l : List α // l.length ≤ _})) ?_)
  intro X Y h
  exact b.prefixes_injective (congrArg Subtype.val h)

/-! ### The product of two footprints

Independent spaces compose, and so do their footprints: the atoms of the product are the
nonempty intersections `X ∩ Y` of the two families, read as far as the deeper of the two
halves.  This is what makes `HasBoundedFootprint` closed under `*`, and hence the
bounded-footprint spaces a resource algebra of their own. -/

section Inter

variable (b₁ b₂ : BoundedFootprintPsp α)

/-- The atoms of a product: the nonempty intersections of the two atom families. -/
def interAtoms : Set (TapeEvent α) :=
  {Z | Z.Nonempty ∧ ∃ X ∈ b₁.atoms, ∃ Y ∈ b₂.atoms, Z = X ∩ Y}

variable {b₁ b₂}

/-- The left half of an atom of a product. -/
def interLeft (Z : interAtoms b₁ b₂) : b₁.atoms :=
  ⟨Z.2.2.choose, Z.2.2.choose_spec.1⟩

/-- The right half of an atom of a product. -/
def interRight (Z : interAtoms b₁ b₂) : b₂.atoms :=
  ⟨Z.2.2.choose_spec.2.choose, Z.2.2.choose_spec.2.choose_spec.1⟩

lemma interEq (Z : interAtoms b₁ b₂) : Z.1 = (interLeft Z).1 ∩ (interRight Z).1 :=
  Z.2.2.choose_spec.2.choose_spec.2

lemma interComplete (ρ : Tape α) : ∃ Z ∈ interAtoms b₁ b₂, ρ ∈ Z := by
  obtain ⟨X, hX, hρX⟩ := b₁.complete ρ
  obtain ⟨Y, hY, hρY⟩ := b₂.complete ρ
  exact ⟨X ∩ Y, ⟨⟨ρ, hρX, hρY⟩, X, hX, Y, hY, rfl⟩, hρX, hρY⟩

lemma interDisjoint : (interAtoms b₁ b₂).PairwiseDisjoint id := by
  rintro _ ⟨-, X, hX, Y, hY, rfl⟩ _ ⟨-, X', hX', Y', hY', rfl⟩ hne
  refine Set.disjoint_left.mpr fun ρ hρ hρ' ↦ ?_
  by_cases hXX : X = X'
  · subst hXX
    exact Set.disjoint_left.mp (b₂.disjoint hY hY' (fun h ↦ hne (by rw [h]))) hρ.2 hρ'.2
  · exact Set.disjoint_left.mp (b₁.disjoint hX hX' hXX) hρ.1 hρ'.1

/-- The longer of two prefixes. -/
def maxPrefix (p q : List α) : List α := if p.length ≤ q.length then q else p

omit [Inhabited α] in
lemma length_le_maxPrefix_left (p q : List α) : p.length ≤ (maxPrefix p q).length := by
  unfold maxPrefix; split <;> omega

omit [Inhabited α] in
lemma length_le_maxPrefix_right (p q : List α) : q.length ≤ (maxPrefix p q).length := by
  unfold maxPrefix; split <;> omega

/-- An atom of a product is decided by the longer of its two halves' prefixes. -/
def interPrefixes (Z : interAtoms b₁ b₂) : List α :=
  maxPrefix (b₁.prefixes (interLeft Z)) (b₂.prefixes (interRight Z))

lemma interAgreeOnPrefix (Z : interAtoms b₁ b₂) (ρ : Tape α) (hρ : ρ ∈ Z.1)
    (i : Fin (interPrefixes Z).length) : ρ i.1 = (interPrefixes Z)[i] := by
  have hmem : ρ ∈ (interLeft Z).1 ∩ (interRight Z).1 := interEq Z ▸ hρ
  obtain ⟨i, hi⟩ := i
  simp only [interPrefixes, maxPrefix] at hi ⊢
  split_ifs at hi ⊢ with h
  · simpa using b₂.agreeOnPrefix (interRight Z) ρ hmem.2 ⟨i, hi⟩
  · simpa using b₁.agreeOnPrefix (interLeft Z) ρ hmem.1 ⟨i, hi⟩

lemma interDeterminedByPrefix (Z : interAtoms b₁ b₂) (ρ : Tape α) (hρ : ρ ∈ Z.1) (ρ' : Tape α)
    (h : ∀ i < (interPrefixes Z).length, ρ i = ρ' i) : ρ' ∈ Z.1 := by
  have hmem : ρ ∈ (interLeft Z).1 ∩ (interRight Z).1 := interEq Z ▸ hρ
  rw [interEq Z]
  exact ⟨b₁.determinedByPrefix _ ρ hmem.1 ρ' fun i hi ↦
      h i (lt_of_lt_of_le hi (length_le_maxPrefix_left ..)),
    b₂.determinedByPrefix _ ρ hmem.2 ρ' fun i hi ↦
      h i (lt_of_lt_of_le hi (length_le_maxPrefix_right ..))⟩

lemma measurableSet_inter_interAtoms {X Y : TapeEvent α} (hX : X ∈ b₁.atoms) (hY : Y ∈ b₂.atoms) :
    MeasurableSet[MeasurableSpace.generateFrom (interAtoms b₁ b₂)] (X ∩ Y) := by
  rcases Set.eq_empty_or_nonempty (X ∩ Y) with he | hne
  · rw [he]; exact MeasurableSpace.measurableSet_empty _
  · exact MeasurableSpace.measurableSet_generateFrom ⟨hne, X, hX, Y, hY, rfl⟩

/-- The σ-algebra of a product is generated by the intersections: each atom of one family is
the -- necessarily finite -- union of its intersections with the other's. -/
lemma generateFrom_interAtoms [Finite α] :
    MeasurableSpace.generateFrom b₁.atoms ⊔ MeasurableSpace.generateFrom b₂.atoms
      = MeasurableSpace.generateFrom (interAtoms b₁ b₂) := by
  refine le_antisymm (sup_le ?_ ?_) (MeasurableSpace.generateFrom_le ?_)
  · refine MeasurableSpace.generateFrom_le fun X hX ↦ ?_
    rw [show X = ⋃ Y ∈ b₂.atoms, X ∩ Y by
      ext ρ
      simp only [Set.mem_iUnion, Set.mem_inter_iff, exists_prop]
      exact ⟨fun h ↦ (b₂.complete ρ).imp fun Y hY ↦ ⟨hY.1, h, hY.2⟩, fun ⟨_, _, h, _⟩ ↦ h⟩]
    exact b₂.finite_atoms.measurableSet_biUnion fun Y hY ↦ measurableSet_inter_interAtoms hX hY
  · refine MeasurableSpace.generateFrom_le fun Y hY ↦ ?_
    rw [show Y = ⋃ X ∈ b₁.atoms, X ∩ Y by
      ext ρ
      simp only [Set.mem_iUnion, Set.mem_inter_iff, exists_prop]
      exact ⟨fun h ↦ (b₁.complete ρ).imp fun X hX ↦ ⟨hX.1, hX.2, h⟩, fun ⟨_, _, _, h⟩ ↦ h⟩]
    exact b₁.finite_atoms.measurableSet_biUnion fun X hX ↦ measurableSet_inter_interAtoms hX hY
  · rintro _ ⟨-, X, hX, Y, hY, rfl⟩
    exact mem_sup_inter _ _ (MeasurableSpace.measurableSet_generateFrom hX)
      (MeasurableSpace.measurableSet_generateFrom hY)

/-- The σ-algebra of a product space, read off the two footprints. -/
lemma ms_mul_eq [Finite α] (h : ✓(b₁.psp * b₂.psp)) :
    (ValidPSp.toPSpace ⟨b₁.psp * b₂.psp, h⟩).ms
      = MeasurableSpace.generateFrom (interAtoms b₁ b₂) := by
  have hxy : b₁.psp * b₂.psp ≠ (⊤ : PSp (Tape α)) := PSp.valid_def.mp h
  have hx : ✓b₁.psp := PSp.valid_def.mpr (PSp.mul_defined_imp_defined hxy)
  have hy : ✓b₂.psp := PSp.valid_def.mpr
    (PSp.mul_defined_imp_defined (by rwa [mul_comm] at hxy))
  obtain ⟨p, hp⟩ : ∃ p, b₁.psp = .some p := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp hx)
  obtain ⟨q, hq⟩ : ∃ q, b₂.psp = .some q := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp hy)
  obtain ⟨s, hs⟩ : ∃ s, b₁.psp * b₂.psp = .some s := Option.ne_none_iff_exists'.mp hxy
  have hms : s.ms = p.ms ⊔ q.ms := by
    rw [hp, hq] at hs
    exact (PSp.mul_inversion hs).1
  have h₁ : p.ms = MeasurableSpace.generateFrom b₁.atoms := by
    rw [← ValidPSp.toPSpace_eq hx hp]; exact b₁.sigmaAgrees hx
  have h₂ : q.ms = MeasurableSpace.generateFrom b₂.atoms := by
    rw [← ValidPSp.toPSpace_eq hy hq]; exact b₂.sigmaAgrees hy
  rw [ValidPSp.toPSpace_eq h hs, hms, h₁, h₂, generateFrom_interAtoms]

/-- The footprint of an independent product. -/
def inter [Finite α] (b₁ b₂ : BoundedFootprintPsp α) : BoundedFootprintPsp α where
  psp := b₁.psp * b₂.psp
  atoms := interAtoms b₁ b₂
  measurable := fun _ hX h ↦ by
    rw [ms_mul_eq h]; exact MeasurableSpace.measurableSet_generateFrom hX
  sigmaAgrees := fun h ↦ ms_mul_eq h
  disjoint := interDisjoint
  prefixes := interPrefixes
  agreeOnPrefix := interAgreeOnPrefix
  determinedByPrefix := interDeterminedByPrefix
  pathInTreeValid := pathInTreeValid_of_disjoint interDisjoint (fun Z ↦ Z.2.1)
    interAgreeOnPrefix interDeterminedByPrefix
  complete := interComplete

end Inter

end BoundedFootprintPsp

/-! ### Bounded-footprint spaces as a resource algebra -/

variable {α : Type*} [Inhabited α]

/-- `psp` reads only a bounded part of the tape: its σ-algebra sits inside the one some
footprint tree generates.  Two things about this shape matter.  Only the σ-algebra appears,
so re-measuring a space -- as a conditioning kernel's fibres do -- keeps it bounded; and the
bound is `≤`, not `=`, so the predicate is closed downward under the resource order, which
is exactly coarsening.  At the undefined space `⊤` the condition is vacuous. -/
def HasBoundedFootprint (psp : PSp (Tape α)) : Prop :=
  ∃ b : BoundedFootprintPsp α, ∀ h : ✓psp,
    (ValidPSp.toPSpace ⟨psp, h⟩).ms ≤ MeasurableSpace.generateFrom b.atoms

/-- A footprint tree's own space is bounded. -/
lemma hasBoundedFootprint_of_tree (b : BoundedFootprintPsp α) : HasBoundedFootprint b.psp :=
  ⟨b, fun h ↦ le_of_eq (b.sigmaAgrees h)⟩

/-- Coarsening keeps a footprint bounded: a smaller space reads no more of the tape. -/
lemma hasBoundedFootprint_mono {p q : PSp (Tape α)} (hq : ✓q) (hpq : p ≤ q)
    (h : HasBoundedFootprint q) : HasBoundedFootprint p := by
  obtain ⟨b, hb⟩ := h
  refine ⟨b, fun hp ↦ ?_⟩
  refine le_trans ?_ (hb hq)
  obtain ⟨p', hp'⟩ := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp hp)
  obtain ⟨q', hq'⟩ := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp hq)
  subst hp'; subst hq'
  rw [ValidPSp.toPSpace_eq hp rfl, ValidPSp.toPSpace_eq hq rfl]
  exact (WithTop.coe_le_coe.1 hpq).1

lemma hasBoundedFootprint_one : HasBoundedFootprint (1 : PSp (Tape α)) :=
  hasBoundedFootprint_of_tree (BoundedFootprintPsp.ofMsBot 1 fun _ ↦ rfl)

/-- The undefined space reads nothing, vacuously. -/
lemma hasBoundedFootprint_top : HasBoundedFootprint (⊤ : PSp (Tape α)) :=
  ⟨BoundedFootprintPsp.ofMsBot 1 fun _ ↦ rfl, fun h ↦ absurd rfl (PSp.valid_def.mp h)⟩

lemma hasBoundedFootprint_mul [Finite α] {x y : PSp (Tape α)}
    (hx : HasBoundedFootprint x) (hy : HasBoundedFootprint y) : HasBoundedFootprint (x * y) := by
  obtain ⟨b₁, h₁⟩ := hx
  obtain ⟨b₂, h₂⟩ := hy
  refine ⟨b₁.inter b₂, fun h ↦ ?_⟩
  have hxv : ✓x := PSp.valid_def.mpr (PSp.mul_defined_imp_defined (PSp.valid_def.mp h))
  have hyv : ✓y := PSp.valid_def.mpr
    (PSp.mul_defined_imp_defined (by rw [PSp.mul_comm]; exact PSp.valid_def.mp h))
  obtain ⟨x', hx'⟩ := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp hxv)
  obtain ⟨y', hy'⟩ := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp hyv)
  obtain ⟨s, hs⟩ := Option.ne_none_iff_exists'.mp (PSp.valid_def.mp h)
  have hsi : s =ᵢ x' ⊕ᵢ y' := by
    apply PSp.mul_inversion
    rw [← hx', ← hy']
    exact hs
  have hms : (ValidPSp.toPSpace ⟨x * y, h⟩).ms = x'.ms ⊔ y'.ms := by
    rw [ValidPSp.toPSpace_eq h hs]
    exact hsi.1
  rw [hms]
  show _ ≤ MeasurableSpace.generateFrom (BoundedFootprintPsp.interAtoms b₁ b₂)
  rw [← BoundedFootprintPsp.generateFrom_interAtoms]
  refine sup_le_sup ?_ ?_
  · have := h₁ hxv
    rwa [ValidPSp.toPSpace_eq hxv hx'] at this
  · have := h₂ hyv
    rwa [ValidPSp.toPSpace_eq hyv hy'] at this

/-- Bounded footprint is a property of the σ-algebra alone, so a space may be re-measured
and stays bounded. -/
lemma hasBoundedFootprint_congr {p q : PSp (Tape α)} (hvp : ✓p) (hvq : ✓q)
    (hms : (ValidPSp.toPSpace ⟨p, hvp⟩).ms = (ValidPSp.toPSpace ⟨q, hvq⟩).ms)
    (h : HasBoundedFootprint p) : HasBoundedFootprint q := by
  obtain ⟨b, hb⟩ := h
  exact ⟨b, fun h' ↦ hms ▸ hb hvp⟩

/-- The probability spaces over `Tape α` that read only a bounded part of the tape. -/
abbrev BoundedFootprintSpace (α : Type*) [Inhabited α] : Type _ :=
  {psp : PSp (Tape α) // HasBoundedFootprint psp}

/-- The resource a footprint carries: a `BoundedFootprintPsp` is exactly a witness for the
side condition `HasBoundedFootprint`, so it names an element of the resource algebra. -/
def BoundedFootprintPsp.toSpace (b : BoundedFootprintPsp α) : BoundedFootprintSpace α :=
  ⟨b.psp, hasBoundedFootprint_of_tree b⟩

@[simp]
lemma BoundedFootprintPsp.toSpace_val (b : BoundedFootprintPsp α) : b.toSpace.val = b.psp := rfl

/-- Bounded-footprint spaces contain the unit and are closed under independent products, so
they are a resource algebra in their own right -- a subalgebra of `PSp (Tape α)`. -/
instance [Finite α] : Iris.OrderedUnitalResourceAlgebra (BoundedFootprintSpace α) :=
  Iris.OrderedUnitalResourceAlgebra.subalgebra
    (inferInstance : Iris.OrderedUnitalResourceAlgebra (PSp (Tape α)))
    hasBoundedFootprint_one fun _ _ ↦ hasBoundedFootprint_mul

/-- The resource algebra's discrete OFE, chosen ahead of iris-lean's `OFE` on subtypes: validity
`✓` is read through the CMRA built on this one. -/
instance (priority := high) [Finite α] : Iris.OFE (BoundedFootprintSpace α) :=
  Iris.OrderedUnitalResourceAlgebra.instOFE

instance {α : Type} [Inhabited α] : One (BoundedFootprintPsp α) where
  one := {
    psp := 1
    atoms := {Set.univ}
    measurable := by simp
    sigmaAgrees := fun h ↦ by
      simp only [ms, ValidPSp.toPSpace, generateFrom_singleton, Set.mem_univ, comap_const]
      rfl
    disjoint := by simp
    prefixes := fun _ ↦ []
    agreeOnPrefix := by simp
    determinedByPrefix := by simp
    pathInTreeValid := by simp
    complete := by simp
  }

/-- The unit footprint is a defined space: it carries the unit `PSp`, which is never `⊤`. -/
lemma BoundedFootprintPsp.valid_one {α : Type} [Inhabited α] :
    ✓(1 : BoundedFootprintPsp α).psp := by
  rw [PSp.valid_def]
  exact Option.some_ne_none _

end BoundedFootprint

end

