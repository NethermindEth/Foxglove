/-! ## Independent product of probability measures -/

@[expose] public section

open ProbabilityTheory MeasureTheory

alias MeasureTheory.MeasureSpace.σAlg := MeasureSpace.toMeasurableSpace
alias MeasureTheory.MeasureSpace.μ := MeasureSpace.volume

variable {Ω Ω' : Type*}

noncomputable section

namespace MeasureTheory

abbrev Measure.map! (ms₁ : MeasurableSpace Ω) (ms₂ : MeasurableSpace Ω')
                    (f : Ω → Ω') (μ : Measure Ω) : Measure Ω' := @μ.map _ _ ms₁ ms₂ f

abbrev Measure.cast {Ω : Type u} {ms₁ : MeasurableSpace Ω}
  (μ : Measure Ω) (ms₂ : MeasurableSpace Ω) := μ.map! ms₁ ms₂ id

@[simp]
lemma Measure.cast_eq_self {Ω : Type u} {ms₁ : MeasurableSpace Ω}
  (μ : Measure Ω) (ms₂ : MeasurableSpace Ω)
  : μ.cast ms₂ = @μ.map _ _ ms₁ ms₂ id := rfl

lemma MeasurableSet.measurableSet_bot_induction
  {P : Set Ω → Prop}
  (h_base : P ∅) (h_ind : P Set.univ)
  : (u : Set Ω) → MeasurableSet[⊥] u → P u := by
  intro u h_u
  have : u = ∅ ∨ u = Set.univ := by
    apply MeasurableSpace.measurableSet_bot_iff.1 h_u
  grind

end MeasureTheory

/-- The σ-algebra generated by the measurable sets of both `m₁` and `m₂` is their join. -/
lemma MeasurableSpace.sup_eq_generateFrom (m₁ m₂ : MeasurableSpace Ω) :
    m₁ ⊔ m₂ = MeasurableSpace.generateFrom (MeasurableSet[m₁] ∪ MeasurableSet[m₂]) := by
  conv_lhs => rw [← @MeasurableSpace.generateFrom_measurableSet Ω m₁,
                  ← @MeasurableSpace.generateFrom_measurableSet Ω m₂,
                  MeasurableSpace.generateFrom_sup_generateFrom]
  rfl

theorem MeasurableSpace.cast
  (m₁ m₂ : MeasurableSpace Ω) (p : m₁ = m₂) (E : Set Ω) (h : MeasurableSet[m₁] E) :
  MeasurableSet[m₂] E := by
  subst p
  simp_all only

end

namespace ProbSpace

open MeasurableSpace Measure PMF

-- Everything below depends on measures and σ-algebras, which are noncomputable.
noncomputable section

section GeneratorMembership

def _root_.MeasurableSpace.supGenerator (m₁ m₂ : MeasurableSpace Ω) : Set (Set Ω) :=
  {S : Set Ω | ∃ F G, S = F ∩ G ∧ MeasurableSet[m₁] F ∧ MeasurableSet[m₂] G}

/-- Every set in the generating set `w` is of the form `u ∩ v` -/
lemma exists_inter_measurableSet_of_mem_supGenerator
  (m₁ m₂ : MeasurableSpace Ω)
  {w : Set Ω}
  (hw : w ∈ MeasurableSpace.supGenerator m₁ m₂)
  : ∃ u v, w = u ∩ v ∧ MeasurableSet[m₁] u ∧ MeasurableSet[m₂] v := by
  rcases hw with ⟨u, v, rfl, hu, hv⟩
  grind

@[aesop 50% apply]
lemma mem_supGenerator_l
  (m₁ : MeasurableSpace Ω)
  {u : Set Ω} (hu : MeasurableSet[m₁] u) :
  u ∈ MeasurableSpace.supGenerator m₁ m₂ := by
  use u, ⊤
  aesop

@[aesop 50% apply]
lemma mem_supGenerator_r
  (m₁ m₂ : MeasurableSpace Ω)
  {u : Set Ω} (hu : MeasurableSet[m₂] u) :
  u ∈ MeasurableSpace.supGenerator m₁ m₂ := by
  use ⊤, u
  aesop

lemma inter_mem_supGenerator
  (m₁ m₂ : MeasurableSpace Ω)
  {u v : Set Ω}
  (hu : MeasurableSet[m₁] u) (hv : MeasurableSet[m₂] v) :
  u ∩ v ∈ MeasurableSpace.supGenerator m₁ m₂ := by
  use u, v

theorem _root_.MeasurableSpace.generateFrom_supGenerator_eq_sup
  (m₁ m₂ : MeasurableSpace Ω)
  : MeasurableSpace.generateFrom (MeasurableSpace.supGenerator m₁ m₂)
    = m₁ ⊔ m₂ := by
  ext s
  refine ⟨?p, by
    apply MeasurableSpace.generateFrom_mono
    exact fun _ h ↦ h.elim (mem_supGenerator_l _) (mem_supGenerator_r _ _)⟩
  let sumSp := MeasurableSet[m₁ ⊔ m₂]
  apply MeasurableSpace.generateFrom_le
  rintro t ⟨u, ⟨v, _, _, _⟩⟩
  have h₂ : MeasurableSpace.supGenerator m₁ m₂ ⊆ sumSp := fun w hw ↦ by
    obtain ⟨u, v, rfl, hu, hv⟩ :=
      @exists_inter_measurableSet_of_mem_supGenerator Ω m₁ m₂ (w := w) hw
    unfold sumSp
    have h₁ : MeasurableSet[m₁ ⊔ m₂] u := by
      have : u ∈ MeasurableSpace.supGenerator m₁ m₂ := by aesop
      apply MeasurableSpace.measurableSet_generateFrom
      exact Or.inl hu
    have h₂ : MeasurableSet[m₁ ⊔ m₂] v := by
      have : v ∈ MeasurableSpace.supGenerator m₁ m₂ := by aesop
      apply MeasurableSpace.measurableSet_generateFrom
      exact Or.inr hv
    apply MeasurableSet.inter h₁ h₂
  aesop (add simp (show u ∩ v ∈ supGenerator m₁ m₂ by use u, v))

end GeneratorMembership

section Sup

variable (m m₁ m₂ : MeasurableSpace Ω)

@[aesop 50% apply]
lemma mem_sup_l {u : Set Ω} (hu : MeasurableSet[m₁] u) :
  MeasurableSet[m₁ ⊔ m₂] u := (le_sup_left : m₁ ≤ m₁ ⊔ m₂) u hu

@[aesop 50% apply]
lemma mem_sup_r {u : Set Ω} (hu : MeasurableSet[m₂] u) :
  MeasurableSet[m₁ ⊔ m₂] u := (le_sup_right : m₂ ≤ m₁ ⊔ m₂) u hu

lemma mem_sup_inter {u v : Set Ω}
  (hu : MeasurableSet[m₁] u) (hv : MeasurableSet[m₂] v)
  : MeasurableSet[m₁ ⊔ m₂] (u ∩ v) :=
  (mem_sup_l m₁ m₂ hu).inter (mem_sup_r m₁ m₂ hv)

end Sup

/- We define `(𝓕, μ) ≤ (𝓖, ν)` if `𝓕 ⊆ 𝓖` and `μ` is the restriction of `ν` to `𝓕` -/
@[ext]
structure MeasureOnSpace (Ω : Type*) where
  ms : MeasurableSpace Ω
  μ : Measure[ms] Ω

instance : Preorder (MeasureOnSpace Ω) where
  le (ps₁ ps₂) := ps₁.ms ≤ ps₂.ms ∧ ps₁.μ = ps₂.μ.cast _
  le_refl := by simp
  le_trans (h₁ h₂) := by
    aesop (add safe forward le_trans) (add safe (by rw [MeasureTheory.Measure.map_map]))


def PSpace (Ω : Type*) :=
  {m : MeasureOnSpace Ω // IsProbabilityMeasure m.μ}

instance (Ω : Type*) : Preorder (PSpace Ω) where
  le (ps₁ ps₂) := (ps₁.1.ms ≤ ps₂.1.ms) ∧ ps₁.1.μ = ps₂.1.μ.cast _
  le_refl := by simp
  le_trans {a b c} (h₁ h₂) := by
    aesop (add safe forward le_trans) (add safe (by rw [MeasureTheory.Measure.map_map]))

abbrev PSp (Ω : Type*) := WithTop (PSpace Ω)

/-- Holds if `r` is the independent product of `p` and `q` -/
def PSpace.isIndependentProduct (r p q : PSpace Ω) :=
  r.1.ms = p.1.ms ⊔ q.1.ms ∧
  letI μ₁ := p.1.μ
  letI μ₂ := q.1.μ
  letI μ := r.1.μ
  ∀ E (_ : MeasurableSet[p.1.ms] E)
    F (_ : MeasurableSet[q.1.ms] F),
  μ (E ∩ F) = μ₁ E * μ₂ F

lemma PSpace.isIndependentProduct_def {r p q : PSpace Ω} :
  isIndependentProduct r p q ↔
  r.1.ms = p.1.ms ⊔ q.1.ms ∧
  ∀ E (_ : MeasurableSet[p.1.ms] E)
    F (_ : MeasurableSet[q.1.ms] F),
  r.1.μ (E ∩ F) = p.1.μ E * q.1.μ F := Iff.rfl

open PSpace

notation:60 (priority := high) r " =ᵢ " p " ⊕ᵢ " q:arg => isIndependentProduct r p q

lemma PSpace.ms_eq_of_isIndependentProduct {r r' p q : PSpace Ω}
  (h₁ : r =ᵢ p ⊕ᵢ q) (h₂ : r' =ᵢ p ⊕ᵢ q) :
  r.1.ms = r'.1.ms := by
  rcases h₁ with ⟨a, _⟩
  rcases h₂ with ⟨c, _⟩
  aesop

section GeneratingPiSystem

variable {Ω : Type*} (p q : MeasureOnSpace Ω)

/--
  Given `p q : MeasureOnSpace Ω`, `generator p q` is a set of subsets of Ω that
  generates the smallest σ-algebra containing both σ-algebras
-/
def generator (p q : MeasureOnSpace Ω) : Set (Set Ω) :=
  {S : Set Ω | ∃ F G, S = F ∩ G ∧ MeasurableSet[p.ms] F ∧ MeasurableSet[q.ms] G}

section

variable {p q : MeasureOnSpace Ω}
         {u v w : Set Ω}

/-- Every set in the generating set `w` is of the form `u ∩ v` -/
lemma exists_inter_measurableSet_of_mem_generator (hw : w ∈ generator p q) :
  ∃ u v, w = u ∩ v ∧ MeasurableSet[p.ms] u ∧ MeasurableSet[q.ms] v := by
  rcases hw with ⟨u, v, rfl, hu, hv⟩
  grind

@[aesop 50% apply]
lemma mem_generator_l (hu : MeasurableSet[p.ms] u) :
  u ∈ generator p q := by
  use u, ⊤
  aesop

@[aesop 50% apply]
lemma mem_generator_r (hu : MeasurableSet[q.ms] u) :
  u ∈ generator p q := by
  use ⊤, u
  aesop

lemma inter_mem_generator
  (hu : MeasurableSet[p.ms] u) (hv : MeasurableSet[q.ms] v) :
  u ∩ v ∈ generator p q := by
  use u, v

attribute [local aesop safe apply] MeasurableSpace.measurableSet_generateFrom

theorem MeasureOnSpace.generateFrom_generator_eq_sum :
  MeasurableSpace.generateFrom (generator p q) = p.ms ⊔ q.ms := by
  ext s
  refine ⟨?p, by
    apply MeasurableSpace.generateFrom_mono
    exact fun _ h ↦ h.elim mem_generator_l mem_generator_r⟩
  let sumSp := MeasurableSet[p.ms ⊔ q.ms]
  apply MeasurableSpace.generateFrom_le
  rintro t ⟨u, ⟨v, _, _, _⟩⟩
  have h₂ : generator p q ⊆ sumSp := fun u hu ↦ by
    obtain ⟨u₁, v₁, rfl, hu₁, hv₁⟩ := exists_inter_measurableSet_of_mem_generator hu
    exact (mem_sup_l p.ms q.ms hu₁).inter (mem_sup_r p.ms q.ms hv₁)
  apply MeasurableSpace.generateFrom_le
  · dsimp [sumSp] at h₂
    exact h₂
  · aesop (add simp (show u ∩ v ∈ generator p q by use u, v))

lemma MeasureOnSpace.isPiSystem_generator : IsPiSystem (generator p q) := fun _ hu _ hv _ ↦ by
  obtain ⟨_, _, rfl, _, _⟩ := exists_inter_measurableSet_of_mem_generator hu
  obtain ⟨_, _, rfl, _, _⟩ := exists_inter_measurableSet_of_mem_generator hv
  rw [Set.inter_inter_inter_comm]
  aesop (add safe apply inter_mem_generator)

lemma mem_generator_imp_mem_sum (h : u ∈ generator p q)
  : MeasurableSet[p.ms ⊔ q.ms] u := by
  have h₁ := @MeasureOnSpace.generateFrom_generator_eq_sum Ω p q
  rw [← h₁]
  apply MeasurableSpace.measurableSet_generateFrom h
end

end GeneratingPiSystem

section Uniqueness

lemma _root_.MeasurableSpace.eq_cast_ext_ext
  {m₁ m₂ : MeasurableSpace Ω}
  (μ : Measure[m₁] Ω) (ν : Measure[m₂] Ω)
  (h_eq : m₁ = m₂) (h₂ : ∀ w, MeasurableSet[m₁] w → μ w = ν w) :
  μ = ν.cast _ := by aesop

@[ext]
lemma MeasureOnSpace.ext_ms {p q : MeasureOnSpace Ω}
  (h_eq_alg : p.ms = q.ms)
  (h_eq_mea : ∀ E, MeasurableSet[p.ms] E → p.μ E = q.μ E) :
  p = q := by
  aesop (add safe cases MeasureOnSpace)

lemma _root_.Measure.le_preserves_measure {p q : MeasurableSpace Ω}
  {h : p ≤ q} {μ : Measure[q] Ω}
  {u : Set Ω}
  {hu : MeasurableSet[p] u}
  : μ.cast p u = μ u := by
  have hu' : MeasurableSet[q] u := by apply h; exact hu
  unfold Measure.cast Measure.map!
  rw [Measure.map_apply] <;> aesop

lemma MeasureOnSpace.le_preserves_measure
  {p q : MeasureOnSpace Ω} (h : p ≤ q) {u : Set Ω} (hp : MeasurableSet[p.ms] u)
  : p.μ u = q.μ u := by
  rcases h with ⟨h₁, h₂⟩
  aesop (add simp Measure.le_preserves_measure)

instance [Inhabited Ω] : One (MeasureOnSpace Ω) where
  one := {ms := ⊥, μ := @Measure.dirac Ω ⊥ default}

instance [Inhabited Ω] : PartialOrder (MeasureOnSpace Ω) where
  le_antisymm m₁ m₂ h₁ h₂ := by
    have h : m₁.ms = m₂.ms := by
      ext u
      constructor
      have := h₁.1 u; aesop
      have := h₂.1 u; aesop
    ext u; rw [h]
    apply MeasureOnSpace.le_preserves_measure
    aesop; aesop

instance [Inhabited Ω] : PartialOrder (PSpace Ω) where
  le_antisymm := by
    rintro ⟨m₁, p₁⟩ ⟨m₂, p₂⟩ h₁ h₂
    have : m₁ ≤ m₂ := by aesop
    have : m₂ ≤ m₁ := by aesop
    have : m₁ = m₂ := @le_antisymm (MeasureOnSpace Ω) _ m₁ m₂ (by aesop) (by aesop)
    aesop

@[ext]
lemma PSpace.ext_ms
  {p q : PSpace Ω}
  (h_eq_alg : p.1.ms = q.1.ms)
  (h_eq_mea : ∀ E, MeasurableSet[p.1.ms] E → p.1.μ E = q.1.μ E)
  : p = q := by
  rcases p with ⟨a, _⟩
  rcases q with ⟨b, _⟩
  have : a = b := MeasureOnSpace.ext_ms h_eq_alg h_eq_mea
  aesop

open ENNReal in
@[simp, grind .]
lemma PSpace.measure_ne_top
  {m : PSpace Ω} {u : Set Ω}
  : m.1.μ u ≠ (⊤ : ℝ≥0∞) := by
  apply ne_of_lt
  have h₁ : m.1.μ Set.univ = 1 := m.2.measure_univ
  have h₂ : u ⊆ Set.univ := by aesop
  have h₃ : m.1.μ u ≤ m.1.μ Set.univ := measure_mono h₂
  exact lt_of_le_of_lt (b := 1) (by aesop) (by aesop)

set_option maxHeartbeats 10000000
theorem PSpace.uniqueness
  {r r' p q : PSpace Ω}
  (h₁ : r =ᵢ p ⊕ᵢ q) (h₂ : r' =ᵢ p ⊕ᵢ q)
  : r = r' := by
  apply PSpace.ext_ms (h₁.1 ▸ h₂.1 ▸ rfl)
  -- Applying the π-λ theorem: the σ-algebra is by definition a λ-system,
  -- so we just need to show that the measures agree on a generating π-system
  rw [PSpace.isIndependentProduct_def] at h₁ h₂
  apply MeasurableSpace.induction_on_inter
  · exact @MeasureOnSpace.isPiSystem_generator Ω p.1 q.1
  · simp
  · intro t ht
    obtain ⟨u, v, rfl, hu, hv⟩ := exists_inter_measurableSet_of_mem_generator ht
    grind
  · intros t h h_eq
    have r_r'_mes : r.1.ms = r'.1.ms := by rw [h₁.1, h₂.1]
    have : @MeasurableSet Ω r'.1.ms t := by
      rw [←r_r'_mes]; exact h
    let f (n : ℕ) : Set Ω :=
      if n = 0
      then t
      else if n = 1 then tᶜ else ∅
    have f_prop₁ : (⋃ i, f i) = Set.univ := by
        have h₁ : t ⊆ ⋃ i, f i := by
          simp [f]
          intros x h
          simp only [Set.mem_iUnion]
          use 0
          simpa using h
        have h₂ : tᶜ ⊆ ⋃ i, f i := by
          simp [f]
          intros x h
          simp only [Set.mem_iUnion]
          use 1
          simpa using h
        have : t ∪ tᶜ ⊆ ⋃ i, f i := by
          exact Set.union_subset h₁ h₂
        simpa using this
    have f_prop₂ : ∑' i, r.1.μ (f i) =  r.1.μ t +  r.1.μ tᶜ := by
      simp only [f]
      rw [tsum_eq_sum (s := ({0, 1} : Finset ℕ)) (fun b hb => by
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hb
        simp [hb.1, hb.2])]
      rw [Finset.sum_pair (by decide : (0 : ℕ) ≠ 1)]
      simp
    have f_prop₂' : ∑' i, r'.1.μ (f i) =  r'.1.μ t +  r'.1.μ tᶜ := by
      simp only [f]
      rw [tsum_eq_sum (s := ({0, 1} : Finset ℕ)) (fun b hb => by
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hb
        simp [hb.1, hb.2])]
      rw [Finset.sum_pair (by decide : (0 : ℕ) ≠ 1)]
      simp
    have h₁ : r.1.μ tᶜ = 1 - r.1.μ t := by
      have h' :=
        @r.1.2.m_iUnion f
          (by
            intros i
            by_cases h : i = 0
            · simp only [h, ↓reduceIte, f]; assumption
            · by_cases h' : i = 1
              · simp only [h', one_ne_zero, ↓reduceIte, MeasurableSet.compl_iff, f]; assumption
              · simp [f, h, h']
          )
          (by
            unfold Pairwise Disjoint Function.onFun
            intros i j h x
            simp only [Set.bot_eq_empty, Set.subset_empty_iff, f]
            split_ifs with cond cond' cond'' <;> grind
          )
      simp only [f_prop₁, f_prop₂, Measure.coe_toOuterMeasure, r.2.measure_univ] at h'
      have h' := h'.symm
      exact ENNReal.eq_sub_of_add_eq' (by simp) (by simpa [add_comm] using h')
    have h₂ : r'.1.μ tᶜ = 1 - r'.1.μ t := by
      have h' :=
        @r'.1.2.m_iUnion f
          (by
            intros i
            by_cases h : i = 0
            · simp only [h, ↓reduceIte, f]; assumption
            · by_cases h' : i = 1
              · simp only [h', one_ne_zero, ↓reduceIte, MeasurableSet.compl_iff, f]; assumption
              · simp [f, h, h']
          )
          (by
            unfold Pairwise Disjoint Function.onFun
            intros i j h x
            simp only [Set.bot_eq_empty, Set.subset_empty_iff, f]
            split_ifs with cond cond' cond'' <;> grind
          )
      simp only [f_prop₁, f_prop₂', Measure.coe_toOuterMeasure, r'.2.measure_univ] at h'
      have h' := h'.symm
      exact ENNReal.eq_sub_of_add_eq' (by simp) (by simpa [add_comm] using h')
    rw [h₁, h₂, h_eq]
  · intro us disjoint hus prf
    have h_sum1 : r.1.μ (⋃ i, us i) = ∑' i, r.1.μ (us i) :=
      @Measure.m_iUnion (α := Ω) (f := us) r.1.ms r.1.μ hus disjoint
    have : r'.1.μ (⋃ i, us i) = ∑' i, r'.1.μ (us i) :=
      @Measure.m_iUnion (α := Ω) (f := us) r'.1.ms r'.1.μ (by grind) disjoint
    aesop
  · aesop (add simp MeasureOnSpace.generateFrom_generator_eq_sum)

end Uniqueness

section Trim


/-- The `trim` operation takes a MeasureOnSpace `p` and a sub-σ-algebra
    f, and produces a MeasureOnSpace where the measure is restricted to
    f. -/
@[simp]
def MeasureOnSpace.trim
  {p : MeasureOnSpace Ω} {f : MeasurableSpace Ω} (h : f ≤ p.ms)
  : MeasureOnSpace Ω := {
  ms := f
  μ := p.μ.trim h
}

lemma MeasureOnSpace.trim_eq
  {p : MeasureOnSpace Ω} {f : MeasurableSpace Ω} (h : f ≤ p.ms)
  {u : Set Ω} (hu : MeasurableSet[f] u)
  : (p.trim h).μ u = p.μ u := by
  simp only [trim]
  unfold Measure.trim
  unfold_projs
  aesop

lemma _root_.Measure.trim_preserves_prob
  (f g : MeasurableSpace Ω)
  {μ : Measure[g] Ω}
  (hf : f ≤ g) (hp : IsProbabilityMeasure μ)
  : IsProbabilityMeasure (μ.trim hf) := by
  constructor
  unfold Measure.trim
  aesop

@[simp]
def PSpace.trim
  {p : PSpace Ω} {f : MeasurableSpace Ω} {h : f ≤ p.1.ms}
  : PSpace Ω := ⟨p.1.trim h, by
  simp only [MeasureOnSpace.trim]
  constructor
  have : (p.1.trim h).μ Set.univ = 1 := by
    have := (@Measure.trim_preserves_prob Ω f p.1.ms p.1.μ h p.2).1
    aesop
  aesop
⟩

end Trim

section PSpace.Identity

@[simp]
abbrev PSpace.ms (p : PSpace Ω) : MeasurableSpace Ω :=
  p.1.ms

@[simp]
abbrev PSpace.μ (p : PSpace Ω) : @Measure Ω (p.ms) :=
  p.1.μ

@[simp]
abbrev PSpace.isProbability (p : PSpace Ω) : IsProbabilityMeasure (p.μ) :=
  p.2

lemma dirac_is_prob [Inhabited Ω] : IsProbabilityMeasure (@Measure.dirac Ω ⊥ default) := by
  apply isProbabilityMeasure_iff.2
  simp

def PSpace.unit [Inhabited Ω] : PSpace Ω := ⟨{
  ms := ⊥
  μ := @Measure.dirac Ω ⊥ default
}, dirac_is_prob⟩

instance [Inhabited Ω] : One (PSpace Ω) where
  one := PSpace.unit

section UnitSpace

variable [Inhabited Ω]

/-! These are deliberately not `@[simp]`: making them global simp lemmas perturbs the
`PSp.one_le` proof below.  Use `attribute [local simp]` where they are wanted. -/

lemma PSpace.one_ms : (1 : PSpace Ω).ms = (⊥ : MeasurableSpace Ω) := rfl

lemma PSpace.one_measure_univ : (1 : PSpace Ω).μ Set.univ = 1 :=
  (1 : PSpace Ω).2.measure_univ

lemma PSpace.one_measure_empty : (1 : PSpace Ω).μ (∅ : Set Ω) = 0 := measure_empty

end UnitSpace

/-- A space whose every subset is measurable carries the discrete σ-algebra. -/
lemma PSpace.ms_eq_top_of_all {p : PSpace Ω} (h : ∀ S : Set Ω, MeasurableSet[p.ms] S) :
    p.ms = (⊤ : MeasurableSpace Ω) :=
  le_antisymm le_top (fun S _ => h S)

/-- Two *discrete* spaces on a countable carrier are equal as soon as they agree on
singletons.  This is the practical way to show a construction computes a given
distribution: check the σ-algebra is discrete, then check point masses. -/
lemma PSpace.eq_of_singletons [Countable Ω] {p q : PSpace Ω}
    (hp : p.ms = (⊤ : MeasurableSpace Ω)) (hq : q.ms = (⊤ : MeasurableSpace Ω))
    (h : ∀ a, p.μ {a} = q.μ {a}) : p = q := by
  obtain ⟨⟨mp, μp⟩, hpp⟩ := p
  obtain ⟨⟨mq, μq⟩, hpq⟩ := q
  simp only [PSpace.ms] at hp hq
  subst hp; subst hq
  let _ : MeasurableSpace Ω := ⊤
  have : MeasurableSingletonClass Ω := ⟨fun _ => trivial⟩
  have hμ : μp = μq := (MeasureTheory.Measure.ext_iff_singleton ..).mpr (fun a => h a)
  refine PSpace.ext_ms rfl (fun E _ => ?_)
  show μp E = μq E
  rw [hμ]

lemma empty_sigma_algebra_is_identity [Inhabited Ω] (m : MeasureOnSpace Ω)
  : m.ms = MeasurableSpace.generateFrom (unit.1.ms.MeasurableSet' ∪ m.ms.MeasurableSet') := by
  let a : Set (Set Ω) := m.ms.MeasurableSet'
  let b : Set (Set Ω) := unit.1.ms.MeasurableSet'
  have h : a = b ∪ a := by
    ext u
    constructor
    grind
    simp only [Set.mem_union]
    intro h
    rcases h with h1 | h2
    apply MeasurableSet.measurableSet_bot_induction
    unfold a
    apply MeasurableSpace.measurableSet_empty
    have : Set.univ ∈ a := by
      unfold a
      apply MeasurableSet.univ
    assumption
    assumption
    assumption
  rw [← h]
  exact (@MeasurableSpace.generateFrom_measurableSet Ω m.ms).symm

theorem indepenendentProduct_identity [Inhabited Ω] {p : PSpace Ω}
  : p =ᵢ unit ⊕ᵢ p := by
  unfold isIndependentProduct
  constructor
  exact (empty_sigma_algebra_is_identity p.1).trans
    (MeasurableSpace.sup_eq_generateFrom _ _).symm
  let μ := p.μ
  let ν : Measure[⊥] Ω := unit.μ
  intro u h_u v h_v
  let P u := μ (u ∩ v) = unit.μ u * μ v
  apply MeasurableSet.measurableSet_bot_induction (P := P)
  unfold P
  simp
  unfold P
  simp_all
  exact h_u

end PSpace.Identity

section PSpace.Commutativity

theorem independentProduct_comm [Inhabited Ω] {r p q : PSpace Ω}
  (h : r =ᵢ p ⊕ᵢ q)
  : r =ᵢ q ⊕ᵢ p := by
  constructor
  have h₁ : p.ms ⊔ q.ms
    = q.ms ⊔ p.ms := by
    apply sup_comm
  have : r.ms = p.ms ⊔ q.ms := h.1
  grind
  intro u hu v hv
  let μ := r.1.μ
  let μ₁ := q.1.μ
  let μ₂ := p.1.μ
  have : r.μ (v ∩ u) = p.μ v * q.μ u := h.2 v hv u hu
  grind

end PSpace.Commutativity

section PSpace.Associativity

-- Recall the definiton of partial associativity (Kleene equality):
--  (a * b) * c ≃ a * (b * c) means:
-- If (a * b) and (a * b) * c are defined then
--   1. (b * c) and a * (b * c) are defined
--   2. (a * b) * c = a * (b * c)
-- The above definition suffices because we proved commutativity
theorem independentProduct_assoc [Inhabited Ω] {pq p q s r : PSpace Ω}
  (h_pq : pq =ᵢ p ⊕ᵢ q)
  (h_pq_r : s =ᵢ pq ⊕ᵢ r)
  : ∃ qr, qr =ᵢ q ⊕ᵢ r ∧ s =ᵢ p ⊕ᵢ qr
  := by
  let qr_ms : MeasurableSpace Ω := q.1.ms ⊔ r.1.ms
  have h : qr_ms <= s.1.ms := by
    unfold qr_ms
    rw [h_pq_r.1, h_pq.1]
    have : q.1.ms ⊔ r.1.ms ≤ p.1.ms ⊔ (q.1.ms ⊔ r.1.ms) := by
      apply le_sup_right
    rw [sup_assoc]
    aesop
  let qr : PSpace Ω := @s.trim Ω qr_ms h
  have h_qr : qr =ᵢ q ⊕ᵢ r := by
    constructor
    aesop
    intro u hu v hv
    have hou : MeasurableSet[pq.1.ms] (Set.univ ∩ u) := by
      simp
      have h : pq.1.ms = p.1.ms ⊔ q.1.ms := h_pq.1
      rw [h]
      have h₂ : u ∈ generator p.1 q.1 := mem_generator_r hu
      apply @mem_generator_imp_mem_sum Ω p.1 q.1 u h₂
    have h := h_pq_r.2 (Set.univ ∩ u) hou v hv
    have h₁ : pq.1.μ (Set.univ ∩ u) = q.1.μ u := by
      have := h_pq.2 Set.univ MeasurableSet.univ u hu
      have : p.1.μ Set.univ = 1 := p.2.measure_univ
      aesop
    have h₂ : s.1.μ (Set.univ ∩ u ∩ v) = qr.1.μ (u ∩ v) := by
      have := h_pq_r.2 (Set.univ ∩ u) hou v hv
      have h₃ : s.1.μ (Set.univ ∩ u ∩ v) = pq.1.μ (Set.univ ∩ u) * r.1.μ v := by
        grind
      have h₄ : pq.1.μ (Set.univ ∩ u) = p.1.μ Set.univ * q.1.μ u :=
        h_pq.2 Set.univ MeasurableSet.univ u hu
      rw [h₄] at h₃
      have h₅ : p.1.μ Set.univ = 1 := p.2.measure_univ
      rw [h₅] at h₃
      unfold qr
      apply Eq.symm
      have h₇ : MeasurableSet[q.1.ms ⊔ r.1.ms] (u ∩ v) := by
        apply mem_generator_imp_mem_sum
        apply inter_mem_generator hu hv
      have h₈ : q.1.ms ⊔ r.1.ms ≤ s.1.ms := by
        rw [h_pq_r.1, h_pq.1, sup_assoc]
        apply le_sup_right
      have := @s.1.trim_eq Ω (q.1.ms ⊔ r.1.ms) h₈ (u ∩ v) h₇
      have : s.1.μ (Set.univ ∩ u ∩ v) = s.1.μ (u ∩ v) := by
        have : Set.univ ∩ u ∩ v = u ∩ v := by grind
        aesop
      aesop
    aesop
  use qr
  constructor
  assumption
  have h_p_qr : s =ᵢ p ⊕ᵢ qr := by
    constructor
    rw [h_pq_r.1, h_pq.1, h_qr.1]
    apply sup_assoc p.1.ms q.1.ms r.1.ms
    have h :
      ∀ u (hu : MeasurableSet[p.1.ms] u)
        vw (hvw : MeasurableSet[q.1.ms ⊔ r.1.ms] vw),
      s.1.μ (u ∩ vw) = p.1.μ u * qr.1.μ vw
    := by
      intro u hu
      apply MeasurableSpace.induction_on_inter
      apply MeasureOnSpace.isPiSystem_generator (p := q.1) (q := r.1)
      simp
      intro t ht
      obtain ⟨v, w, rfl, hv, hw⟩ := exists_inter_measurableSet_of_mem_generator ht
      have h : u ∩ (v ∩ w) = (u ∩ v) ∩ w := by grind
      rw [h, h_pq_r.2, h_pq.2, h_qr.2]
      grind
      aesop
      aesop
      aesop
      aesop
      have := @mem_sup_inter Ω p.1.ms q.1.ms u v hu hv
      have : p.1.ms ⊔ q.1.ms = pq.1.ms := by rw [h_pq.1]
      rw [←this]
      assumption
      exact hw
      {
        intro t ht h
        have : u ∩ tᶜ = u \ (u ∩ t) := by aesop
        have : s.1.μ (u \ (u ∩ t)) = s.1.μ u - s.1.μ (u ∩ t) := by
          have : s.1.μ Set.univ = 1 := s.2.measure_univ
          apply @measure_sdiff Ω s.1.ms s.1.μ u (u ∩ t)
          grind
          have : MeasurableSet[s.1.ms] (u ∩ t) := by
            rw [h_pq_r.1, h_pq.1, sup_assoc]
            apply mem_sup_inter
            exact hu
            exact ht
          aesop
          apply s.measure_ne_top
        have : s.1.μ u = p.1.μ u := by
          have : u = (u ∩ Set.univ) ∩ Set.univ := by aesop
          have h₁ : s.1.μ u = s.1.μ ((u ∩ Set.univ) ∩ Set.univ) := by grind
          have h₂ : q.1.μ Set.univ = 1 := q.2.measure_univ
          have h₃ : r.1.μ Set.univ = 1 := r.2.measure_univ
          rw [h₁, h_pq_r.2, h_pq.2, h₂, h₃]
          simp
          exact hu
          apply MeasurableSet.univ
          have h₄ := @mem_sup_inter Ω p.1.ms q.1.ms u Set.univ hu MeasurableSet.univ
          rw [h_pq.1]
          exact h₄
          apply MeasurableSet.univ
        have : p.1.μ u - p.1.μ u * qr.1.μ t = p.1.μ u * (1 - qr.1.μ t) := by
          have := @ENNReal.mul_sub (p.1.μ u) 1 (qr.1.μ t)
          aesop
        have h₃ : qr.1.μ tᶜ = 1 - qr.1.μ t := by
          have h := @measure_compl Ω qr.1.ms (μ := qr.1.μ) (s := t) ht
          have : qr.1.μ t ≠ (⊤ : ENNReal) := qr.measure_ne_top
          have := qr.2.measure_univ
          aesop
        calc
              s.1.μ (u ∩ tᶜ)
          _ = s.1.μ (u \ (u ∩ t)) := by aesop
          _ = s.1.μ u - s.1.μ (u ∩ t) := by aesop
          _ = s.1.μ u - p.1.μ u * qr.1.μ t := by aesop
          _ = p.1.μ u - p.1.μ u * qr.1.μ t := by aesop
          _ = p.1.μ u * (1 - qr.1.μ t) := by aesop
          _ = p.1.μ u * qr.1.μ tᶜ := by aesop
      }
      {
        intro us hdis hus ih
        have : u ∩ ⋃ i, us i = ⋃ i, u ∩ us i := by aesop
        have : s.1.μ (⋃ i, u ∩ us i) = ∑' i, s.1.μ (u ∩ us i) := by
          have hus' : ∀ i, MeasurableSet[s.1.ms] (u ∩ us i) := by
            intro i
            have hus_i := hus i
            rw [h_pq_r.1, h_pq.1, sup_assoc]
            apply mem_sup_inter
            exact hu
            exact hus_i
          have h : Pairwise (Function.onFun Disjoint (fun k ↦ u ∩ us k)) := by
            intro k l p
            have h₁ := hdis p
            have h₂ : Disjoint (us k) (us l) := by apply h₁
            have h₃ := @Disjoint.inter_left' Ω (us k) (us l) u h₂
            have := @Disjoint.inter_right' Ω (u ∩ us k) (us l) u h₃
            aesop
          have := @s.1.μ.m_iUnion (fun i ↦ u ∩ us i) hus' h
          aesop
        have : ∑' i, s.1.μ (u ∩ us i) = ∑' i, p.1.μ u * qr.1.μ (us i) := by
          have : ∀ i, s.1.μ (u ∩ us i) = p.1.μ u * qr.1.μ (us i) := by
            intro i
            have := ih i
            aesop
          aesop
        have : ∑' i, p.1.μ u * qr.1.μ (us i) = p.1.μ u *  ∑' i, qr.1.μ (us i) := by
          apply ENNReal.tsum_mul_left
        have : p.1.μ u *  ∑' i, qr.1.μ (us i) = p.1.μ u * qr.1.μ (⋃ i, us i) := by
          congr
          have := @qr.1.μ.m_iUnion us hus hdis
          exact this.symm
        calc
              s.1.μ (u ∩ ⋃ i, us i)
          _ = s.1.μ (⋃ i, u ∩ us i) := by aesop
          _ = ∑' i, s.1.μ (u ∩ us i) := by aesop
          _ = ∑' i, p.1.μ u * qr.1.μ (us i) := by aesop
          _ = p.1.μ u *  ∑' i, qr.1.μ (us i) := by aesop
          _ = p.1.μ u * qr.1.μ (⋃ i, us i) := by aesop
      }
      exact (@MeasurableSpace.generateFrom_supGenerator_eq_sup Ω q.1.ms r.1.ms).symm
    aesop
  assumption

theorem independentProduct_assoc_right [Inhabited Ω] {p q r qr s : PSpace Ω}
  (h_qr : qr =ᵢ q ⊕ᵢ r)
  (h_p_qr : s =ᵢ p ⊕ᵢ qr)
  : ∃ pq, pq =ᵢ p ⊕ᵢ q ∧ s =ᵢ pq ⊕ᵢ r := by
  have h₁ : qr =ᵢ r ⊕ᵢ q := by
    apply @independentProduct_comm Ω _ qr q r h_qr
  have h₂ : s =ᵢ qr ⊕ᵢ p := by
    apply @independentProduct_comm Ω _ s p qr h_p_qr
  have h₃ := @independentProduct_assoc Ω _ qr r q s p h₁ h₂
  obtain ⟨qp, h₃⟩ := h₃
  have h₄ : qp =ᵢ p ⊕ᵢ q := by
    have : qp =ᵢ p ⊕ᵢ q := by
      have := @independentProduct_comm Ω _ qp q p
      aesop
    have : s =ᵢ r ⊕ᵢ qp := by
      have := h₃.2
      aesop
    aesop
  have h₅ : s =ᵢ qp ⊕ᵢ r := by
    have := @independentProduct_comm Ω _
    aesop
  aesop

end PSpace.Associativity

section PSpace.Auxiliary

/-- Two `PSpace`s are dependent if the independent combination does
    not exist -/
@[simp, grind]
def PSpace.dependent (p q : PSpace Ω) :=
  ¬∃r : PSpace Ω, r =ᵢ p ⊕ᵢ q

theorem PSpace.dependent_symm [Inhabited Ω] {p q : PSpace Ω}
  (h : p.dependent q) : q.dependent p := by
  simp_all
  intro x hx
  have : x =ᵢ p ⊕ᵢ q := by apply independentProduct_comm hx
  have := h x (by aesop)
  contradiction

theorem PSpace.dependent_mono_left {p q r qr : PSpace Ω}
  (hinc : p.dependent q) (hqr : qr =ᵢ q ⊕ᵢ r)
  : p.dependent qr := by
  simp_all
  intro x hx
  have : ∃ y : PSpace Ω, y =ᵢ p ⊕ᵢ q := by
    let pqms := p.1.ms ⊔ q.1.ms
    have hmsle : pqms ≤ x.1.ms := by
      unfold pqms
      have := @sup_comm (MeasurableSpace Ω) _
      have h₁ := @le_sup_right (MeasurableSpace Ω) _
      rw [hx.1, hqr.1]
      have h₂ : p.1.ms ⊔ (q.1.ms ⊔ r.1.ms) = (p.1.ms ⊔ q.1.ms) ⊔ (r.1.ms) := by
        have := @sup_assoc (MeasurableSpace Ω) _
        aesop
      rw [h₂]
      grind
    let x' := @x.trim Ω pqms (by aesop)
    have : x' =ᵢ p ⊕ᵢ q := by
      unfold PSpace.isIndependentProduct
      constructor
      aesop
      intro u hu v hv
      have : x'.1.μ ((u ∩ v) ∩ Set.univ) = p.1.μ u * qr.1.μ (v ∩ Set.univ) := by
        have h₁ : v ∩ Set.univ = v := by grind
        have h₂ : (u ∩ v) ∩ Set.univ = u ∩ (v ∩ Set.univ) := by grind
        rw [h₂, h₁]
        have : MeasurableSet[pqms] (u ∩ v) := by
          unfold pqms
          have : MeasurableSet[pqms] u := by apply @mem_sup_l Ω p.1.ms q.1.ms u hu
          have : MeasurableSet[pqms] v := by apply @mem_sup_r Ω p.1.ms q.1.ms v hv
          have := @MeasurableSet.inter Ω pqms u v (by aesop) (by aesop)
          assumption
        have h₃ := @x.1.trim_eq Ω pqms hmsle (u ∩ v) (by aesop)
        have : x.1.μ (u ∩ v) = p.1.μ u * qr.1.μ v := by
          have hple : p.1.ms ≤ x.1.ms := by rw [hx.1]; exact le_sup_left
          rw [hx.2]
          aesop
          have := @mem_sup_l Ω q.1.ms r.1.ms v hv
          rw [hqr.1]
          assumption
        have : x'.1.μ (u ∩ v) = x.1.μ (u ∩ v) := by aesop
        grind
      have : p.1.μ u * qr.1.μ (v ∩ Set.univ) = p.1.μ u * (q.1.μ v * r.1.μ Set.univ) := by
        rw [hqr.2]
        exact hv
        aesop
      calc
          x'.1.μ (u ∩ v)
      _ = x'.1.μ ((u ∩ v) ∩ Set.univ) := by aesop
      _ = p.1.μ u * qr.1.μ (v ∩ Set.univ) := by aesop
      _ = p.1.μ u * (q.1.μ v * r.1.μ Set.univ) := by aesop
      _ = p.1.μ u * (q.1.μ v * 1) := by have := r.2.measure_univ; aesop
      _ = p.1.μ u * q.1.μ v := by aesop
    exact ⟨x', this⟩
  aesop

lemma PSpace.measure_compl {p : PSpace Ω} {u : Set Ω}
  (h : MeasurableSet[p.1.ms] u)
  : p.1.μ uᶜ = 1 - p.1.μ u := by
  have : p.1.μ Set.univ = 1 := p.2.measure_univ
  rw [← this]
  apply MeasureTheory.measure_compl
  exact h
  aesop

theorem PSpace.functoriality [Inhabited Ω] {p q a pa qa : PSpace Ω}
  (hpa : pa =ᵢ p ⊕ᵢ a)
  (hqa : qa =ᵢ q ⊕ᵢ a)
  (hlt : p ≤ q)
  : pa ≤ qa := by
  have hms : pa.1.ms ≤ qa.1.ms := by
    have := sup_le_sup_right hlt.1 a.1.ms
    have := hpa.1
    have := hqa.1
    aesop
  constructor; aesop
  have := hlt.2
  have : ∀ {u : Set Ω}, MeasurableSet[pa.1.ms] u → pa.1.μ u = qa.1.μ u := by
    apply MeasurableSpace.induction_on_inter
    · exact @MeasureOnSpace.isPiSystem_generator Ω p.1 a.1
    · aesop
    · intro t ht
      obtain ⟨u, v, h, hu, hv⟩ :=
        @exists_inter_measurableSet_of_mem_supGenerator Ω p.1.ms a.1.ms t ht
      rw [h, hpa.2, hqa.2]
      have : p.1.μ u = q.1.μ u := by
        have : p.1.μ = q.1.μ.cast p.1.ms := hlt.2
        rw [this]
        apply Measure.le_preserves_measure
        exact hlt.1
        exact hu
      aesop
      exact hlt.1 u hu; exact hv; exact hu; exact hv
    · intro t ht h
      calc
            pa.1.μ tᶜ
        _ = 1 - pa.1.μ t := by
          have := @PSpace.measure_compl Ω pa t (by
            have := @MeasurableSet.compl Ω t pa.1.ms ht; aesop)
          aesop
        _ = 1 - qa.1.μ t := by aesop
        _ = qa.1.μ tᶜ := by
          have := @PSpace.measure_compl Ω qa t
          have := hms t ht
          aesop
    · intro us hdis hus heq
      calc
            pa.1.μ (⋃ i, us i)
        _ = ∑' i, pa.1.μ (us i) := measure_iUnion hdis hus
        _ = ∑' i, qa.1.μ (us i) := by aesop
        _ = qa.1.μ (⋃ i, us i) := Eq.symm (measure_iUnion hdis fun i => hms (us i) (hus i))
    · have := @MeasurableSpace.generateFrom_supGenerator_eq_sup Ω p.1.ms a.1.ms
      have : p.1.ms.supGenerator a.1.ms = generator p.1 a.1 := by rfl
      rw [hpa.1]
      aesop
  apply @Measure.ext Ω pa.1.ms
  intro u hu
  have := @Measure.le_preserves_measure Ω pa.1.ms qa.1.ms hms qa.1.μ u hu
  aesop

lemma PSpace.dependent_mono_right [Inhabited Ω] {p q r pq : PSpace Ω}
  (hinc : q.dependent r) (hpq : pq =ᵢ p ⊕ᵢ q)
  : pq.dependent r := by
  have : r.dependent q := by apply PSpace.dependent_symm (by aesop)
  have : pq =ᵢ q ⊕ᵢ p := by apply independentProduct_comm (by aesop)
  have := @PSpace.dependent_mono_left Ω r q (by aesop) pq (by aesop) (by aesop)
  have : pq.dependent r := by
    apply PSpace.dependent_symm (by aesop)
  assumption

lemma PSpace.le_of_isIndependentProduct_left
  [Inhabited Ω] {x y xy : PSpace Ω} (h : xy =ᵢ x ⊕ᵢ y)
  : x ≤ xy := by
  refine ⟨?_, ?_⟩
  · rw [h.1]; apply le_sup_left
  · have hms : x.1.ms ≤ xy.1.ms := by rw [h.1]; apply le_sup_left
    apply @Measure.ext Ω x.1.ms
    intro u hu
    have hcast : xy.1.μ.cast x.1.ms u = xy.1.μ u :=
      @Measure.le_preserves_measure Ω x.1.ms xy.1.ms hms xy.1.μ u hu
    rw [hcast]
    have h2 : xy.1.μ (u ∩ Set.univ) = x.1.μ u * y.1.μ Set.univ :=
      h.2 u hu Set.univ MeasurableSet.univ
    have h3 : u ∩ Set.univ = u := by simp
    have h4 : y.1.μ Set.univ = 1 := y.2.measure_univ
    rw [h3, h4, mul_one] at h2
    exact h2.symm

lemma PSpace.le_of_isIndependentProduct_right
  [Inhabited Ω] {x y xy : PSpace Ω} (h : xy =ᵢ y ⊕ᵢ x)
  : x ≤ xy := by
  refine ⟨?_, ?_⟩
  · rw [h.1]; apply le_sup_right
  · have hms : x.1.ms ≤ xy.1.ms := by rw [h.1]; apply le_sup_right
    apply @Measure.ext Ω x.1.ms
    intro u hu
    have hcast : xy.1.μ.cast x.1.ms u = xy.1.μ u :=
      @Measure.le_preserves_measure Ω x.1.ms xy.1.ms hms xy.1.μ u hu
    rw [hcast]
    have h2 : xy.1.μ (Set.univ ∩ u) = y.1.μ Set.univ * x.1.μ u :=
      h.2 Set.univ MeasurableSet.univ u hu
    have h3 : Set.univ ∩ u = u := by simp
    have h4 : y.1.μ Set.univ = 1 := y.2.measure_univ
    rw [h3, h4, one_mul] at h2
    exact h2.symm

end PSpace.Auxiliary

section PSp

set_option maxHeartbeats 100000000 in
/--
  Note: the patterns below are deliberately *non-overlapping*. Writing the
  second case as `| _, none => none` makes Lean build a match splitter, which
  has to unify through the `WithTop`/`Option` wrapper of `PSp` and diverges, so
  equation-lemma generation (and hence `@[simp, grind]`) hits a deterministic
  timeout.
-/
@[simp, grind]
def PSp.mul [Inhabited Ω] (p q : PSp Ω) : PSp Ω :=
  match p, q with
  | none, _ => none
  | some _, none => none
  | some p, some q => by
    by_cases h : ∃ s, s =ᵢ p ⊕ᵢ q
    exact (some h.choose)
    exact none

@[simp]
def PSp.unit [Inhabited Ω] : PSp Ω :=
  some PSpace.unit

instance [Inhabited Ω] : One (PSp Ω) where
  one := PSp.unit

instance [Inhabited Ω] : Mul (PSp Ω) where
  mul := PSp.mul

/-- an inversion lemma extracting the property of independent products in mul -/
lemma PSp.mul_inversion [Inhabited Ω] {x y xy : PSpace Ω}
  (h : PSp.mul (some x) (some y) = some xy)
  : xy =ᵢ x ⊕ᵢ y := by
  simp_all
  by_cases h₁ : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ y
  simp_all
  have : h₁.choose = xy := by grind
  grind
  simp_all

private lemma PSp.mul_of_exists [Inhabited Ω] {x y : PSpace Ω} (h : ∃ s, s =ᵢ x ⊕ᵢ y)
  : PSp.mul (some x) (some y) = some h.choose := by
  simp [h]
  rfl

private lemma PSp.mul_of_dependent [Inhabited Ω] {x y : PSpace Ω} (h : x.dependent y)
  : PSp.mul (some x) (some y) = none := by
  simp only [PSpace.dependent] at h
  simp [h]
  rfl

private lemma PSp.dependent_of_mul_eq_none [Inhabited Ω] {x y : PSpace Ω}
  (h : PSp.mul (some x) (some y) = none) : x.dependent y := by
  rintro ⟨s, hs⟩
  rw [PSp.mul_of_exists ⟨s, hs⟩] at h
  cases h

lemma mul_respect_independentProduct [Inhabited Ω] {x y xy : PSpace Ω}
  (h : xy =ᵢ x ⊕ᵢ y) : PSp.mul (some x) (some y) = some xy := by
  cases h₁ : PSp.mul (some x) (some y) with
  | none =>
    exact absurd ⟨xy, h⟩ (PSp.dependent_of_mul_eq_none h₁)
  | some xy' =>
    have : xy' =ᵢ x ⊕ᵢ y := by
      apply PSp.mul_inversion
      exact h₁
    have := @PSpace.uniqueness Ω xy xy' x y h (by aesop)
    aesop

theorem PSp.mul_idem [Inhabited Ω] {p : PSp Ω} : PSp.unit.mul p = p := by
  cases h : p with
  | none => aesop
  | some x =>
    simp_all
    by_cases h : ∃ s : PSpace Ω, s =ᵢ PSpace.unit ⊕ᵢ x
    · have := @indepenendentProduct_identity Ω _
      have h₁ : h.choose = x :=
        @PSpace.uniqueness Ω h.choose x (PSpace.unit) x h.choose_spec (by aesop)
      aesop
    · have h₃ : (∃ s : PSpace Ω, s =ᵢ PSpace.unit ⊕ᵢ x) := by
        use x
        have := @indepenendentProduct_identity Ω _
        aesop
      contradiction

theorem PSp.mul_comm [Inhabited Ω] {p q : PSp Ω} : p.mul q = q.mul p :=
  match p, q with
  | none, q => by cases q <;> rfl
  | p, none => by cases p <;> rfl
  | some x, some y => by
    simp
    by_cases h : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ y
    · have h₁ : h.choose =ᵢ y ⊕ᵢ x := by
        apply independentProduct_comm; grind
      have h₂ : ∃ s' : PSpace Ω, s' =ᵢ y ⊕ᵢ x := by use h.choose
      simp_all
      congr
      ext z
      constructor
      apply independentProduct_comm
      apply independentProduct_comm
    · have h' : ¬∃ s : PSpace Ω, s =ᵢ y ⊕ᵢ x :=
        fun ⟨s, hs⟩ ↦ h ⟨s, independentProduct_comm hs⟩
      simp [h, h']
      rfl

lemma PSp.le_of_mul_left
  [Inhabited Ω] {a b : PSp Ω}
  : a ≤ a * b := by
  cases a with
  | none =>
    cases b with
    | none => exact le_refl _
    | some y => exact le_refl _
  | some x =>
    cases b with
    | none => exact le_top
    | some y =>
      show (↑x : PSp Ω) ≤ ↑x * ↑y
      by_cases h : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ y
      · have hmul : (↑x : PSp Ω) * ↑y = ↑h.choose := by
          change PSp.mul (some x) (some y) = some h.choose
          simp [h]
          rfl
        rw [hmul]
        exact WithTop.coe_le_coe.2
          (PSpace.le_of_isIndependentProduct_left h.choose_spec)
      · have hmul : (↑x : PSp Ω) * ↑y = (⊤ : PSp Ω) := by
          change PSp.mul (some x) (some y) = (⊤ : PSp Ω)
          simp [h]; rfl
        rw [hmul]
        exact le_top

lemma PSp.le_of_mul_right
  [Inhabited Ω] {a b : PSp Ω}
  : a ≤ b * a := by
  have : b * a = a * b := PSp.mul_comm
  rw [this]
  apply PSp.le_of_mul_left

lemma PSp.some_mono
  [Inhabited Ω] {a b : PSpace Ω}
  (h : (some a : PSp Ω) = (some b : PSp Ω))
  : a = b := by
  simp_all only [Option.some.injEq]

lemma PSp.inversion [Inhabited Ω] {p : PSp Ω}
  (h : p ≠ (⊤ : PSp Ω))
  : ∃ x, p = some x := by
  cases p with
  | none => contradiction
  | some x => use x

theorem PSp.mul_assoc [Inhabited Ω] {p q r : PSp Ω}
  : (p.mul q).mul r = p.mul (q.mul r) := by
  cases h₁ : p with
  | none => aesop | some x => cases h₂ : q with
  | none => aesop | some y => cases h₃ : r with
  | none => aesop | some z =>
  cases h₄ : mul (some x) (some y) with
  | none =>
    have h₆ : x.dependent y := PSp.dependent_of_mul_eq_none h₄
    by_cases h' : ∃ s : PSpace Ω, s =ᵢ y ⊕ᵢ z
    · have := @PSpace.dependent_mono_left Ω x y z h'.choose h₆ h'.choose_spec
      rw [PSp.mul_of_exists h', PSp.mul_of_dependent this]
      rfl
    · rw [PSp.mul_of_dependent h']
      rfl
  | some xy =>
  cases h₅ : mul (some y) (some z) with
  | none =>
    have h₇ : y.dependent z := PSp.dependent_of_mul_eq_none h₅
    have := @PSpace.dependent_mono_right Ω _ x y z xy h₇ (PSp.mul_inversion h₄)
    rw [PSp.mul_of_dependent this]
    rfl
  | some yz =>
    have h₈ : xy =ᵢ x ⊕ᵢ y := by
      apply @PSp.mul_inversion Ω _ x y xy h₄
    cases h₉ : mul (some xy) (some z) with
    | none =>
      by_contra h
      have hcon : ∃ x_yz : PSpace Ω, mul (some x) (some yz) = some x_yz := by
        have := @PSp.inversion Ω _ (mul (some x) (some yz)) (fun h' ↦ h h'.symm)
        grind
      obtain ⟨x_yz, hcon⟩ := hcon
      have : x_yz =ᵢ x ⊕ᵢ yz := by
        apply PSp.mul_inversion
        grind
      have : x_yz =ᵢ xy ⊕ᵢ z := by
        have : yz =ᵢ y ⊕ᵢ z := by
          apply PSp.mul_inversion
          assumption
        have hgoal := @independentProduct_assoc_right Ω _ x y z yz x_yz (by aesop) (by aesop)
        have : hgoal.choose = xy := by
          have hxy : xy =ᵢ x ⊕ᵢ y := by
            apply PSp.mul_inversion
            assumption
          have := @PSpace.uniqueness Ω hgoal.choose xy x y (by grind) hxy
          assumption
        grind
      have : mul (some xy) (some z) = some x_yz := by
        apply mul_respect_independentProduct
        grind
      have : some x_yz = none := by aesop
      grind
    | some xy_z =>
      have h₁₀ : xy_z =ᵢ xy ⊕ᵢ z := by
        apply PSp.mul_inversion
        assumption
      have h_goal := @independentProduct_assoc Ω _ xy x y xy_z z h₈ h₁₀
      have h' : h_goal.choose = yz := by
        have h₁ : h_goal.choose =ᵢ y ⊕ᵢ z := by grind
        have h_yz : yz =ᵢ y ⊕ᵢ z := by
          apply PSp.mul_inversion
          assumption
        have := @PSpace.uniqueness Ω h_goal.choose yz y z h₁ h_yz
        assumption
      have := mul_respect_independentProduct (x := x) (y := yz) (xy := xy_z)
      grind

theorem PSp.mul_defined_imp_defined
  [Inhabited Ω] {p q : PSp Ω} (h : p.mul q ≠ (⊤ : PSp Ω))
  : p ≠ (⊤ : PSp Ω) :=
  match p, q with
  | none, _ => by aesop
  | _, none => by intro h₁; simp_all; contradiction
  | some x, some y => by aesop

instance [Inhabited Ω] : CommMonoid (PSp Ω) := {
  mul_assoc p q r := by apply PSp.mul_assoc
  mul_comm p q := by apply PSp.mul_comm
  one_mul a := PSp.mul_idem
  mul_one a := by
    calc
      a * 1
    _ = 1 * a := by apply PSp.mul_comm
    _ = a := by apply PSp.mul_idem
}

instance [Inhabited Ω] : PartialOrder (PSp Ω) := {
  le_antisymm := by
    intro p₁ p₂ h₁ h₂
    cases p₁ with
    | none => cases p₂ with
      | none => aesop
      | some q₂ => contradiction
    | some q₁ => cases p₂ with
      | none => contradiction
      | some q₂ =>
        have : q₁ ≤ q₂ := by grind
        have : q₂ ≤ q₁ := by grind
        have : q₁ = q₂ := by
          have := @le_antisymm (PSpace Ω) _ q₁ q₂
          aesop
        aesop
}

lemma PSp.ge_top_imp_top {p : PSp Ω} (h : (⊤ : PSp Ω) ≤ p) : p = (⊤ : PSp Ω) := by
  cases p; rfl; contradiction

lemma PSp.le_top' {p : PSp Ω} : p ≤ (⊤ : PSp Ω) := by
  apply le_top

lemma PSp.one_le [Inhabited Ω] {a : PSp Ω} : (1 : PSp Ω)  ≤ a := by
  rw [WithTop.le_def]
  rcases a with _ | b
  · exact Or.inl rfl
  · right
    use 1
    use b
    refine ⟨?_, rfl, rfl⟩
    refine ⟨?_, ?_⟩
    · unfold_projs
      intros s h
      have : s = ∅ ∨ s = Set.univ := MeasurableSpace.measurableSet_bot_iff.mp h
      rcases this with h' | h' <;> simp [h']
    · convert MeasureTheory.Measure.ext_iff.mpr _
      intros s h
      have : s = ∅ ∨ s = Set.univ := MeasurableSpace.measurableSet_bot_iff.mp h
      rcases this with h' | h' <;> simp [h']
      · have := @MeasureTheory.Measure.map_apply Ω Ω b.1.ms (1 : PSpace Ω).1.ms
        rw [this]
        · simp
        · unfold Measurable
          simp
          intros t h
          have : t = ∅ ∨ t = Set.univ := MeasurableSpace.measurableSet_bot_iff.mp h
          rcases this with h' | h' <;> simp [h']
        · simp

/-! ## Probability spaces as a resource algebra

Independent probability spaces compose: `PSp.mul` is the independent product, `1` is the
trivial space, and `⊤` is the undefined (invalid) element. -/

instance [Inhabited Ω] : Iris.OrderedUnitalResourceAlgebra (PSp Ω) := {
  valid x := x ≠ (⊤ : PSp Ω)
  valid_one := Ne.symm WithTop.top_ne_one
  elim := by
    intro a x y hxy
    show PSp.mul x a ≤ PSp.mul y a
    cases a with
    | none => cases x <;> cases y <;> exact le_refl _
    | some a =>
    cases y with
    | none => cases x <;> exact le_top
    | some y =>
    cases x with
    | none => exact absurd (PSp.ge_top_imp_top hxy) (by simp)
    | some x =>
    have hxy' : x ≤ y := WithTop.coe_le_coe.1 hxy
    by_cases h₁ : ∃ t : PSpace Ω, t =ᵢ y ⊕ᵢ a
    · have h₂ : ∃ s : PSpace Ω, s =ᵢ x ⊕ᵢ a := by
        obtain ⟨ya, h₁⟩ := h₁
        let xams := x.1.ms ⊔ a.1.ms
        have hxams : xams ≤ ya.1.ms := by
          rw [h₁.1]
          exact sup_le_sup_right hxy'.1 _
        let xa := @ya.trim Ω xams hxams
        refine ⟨xa, rfl, fun u hu v hv ↦ ?_⟩
        have hu' : MeasurableSet[y.1.ms] u := hxy'.1 u hu
        have huv : MeasurableSet[xams] (u ∩ v) :=
          (mem_sup_l _ _ hu).inter (mem_sup_r _ _ hv)
        calc
              xa.1.μ (u ∩ v)
          _ = ya.1.μ (u ∩ v) := ya.1.trim_eq hxams huv
          _ = y.1.μ u * a.1.μ v := h₁.2 u hu' v hv
          _ = x.1.μ u * a.1.μ v := by
            rw [MeasureOnSpace.le_preserves_measure (p := x.1) (q := y.1) hxy' hu]
      rw [PSp.mul_of_exists h₁, PSp.mul_of_exists h₂]
      exact WithTop.coe_le_coe.2
        (PSpace.functoriality h₂.choose_spec h₁.choose_spec hxy')
    · rw [PSp.mul_of_dependent h₁]
      exact le_top
  valid_mono := by
    intro ps₁ ps₂ h₁ h₂
    cases ps₁ with
    | none =>
      have : ps₂ = (⊤ : PSp Ω) := @PSp.ge_top_imp_top Ω ps₂ h₁
      aesop
    | some p₁ => cases ps₂ with
      | none => contradiction
      | some p₂ => intro h; contradiction
  valid_mul := by apply PSp.mul_defined_imp_defined
}

section Examples

open unitInterval
open scoped ENNReal

noncomputable def PSpace.uniform (n : ℕ) : PSpace (Fin (n + 1)) :=
  ⟨⟨⊤, (PMF.uniformOfFintype (Fin (n + 1))).toMeasure⟩, inferInstance⟩

noncomputable def PSp.uniform (n : ℕ) : PSp (Fin (n + 1)) := .some (PSpace.uniform n)

@[simp] lemma PSpace.uniform_ms (n : ℕ) :
    (PSpace.uniform n).ms = (⊤ : MeasurableSpace (Fin (n + 1))) := rfl

/-- Every point has mass `1 / (n + 1)`. -/
lemma PSpace.uniform_apply_singleton (n : ℕ) (i : Fin (n + 1)) :
    (PSpace.uniform n).μ {i} = (n + 1 : ℝ≥0∞)⁻¹ := by
  show (PMF.uniformOfFintype (Fin (n + 1))).toMeasure {i} = _
  rw [PMF.toMeasure_apply_singleton _ _ (by trivial), PMF.uniformOfFintype_apply]
  simp

/-- More generally, an event has mass proportional to its cardinality. -/
lemma PSpace.uniform_apply (n : ℕ) (s : Set (Fin (n + 1))) [Fintype s] :
    (PSpace.uniform n).μ s = (Fintype.card s : ℝ≥0∞) / (n + 1) := by
  show (PMF.uniformOfFintype (Fin (n + 1))).toMeasure s = _
  rw [PMF.toMeasure_uniformOfFintype_apply _ (by trivial)]
  simp

/-- A discrete space on `Fin (n + 1)` giving every point mass `1 / (n + 1)` *is* the
uniform space.  This is the shape a proof that some program is uniform will take. -/
lemma PSpace.eq_uniform {n : ℕ} {p : PSpace (Fin (n + 1))}
    (hms : p.ms = (⊤ : MeasurableSpace (Fin (n + 1))))
    (h : ∀ i, p.μ {i} = (n + 1 : ℝ≥0∞)⁻¹) : p = PSpace.uniform n := by
  obtain ⟨⟨m, μ⟩, hp⟩ := p
  simp only [PSpace.ms] at hms
  subst hms
  have hμ : μ = (PSpace.uniform n).μ :=
    (MeasureTheory.Measure.ext_iff_singleton ..).mpr (fun i => by
      show μ {i} = (PSpace.uniform n).μ {i}
      rw [PSpace.uniform_apply_singleton]
      exact h i)
  refine PSpace.ext_ms rfl (fun E _ => ?_)
  show μ E = (PSpace.uniform n).μ E
  rw [hμ]
  rfl

open ProbabilityTheory in
/-- The Bernoulli space on `Bool`: mass `p` on `true`, `1 - p` on `false`. -/
noncomputable def PSpace.bernoulli (p : I) : PSpace Bool :=
  ⟨⟨⊤, Ber(true, false, p)⟩, inferInstance⟩

noncomputable def PSp.bernoulli (p : I) : PSp Bool := .some (PSpace.bernoulli p)

@[simp] lemma PSpace.bernoulli_ms (p : I) :
    (PSpace.bernoulli p).ms = (⊤ : MeasurableSpace Bool) := rfl

open ProbabilityTheory in
/-- `true` has mass `p`. -/
lemma PSpace.bernoulli_μ_true {p : I} :
    (PSpace.bernoulli p).μ {true} = (unitInterval.toNNReal p : ℝ≥0∞) :=
  bernoulliMeasure_apply_of_mem_of_notMem p (by trivial) rfl (by simp)

open ProbabilityTheory in
/-- `false` has mass `1 - p`.  The subtraction is truncated on both sides, and the two
agree because `p ≤ 1`. -/
lemma PSpace.bernoulli_μ_false {p : I} :
    (PSpace.bernoulli p).μ {false} = 1 - (unitInterval.toNNReal p : ℝ≥0∞) := by
  have h : (PSpace.bernoulli p).μ {false} = (unitInterval.toNNReal (σ p) : ℝ≥0∞) :=
    bernoulliMeasure_apply_of_notMem_of_mem p (by trivial) (by simp) rfl
  have hle : unitInterval.toNNReal p ≤ 1 :=
    NNReal.coe_le_coe.mp (by simpa using (Set.mem_Icc.mp p.2).2)
  rw [h, ← ENNReal.coe_one, ← ENNReal.coe_sub]
  congr 1
  exact NNReal.coe_injective (by simpa using (NNReal.coe_sub hle).symm)

open ProbabilityTheory in
/-- More generally, an event collects `p` if it contains `true` and `1 - p` if it contains
`false`.

Unlike `PSpace.uniform_apply`, this is *not* proportional to the cardinality of the event:
the two points carry different mass unless `p = 1/2`. -/
lemma PSpace.bernoulli_apply (p : I) (s : Set Bool) [DecidablePred (· ∈ s)] :
    (PSpace.bernoulli p).μ s
      = if true ∈ s then (if false ∈ s then 1 else (unitInterval.toNNReal p : ℝ≥0∞))
        else (if false ∈ s then (unitInterval.toNNReal (σ p) : ℝ≥0∞) else 0) :=
  bernoulliMeasure_apply p (by trivial)

end Examples

end PSp

section WeightedSum

open scoped ENNReal

/-! ## Weighted sums of probability spaces

This is `wsum` from the Amaryllis paper (arXiv 2605.13765, §3.3).  Given a distribution
`μ : PMF A` over branches and a family `ν : A → PSpace Ω` of probability spaces, one for
each branch, the weighted sum is the space

```
  ( ⋂_{v ∈ supp μ} π_ℱ(ν v),  λE. ∑_{v ∈ supp μ} μ(v) · π_μ(ν v)(E) )
```

i.e. the events every branch in the support can measure, equipped with the mixture of the
branch measures.

The paper additionally guards the construction by `has_rv(μ, ν)` — pairwise disjointness
of the branch supports — and returns `↯` when it fails.  That side condition is what makes
the *resource* component of the model well behaved; it is not needed for the probability
space itself, which is total: the mixture is always a probability measure on the
intersected σ-algebra.  Since this development does not do resource reasoning, we implement
only the `has_rv` branch, and `PSpace.wsum` is correspondingly total. -/

variable {A : Type*}

@[instance_reducible]
def PSpace.wsumSpace (μ : PMF A) (ν : A → PSpace Ω) : MeasurableSpace Ω :=
  ⨅ v ∈ μ.support, (ν v).ms

lemma PSpace.wsumSpace_le {μ : PMF A} {ν : A → PSpace Ω} {v : A} (hv : v ∈ μ.support) :
    PSpace.wsumSpace μ ν ≤ (ν v).ms :=
  iInf₂_le v hv

/-- The mixture measure `λE. ∑ᵥ μ(v) · π_μ(ν v)(E)`, on the common σ-algebra.

Off-support branches are harmless: `μ v = 0` annihilates their contribution, so the junk
value of `Measure.cast` there is never observed. -/
noncomputable def PSpace.wsumMeasure (μ : PMF A) (ν : A → PSpace Ω) :
    Measure[PSpace.wsumSpace μ ν] Ω :=
  letI : MeasurableSpace Ω := PSpace.wsumSpace μ ν
  Measure.sum (fun v => μ v • ((ν v).μ.cast (PSpace.wsumSpace μ ν)))

/-- The defining property of the weighted sum. -/
lemma PSpace.wsumMeasure_apply (μ : PMF A) (ν : A → PSpace Ω) {E : Set Ω}
    (hE : MeasurableSet[PSpace.wsumSpace μ ν] E) :
    PSpace.wsumMeasure μ ν E = ∑' v, μ v * (ν v).μ E := by
  rw [PSpace.wsumMeasure, Measure.sum_apply _ hE]
  refine tsum_congr (fun v => ?_)
  rw [Measure.smul_apply, smul_eq_mul]
  by_cases hv : v ∈ μ.support
  · rw [@Measure.le_preserves_measure Ω (PSpace.wsumSpace μ ν) (ν v).ms
      (PSpace.wsumSpace_le hv) (ν v).μ E hE]
  · simp only [PMF.mem_support_iff, not_not] at hv
    simp [hv]

lemma PSpace.wsumMeasure_isProbabilityMeasure (μ : PMF A) (ν : A → PSpace Ω) :
    IsProbabilityMeasure (PSpace.wsumMeasure μ ν) := by
  constructor
  rw [PSpace.wsumMeasure_apply μ ν (@MeasurableSet.univ Ω (PSpace.wsumSpace μ ν))]
  have h : ∀ v, μ v * (ν v).μ Set.univ = μ v := fun v => by
    rw [@measure_univ Ω (ν v).ms (ν v).μ (ν v).isProbability, mul_one]
  simp only [h]
  exact μ.tsum_coe

noncomputable def PSpace.wsum (μ : PMF A) (κ : A → PSpace Ω) : PSpace Ω :=
  ⟨⟨PSpace.wsumSpace μ κ, PSpace.wsumMeasure μ κ⟩,
    PSpace.wsumMeasure_isProbabilityMeasure μ κ⟩

@[simp]
lemma PSpace.wsum_ms (μ : PMF A) (κ : A → PSpace Ω) :
    (PSpace.wsum μ κ).ms = PSpace.wsumSpace μ κ := rfl

@[simp]
lemma PSpace.wsum_mu (μ : PMF A) (κ : A → PSpace Ω) :
    (PSpace.wsum μ κ).μ = PSpace.wsumMeasure μ κ := rfl

/-- The two-point weight distribution behind `wsum₂`: mass `r` on `true` and `1 - r` on
`false`.  Mathlib's `PMF.bernoulli` is deprecated in favour of the *measure*-valued
`ProbabilityTheory.bernoulliMeasure`, but `wsum` mixes over a `PMF`, so we keep a `PMF`
here. -/
noncomputable def bernoulliWeights (r : NNReal) (hr : r ≤ 1) : PMF Bool :=
  PMF.ofFintype (fun b => cond b r (1 - r)) (by simp [hr])

@[simp]
lemma bernoulliWeights_apply (r : NNReal) (hr : r ≤ 1) (b : Bool) :
    bernoulliWeights r hr b = cond b (r : ℝ≥0∞) ((1 - r : NNReal) : ℝ≥0∞) := by
  rw [bernoulliWeights, PMF.ofFintype_apply]
  cases b <;> rfl

lemma mem_support_bernoulliWeights_false {r : NNReal} {hr : r ≤ 1} (h : r ≠ 1) :
    false ∈ (bernoulliWeights r hr).support := by
  rw [PMF.mem_support_iff, bernoulliWeights_apply]
  simp only [Bool.cond_false, ne_eq, ENNReal.coe_eq_zero]
  intro hc
  rw [tsub_eq_zero_iff_le] at hc
  exact h (le_antisymm hr hc)

lemma mem_support_bernoulliWeights_true {r : NNReal} {hr : r ≤ 1} (h : r ≠ 0) :
    true ∈ (bernoulliWeights r hr).support := by
  rw [PMF.mem_support_iff, bernoulliWeights_apply]
  simpa using h

noncomputable def PSpace.wsum₂ (r : NNReal) (hr : r ≤ 1) (p₀ p₁ : PSpace Ω) : PSpace Ω :=
  PSpace.wsum (bernoulliWeights r hr) (fun b => if b then p₁ else p₀)

lemma PSpace.wsum₂_apply (r : NNReal) (hr : r ≤ 1) (p₀ p₁ : PSpace Ω) {E : Set Ω}
    (hE : MeasurableSet[(PSpace.wsum₂ r hr p₀ p₁).ms] E) :
    (PSpace.wsum₂ r hr p₀ p₁).μ E
      = (1 - (r : ℝ≥0∞)) * p₀.μ E + (r : ℝ≥0∞) * p₁.μ E :=
  calc (PSpace.wsum₂ r hr p₀ p₁).μ E
      = ∑' b, (bernoulliWeights r hr) b * (if b then p₁ else p₀ : PSpace Ω).μ E :=
        PSpace.wsumMeasure_apply _ _ hE
    _ = (1 - (r : ℝ≥0∞)) * p₀.μ E + (r : ℝ≥0∞) * p₁.μ E := by
        rw [tsum_bool]
        simp [ENNReal.coe_sub]

noncomputable def PSp.wsum₂ (r : NNReal) (hr : r ≤ 1) : PSp Ω → PSp Ω → PSp Ω
  | .some p₀, .some p₁ => .some (PSpace.wsum₂ r hr p₀ p₁)
  | _, _ => ⊤

@[simp]
noncomputable def MeasureOnSpace.map (h : Ω → Ω') (ms : MeasureOnSpace Ω) :
    MeasureOnSpace Ω' :=
  letI F := ms.ms.map h
  ⟨F, @Measure.map _ _ ms.ms _ h ms.μ⟩

@[simp]
noncomputable def PSpace.map (f : Ω → Ω') (ps : PSpace Ω) : PSpace Ω' := ⟨ps.1.map f, by
  refine isProbabilityMeasure_iff.mpr ?_
  have := @Measure.map_apply Ω Ω' ps.1.ms (ps.1.ms.map f) ps.1.μ f (fun ⦃_⦄ a => a)
    Set.univ (by simp)
  have : ps.1.μ (f ⁻¹' Set.univ) = 1 := by
    have : f ⁻¹' Set.univ = Set.univ := by simp
    have := ps.2.measure_univ
    aesop
  aesop⟩

/-- The defining property of the pushforward. -/
lemma PSpace.map_apply (f : Ω → Ω') (p : PSpace Ω) {S : Set Ω'}
    (hS : MeasurableSet[(PSpace.map f p).ms] S) :
    (PSpace.map f p).μ S = p.μ (f ⁻¹' S) :=
  @Measure.map_apply Ω Ω' p.1.ms (p.1.ms.map f) p.1.μ f (fun ⦃_⦄ a => a) S hS

noncomputable def PSp.map (f : Ω → Ω') : PSp Ω → PSp Ω'
  | .some p => .some (PSpace.map f p)
  | _ => ⊤

/-- The defining property of a weighted sum of *reindexed* spaces.

This is the shape that arises when interpreting a probabilistic computation: each branch
supplies its own randomness, relocated by `f₀`/`f₁` onto the random-choice identifiers that
branch owns, and the result mixes the two with weights `1 - r` and `r`. -/
lemma PSpace.wsum₂_map_apply (r : NNReal) (hr : r ≤ 1) (f₀ f₁ : Ω → Ω') (p₀ p₁ : PSpace Ω)
    {S : Set Ω'}
    (hS : MeasurableSet[(PSpace.wsum₂ r hr (PSpace.map f₀ p₀) (PSpace.map f₁ p₁)).ms] S) :
    (PSpace.wsum₂ r hr (PSpace.map f₀ p₀) (PSpace.map f₁ p₁)).μ S
      = (1 - (r : ℝ≥0∞)) * p₀.μ (f₀ ⁻¹' S) + (r : ℝ≥0∞) * p₁.μ (f₁ ⁻¹' S) := by
  rw [PSpace.wsum₂_apply r hr _ _ hS]
  congr 1
  · rcases eq_or_ne r 1 with rfl | h0
    · simp
    · rw [PSpace.map_apply f₀ p₀
        (PSpace.wsumSpace_le (mem_support_bernoulliWeights_false (hr := hr) h0) S hS)]
  · rcases eq_or_ne r 0 with rfl | h1
    · simp
    · rw [PSpace.map_apply f₁ p₁
        (PSpace.wsumSpace_le (mem_support_bernoulliWeights_true (hr := hr) h1) S hS)]

/-! ### Measurability helpers for pushforwards and weighted sums -/

@[simp]
lemma PSpace.measurableSet_map {f : Ω → Ω'} {p : PSpace Ω} {S : Set Ω'} :
    MeasurableSet[(PSpace.map f p).ms] S ↔ MeasurableSet[p.ms] (f ⁻¹' S) := Iff.rfl

/-- If every subset of the target has a `p`-measurable preimage, the pushforward's
σ-algebra is the discrete one. -/
lemma PSpace.map_ms_eq_top {p : PSpace Ω} {f : Ω → Ω'}
    (h : ∀ S : Set Ω', MeasurableSet[p.ms] (f ⁻¹' S)) :
    (PSpace.map f p).ms = (⊤ : MeasurableSpace Ω') :=
  PSpace.ms_eq_top_of_all (fun S => h S)

/-- An event measurable in both branches is measurable in their weighted sum. -/
lemma PSpace.measurableSet_wsum₂ {r : NNReal} {hr : r ≤ 1} {p₀ p₁ : PSpace Ω} {E : Set Ω}
    (h₀ : MeasurableSet[p₀.ms] E) (h₁ : MeasurableSet[p₁.ms] E) :
    MeasurableSet[(PSpace.wsum₂ r hr p₀ p₁).ms] E :=
  MeasurableSpace.measurableSet_iInf.mpr (fun v =>
    MeasurableSpace.measurableSet_iInf.mpr (fun _ => by cases v <;> simpa))

end WeightedSum

end

