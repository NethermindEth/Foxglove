open unitInterval

inductive BernoulliOps
| Flip : I → BernoulliOps

@[expose]
def BernoulliPFunctor : PFunctor where
  A := BernoulliOps
  B _ := Bool

class BernoulliInterpretable {α : Type} (oSpec : OracleSpec α) where
  interp_op (op : oSpec.toPFunctor.A) : BernoulliPFunctor.FreeM (oSpec.toPFunctor.B op)

def flip (r : I) : PFunctor.FreeM BernoulliPFunctor Bool :=
  PFunctor.FreeM.liftBind (BernoulliOps.Flip r) PFunctor.FreeM.pure

def split {n : ℕ} (m : Fin n) : PFunctor.FreeM BernoulliPFunctor (Fin n) := do
  if h₁ : n = m.1 + 1
    then pure m
    else
      let b ← flip
        ⟨
          (mkRat 1 (n - m.1) : ℝ),
          by
            simp only [Set.mem_Icc, Rat.cast_nonneg, zero_le_one, Rat.mkRat_nonneg, true_and]
            norm_cast
            refine Rat.num_le_denom_iff.mp ?_
            unfold mkRat
            split_ifs with h
            · simp
            · simp only [Rat.num_normalize, isUnit_one, Int.natAbs_of_isUnit, Fin.is_le',
              isUnit_iff_eq_one, IsUnit.dvd, Nat.gcd_sub_left_right_of_dvd, Nat.gcd_one_left,
              Nat.cast_one, ne_eq, one_ne_zero, not_false_eq_true, EuclideanDomain.div_self,
              Rat.den_normalize, Nat.div_one, Nat.cast_sub]
              omega⟩
      if b
        then pure m
        else split (⟨m.1 + 1, (by omega)⟩ : Fin n)
termination_by n - m.1
decreasing_by have := m.isLt; omega

instance : BernoulliInterpretable unifSpec where
  interp_op op := split (0 : (Fin (op + 1)))

open BernoulliInterpretable in
instance {α β} {oSpec₁ : OracleSpec α} {oSpec₂ : OracleSpec β} [BernoulliInterpretable oSpec₁]
    [BernoulliInterpretable oSpec₂]
  : BernoulliInterpretable (oSpec₁ + oSpec₂) where
  interp_op op := match op with
                    | .inl a => interp_op a
                    | .inr a => interp_op a

open BernoulliInterpretable in
def interp {α β} {oSpec : OracleSpec β} [BernoulliInterpretable oSpec] (p : OracleComp oSpec α)
      : PFunctor.FreeM (BernoulliPFunctor) α :=
  match p with
   | PFunctor.FreeM.pure a => pure a
   | PFunctor.FreeM.liftBind op f => bind (interp_op op) (fun x => interp (f x))

section BernoulliSpace

open MeasureTheory
open scoped ENNReal

/-! ### The probability space of a single coin flip

`fixOut n p` is the probability space that resolves exactly the `n`-th random bit of a sample
point `ω : Ω = ℕ → Bool`, giving that bit the Bernoulli(`p`) law.  Its σ-algebra is the
four-element algebra `{E₀, E₁, ∅, univ}` with `Eᵦ = {ω | ω n = b}`, and its measure sends
`E₀ ↦ p` and `E₁ ↦ 1 - p`.
-/

/-- `coinEvent n b` is the event "the `n`-th random bit of the sample point is `b`". -/
def coinEvent (n : ℕ) (b : Bool) : Set Ω := {ω : Ω | ω n = b}

@[simp]
lemma mem_coinEvent {n : ℕ} {b : Bool} {ω : Ω} : ω ∈ coinEvent n b ↔ ω n = b := Iff.rfl

/-- `{E₀, E₁, ∅, univ}` is exactly the family of preimages under the `n`-th coordinate map.
This is what makes it closed under complements and countable unions. -/
lemma mem_coinSets_iff (n : ℕ) (s : Set Ω) :
    s ∈ ({coinEvent n false, coinEvent n true, ∅, Set.univ} : Set (Set Ω))
      ↔ ∃ t : Set Bool, (fun ω : Ω => ω n) ⁻¹' t = s := by
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨{false}, rfl⟩
    · exact ⟨{true}, rfl⟩
    · exact ⟨∅, rfl⟩
    · exact ⟨Set.univ, rfl⟩
  · rintro ⟨t, rfl⟩
    by_cases h₀ : false ∈ t <;> by_cases h₁ : true ∈ t
    · exact Or.inr (Or.inr (Or.inr (by ext ω; cases h : ω n <;> simp [h, h₀, h₁])))
    · exact Or.inl (by ext ω; cases h : ω n <;> simp [coinEvent, h, h₀, h₁])
    · exact Or.inr (Or.inl (by ext ω; cases h : ω n <;> simp [coinEvent, h, h₀, h₁]))
    · exact Or.inr (Or.inr (Or.inl (by ext ω; cases h : ω n <;> simp [h, h₀, h₁])))

/-- The σ-algebra `{E₀, E₁, ∅, univ}` on `Ω` generated by the `n`-th random bit. -/
def coinSpace (n : ℕ) : MeasurableSpace Ω where
  MeasurableSet' s := s ∈ ({coinEvent n false, coinEvent n true, ∅, Set.univ} : Set (Set Ω))
  measurableSet_empty := by simp
  measurableSet_compl s hs := by
    obtain ⟨t, rfl⟩ := (mem_coinSets_iff n s).1 hs
    exact (mem_coinSets_iff n _).2 ⟨tᶜ, Set.preimage_compl⟩
  measurableSet_iUnion f hf := by
    choose t ht using fun i => (mem_coinSets_iff n (f i)).1 (hf i)
    exact (mem_coinSets_iff n _).2 ⟨⋃ i, t i, by simp only [Set.preimage_iUnion, ht]⟩

@[simp]
lemma measurableSet_coinEvent (n : ℕ) (b : Bool) : MeasurableSet[coinSpace n] (coinEvent n b) := by
  cases b
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)

/-- The Bernoulli(`p`) law of the `n`-th bit, built as a mixture of the two point masses at the
constant sample points.

Building it this way, rather than writing an outer measure down by hand, is what makes it an
actual measure: `fun s ↦ if s = E₀ then p else if s = E₁ then 1 - p else …` is *not* monotone,
since e.g. `E₀ ⊆ E₀ ∪ {fun _ ↦ true}` while the right-hand side lies outside the σ-algebra and
would therefore be sent to `0 < p`.

`HSMul.hSMul` is spelled out because `Iris.CMRA.op` also claims the `•` notation, at a
precedence that makes `p • μ + q • ν` parse as `p • (μ + q • ν)`. -/
noncomputable def coinMeasure (n : ℕ) (p : ℝ≥0∞) : Measure[coinSpace n] Ω :=
  HSMul.hSMul p (@Measure.dirac Ω (coinSpace n) (fun _ => false))
    + HSMul.hSMul (1 - p) (@Measure.dirac Ω (coinSpace n) (fun _ => true))

lemma dirac_coinEvent (n : ℕ) (b c : Bool) :
    letI : MeasurableSpace Ω := coinSpace n
    (@Measure.dirac Ω (coinSpace n) (fun _ => c)) (coinEvent n b) = if c = b then 1 else 0 := by
  rw [@Measure.dirac_apply' Ω (coinSpace n) (coinEvent n b) (fun _ => c)
        (measurableSet_coinEvent n b)]
  by_cases h : c = b <;> simp [coinEvent, h]

@[simp]
lemma coinMeasure_apply (n : ℕ) (p : ℝ≥0∞) (b : Bool) :
    letI : MeasurableSpace Ω := coinSpace n
    coinMeasure n p (coinEvent n b) = if b = false then p else 1 - p := by
  simp only [coinMeasure, Measure.add_apply, Measure.smul_apply, smul_eq_mul, dirac_coinEvent]
  cases b <;> simp

lemma coinMeasure_univ (n : ℕ) {p : ℝ≥0∞} (hp : p ≤ 1) :
    letI : MeasurableSpace Ω := coinSpace n
    coinMeasure n p Set.univ = 1 := by
  simp [coinMeasure, add_tsub_cancel_of_le hp]

lemma coinMeasure_isProbabilityMeasure (n : ℕ) {p : ℝ≥0∞} (hp : p ≤ 1) :
    IsProbabilityMeasure (coinMeasure n p) :=
  ⟨coinMeasure_univ n hp⟩

/-- The defining property of the measure underlying `fixOut n p`: `μ E₀ = p`, `μ E₁ = 1 - p`. -/
lemma coinMeasure_ofReal_apply (n : ℕ) (p : I) (b : Bool) :
    letI : MeasurableSpace Ω := coinSpace n
    coinMeasure n (ENNReal.ofReal p) (coinEvent n b)
      = ENNReal.ofReal (if b = false then (p : ℝ) else 1 - (p : ℝ)) := by
  rw [coinMeasure_apply]
  cases b
  · simp
  · simp [ENNReal.ofReal_sub _ (unitInterval.nonneg p)]

/-- The probability space that resolves exactly the `n`-th random bit of a sample point and
gives it the Bernoulli(`p`) law.  See `coinMeasure_ofReal_apply` for its defining property. -/
noncomputable def fixOut (n : ℕ) (p : I) : PSp Ω :=
  .some ⟨⟨coinSpace n, coinMeasure n (ENNReal.ofReal p)⟩,
    coinMeasure_isProbabilityMeasure n (ENNReal.ofReal_le_one.2 (unitInterval.le_one p))⟩

lemma fixOut_eq (n : ℕ) (p : I) :
    fixOut n p = .some ⟨⟨coinSpace n, coinMeasure n (ENNReal.ofReal p)⟩,
      coinMeasure_isProbabilityMeasure n (ENNReal.ofReal_le_one.2 (unitInterval.le_one p))⟩ := rfl

end BernoulliSpace

noncomputable def interp_psp' {α : Type} (m : PFunctor.FreeM BernoulliPFunctor α) (n : ℕ) (p : PSp Ω) : PSp Ω × RV α :=
  match m with
  | PFunctor.FreeM.pure a => (p, fun _ ↦ a)
  | PFunctor.FreeM.liftBind (BernoulliOps.Flip r) f =>
    let p' : PSp Ω := PSp.mul p (fixOut n r) -- defined in terms of p and n
    let p'' : PSp Ω := sorry -- Bind.bind p' sorry  -- weighted sum, i.e. the Giri Monad bind (?)
    (
      p'',
      fun ω ↦ (interp_psp' (f (ω n)) (n + 1) p').2 ω
    )

-- ({∅, Ω}, μ) ->(Flip p) ({∅, Ω, E₀, E₁}, μ')
-- E₀ = {ω : Ω | ω 0 = False}
-- E₁ = {ω : Ω | ω 0 = True}
-- μ' E₀ = p, μ' E₁ = 1 - p

-- n : ℕ
-- [p₀, p₁, ..., pₙ]
-- Eᵢ = {ω : Ω | ∑ i : Fin n, (ω i.1) * 2 ^ i.1 = i}
-- ∀ ω ω' : Ω, (∀ i : Fin n, ω i.1 = ω' i.1) → ∀ i : Fin (2 ^ n), ω ∈ Eᵢ ↔ ω' ∈ Eᵢ
--

noncomputable def interp_psp {α : Type} (m : PFunctor.FreeM (BernoulliPFunctor) α) : PSp Ω × RV α :=
  interp_psp' m 0 (.some 1)


end BernoulliInterpretable

